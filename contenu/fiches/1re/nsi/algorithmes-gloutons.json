            { "titre": "Oui", "texte": "le temps de calcul compte." },
            { "titre": "Oui", "texte": "l’optimalité est **démontrable**." },
            { "titre": "Non", "texte": "l’optimum est exigé : méthode exacte." }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 296px",
      "blocs": [
        {
          "type": "copie",
