{
  "titre": "La phrase exclamative",
  "titreSurligne": "exclamative",
  "accroche": "What ou how&nbsp;: le nom ou l’adjectif.",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/5e/anglais/la-phrase-exclamative.webp",
    "prompt": "a glossy violet exclamation mark with golden sparkles and tiny golden stars around it, same art style as the reference icons, magenta background"
  },
  "marcel": "Quel beau jour&nbsp;!\nWhat a day&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "Le choix",
          "lignes": [
            "**what** + nom"
          ],
          "petite": true,
          "regle": "**what** devant un **nom**&nbsp;; **how** devant un **adjectif** ou un **adverbe**.",
          "note": "what a… / how…"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Les constructions",
          "entetes": [
            "Mot",
            "Suivi de",
            "Exemple"
          ],
          "lignes": [
            [
              "What a / an",
              "nom singulier",
              "<i>**What a** beautiful day!</i>"
            ],
            [
              "What",
              "nom pluriel ou indénombrable",
              "<i>**What** terrible weather!</i>"
            ],
            [
              "How",
              "adjectif ou adverbe",
              "<i>**How** strange!</i> / <i>**How** fast he runs!</i>"
            ],
            [
              "How + S + V",
              "adjectif",
              "<i>**How** beautiful this place is!</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "So et such",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "So",
              "texte": "+ adjectif ou adverbe&nbsp;: <i>She is **so** kind!</i>"
            },
            {
              "titre": "Such a",
              "texte": "+ adjectif + nom **singulier**&nbsp;: <i>It was **such a** good film!</i>"
            },
            {
              "titre": "Such",
              "texte": "+ adjectif + nom pluriel ou indénombrable&nbsp;: <i>They are **such** nice people!</i>"
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Pas d’inversion",
          "oui": {
            "titre": "Sujet devant le verbe",
            "texte": "<i>How beautiful this place **is**!</i>"
          },
          "non": {
            "titre": "Inversion à la française",
            "texte": "<i>How beautiful **is** this place!</i> / <i>How is it beautiful!</i>"
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>___ lovely weather!</i> → **What**&nbsp;: <i>weather</i> est un nom, sans article."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Nom ou adjectif&nbsp;?",
              "texte": "Nom → **what**&nbsp;; adjectif ou adverbe → **how**."
            },
            {
              "titre": "Un article&nbsp;?",
              "texte": "Nom singulier dénombrable → **a / an**&nbsp;; sinon rien."
            },
            {
              "titre": "L’ordre",
              "texte": "Le sujet reste **avant** le verbe."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "Toutes faites",
          "deux": true,
          "items": [
            {
              "titre": "What a pity!",
              "texte": "Quel dommage&nbsp;! (aussi <i>What a shame!</i>)"
            },
            {
              "titre": "Well done!",
              "texte": "Bravo&nbsp;!"
            },
            {
              "titre": "No way!",
              "texte": "Pas question&nbsp;!"
            },
            {
              "titre": "That’s amazing!",
              "texte": "C’est incroyable&nbsp;!"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>What beautiful day!</i> → <i>What **a** beautiful day!</i>",
            "<i>How a beautiful day!</i> → <i>**What** a beautiful day!</i>",
            "<i>What a weather!</i> → <i>What weather!</i> (indénombrable)",
            "« Comme c’est beau&nbsp;! » → <i>How beautiful it is!</i>, jamais <i>how is it beautiful</i>."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>___ a lovely house!</i>",
            "<i>___ fast he runs!</i>",
            "<i>They are ___ nice people!</i> (so / such)"
          ],
          "reponses": "1) What 2) How 3) such"
        }
      ]
    }
  ]
}
