            {
              "titre": "PGCD",
              "texte": "Facteurs communs, **plus petit exposant**&nbsp;: PGCD(360&nbsp;; 84) = 2² × 3 = 12."
            },
            {
              "titre": "Impair²",
              "texte": "Si n = 2k + 1, n² = 2(2k² + 2k) + 1&nbsp;: **impair**."
            },
            {
              "titre": "Infinité",
              "texte": "Il y a une **infinité** de premiers (Euclide)."
