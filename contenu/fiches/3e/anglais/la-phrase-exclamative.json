  },
  "marcel": "What a day&nbsp;!\nHow nice&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "Le choix du mot",
          "lignes": [
            "**what** + nom\n**how** + adjectif / adverbe"
          ],
          "petite": true,
          "regle": "Pas d’inversion en anglais&nbsp;: le sujet reste **devant** le verbe.",
          "note": "what a / an si singulier"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Les constructions",
          "entetes": [
            "Le cas",
            "L’exemple",
            "En français"
          ],
          "lignes": [
            [
              "what a + nom sing.",
              "<i>**What a** surprise!</i>",
              "Quelle surprise&nbsp;!"
            ],
            [
              "what + pluriel",
              "<i>**What** lovely flowers!</i>",
              "Quelles jolies fleurs&nbsp;!"
            ],
            [
              "what + indénombrable",
              "<i>**What** bad luck!</i>",
              "Quelle malchance&nbsp;!"
            ],
            [
              "how + adjectif / adverbe",
              "<i>**How** well she plays!</i>",
              "Comme elle joue bien&nbsp;!"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "So, such et la conséquence",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "so + adjectif",
              "texte": "<i>She is **so** kind!</i> — avec un adjectif ou un adverbe."
            },
            {
              "titre": "such (a) + nom",
              "texte": "<i>It was **such a** good film!</i> / <i>They are **such** nice people!</i>"
            },
            {
              "titre": "…that + conséquence",
              "texte": "<i>It was **so** cold **that** we stayed in.</i> — si froid que…"
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "What ou how&nbsp;?",
          "oui": {
            "titre": "Le bon mot",
            "texte": "<i>**What a** beautiful house!</i> (nom) / <i>**How** beautiful!</i> (adjectif)"
          },
          "non": {
            "titre": "Le mot faux",
            "texte": "<i>How a beautiful house!</i> / <i>How is it beautiful!</i> — devant un nom : what ; et pas d’inversion."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>___ terrible weather!</i> → **What**, sans <i>a</i> : weather est indénombrable&nbsp;!"
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Repère le mot",
              "texte": "L’exclamation porte sur un **nom** ou sur un **adjectif / adverbe**&nbsp;?"
            },
            {
              "titre": "Choisis",
              "texte": "Nom → **what** (+ **a / an** si singulier). Adjectif → **how**."
            },
            {
              "titre": "Sujet + verbe",
              "texte": "Si tu en ajoutes un&nbsp;: <i>How beautiful this place **is**!</i> (jamais « how beautiful is this place »)"
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "Exclamations toutes faites",
          "deux": true,
          "items": [
            {
              "titre": "What a pity / shame!",
              "texte": "Quel dommage&nbsp;!"
            },
            {
              "titre": "How come?",
              "texte": "Comment ça se fait&nbsp;?"
            },
            {
              "titre": "No way!",
              "texte": "Pas question&nbsp;!"
            },
            {
              "titre": "Well done!",
              "texte": "Bravo&nbsp;!"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>What beautiful day!</i> → <i>What **a** beautiful day!</i>",
            "<i>What a terrible weather!</i> → <i>What terrible weather!</i>",
            "<i>How a beautiful house!</i> → <i>**What** a beautiful house!</i>",
            "<i>It was so a good film!</i> → <i>It was **such a** good film!</i>"
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>___ a lovely day!</i> (what / how)",
            "<i>___ fast he runs!</i> (what / how)",
            "<i>It was ___ a long film!</i> (so / such)"
          ],
          "reponses": "1) What 2) How 3) such"
        }
      ]
    }
  ]
