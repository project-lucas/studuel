{
  "titre": "Pourcentages",
  "titreSurligne": "Pourcentages",
  "accroche": "Un pourcentage, un coefficient.",
  "bonus": "+ t % ⇒ **1 + t/100** · − t % ⇒ **1 − t/100** · les coefficients se multiplient",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/1re/maths-techno/automatismes-proportions-pourcentages-et-evolutions.webp",
