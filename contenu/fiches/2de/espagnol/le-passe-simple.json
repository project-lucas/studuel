{
  "titre": "Le passé simple",
  "titreSurligne": "passé simple",
  "accroche": "Le temps du récit, tous les jours.",
  "bonus": "**-é, -aste, -ó, -amos, -asteis, -aron** · **-í, -iste, -ió, -imos, -isteis, -ieron**",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/2de/espagnol/le-passe-simple.webp",
    "prompt": "a glossy violet open storybook with a golden bookmark ribbon and a small golden arrow moving forward, tiny golden sparkles, same art style as the reference icons, magenta background"
  },
  "marcel": "Les accents font\nle temps&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "La forme",
          "lignes": ["radical + **-é / -í**…"],
          "petite": true,
          "regle": "Rien de littéraire&nbsp;: il s’emploie à l’oral. C’est le temps des faits **achevés**, coupés du présent, qui font **avancer** le récit.",
          "note": "<i>ayer, anoche, de repente</i>"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "La conjugaison régulière",
          "entetes": ["Personne", "-ar (hablar)", "-er / -ir (comer)"],
          "lignes": [
            ["yo", "<i>habl**é**</i>", "<i>com**í**</i>"],
            ["tú", "<i>habl**aste**</i>", "<i>com**iste**</i>"],
            ["él / ella", "<i>habl**ó**</i>", "<i>com**ió**</i>"],
            ["nosotros", "<i>habl**amos**</i>", "<i>com**imos**</i>"],
            ["vosotros", "<i>habl**asteis**</i>", "<i>com**isteis**</i>"],
            ["ellos", "<i>habl**aron**</i>", "<i>com**ieron**</i>"]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Les formes à part",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "Prétérits forts",
              "texte": "Radical changé, terminaisons <i>-e, -iste, -o, -imos, -isteis, -ieron</i>, **sans accent**&nbsp;: <i>tener → **tuv-**</i>, <i>estar → estuv-</i>, <i>poder → pud-</i>, <i>poner → pus-</i>, <i>saber → sup-</i>, <i>querer → quis-</i>, <i>venir → vin-</i>, <i>hacer → hic-</i> (<i>hizo</i>)."
            },
            {
              "titre": "Radical en -j",
              "texte": "<i>decir → dij-</i>, <i>traer → traj-</i>, <i>conducir → conduj-</i> : la 3<sup>e</sup> pluriel perd son <i>i</i>&nbsp;: <i>dijeron</i>, jamais <i>dijieron</i>."
            },
            {
              "titre": "Ser / ir et -ir en i",
              "texte": "<i>ser</i> et <i>ir</i> : **fui, fuiste, fue, fuimos, fuisteis, fueron**. <i>pedir → pidió, pidieron</i> ; <i>dormir → durmió</i> ; <i>sentir → sintió</i>."
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "L’accent change le temps",
          "oui": {
            "titre": "Avec accent : passé simple",
            "texte": "<i>**habló**</i> (il a parlé) · <i>**hablé**</i> (j’ai parlé)."
          },
          "non": {
            "titre": "Sans accent : autre temps",
            "texte": "<i>hablo</i> (présent) · <i>hable</i> (subjonctif). Ce n’est pas une faute d’orthographe : c’est un **autre temps**."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>Ayer ella ___ (cantar) en el coro.</i> → **cantó**&nbsp;: accent obligatoire."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "Raconter au passé",
          "etapes": [
            {
              "titre": "Fait ou décor&nbsp;?",
              "texte": "Un événement qui fait avancer → passé simple ; le décor → imparfait."
            },
            {
              "titre": "Régulier ou fort&nbsp;?",
              "texte": "Cherche le radical dans la liste : <i>tuv-, pud-, dij-…</i>"
            },
            {
              "titre": "Vérifie les accents",
              "texte": "Présents sur <i>-é, -ó, -í, -ió</i> ; absents sur les prétérits forts."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "Les marqueurs",
          "deux": true,
          "items": [
            {
              "titre": "Temps passé précis",
              "texte": "<i>ayer, anoche, la semana pasada, el año pasado</i>"
            },
            {
              "titre": "Dates et durées",
              "texte": "<i>en 1975, hace dos años</i>"
            },
            {
              "titre": "Le fil du récit",
              "texte": "<i>entonces, de repente, aquel día</i>"
            },
            {
              "titre": "Récit complet",
              "texte": "<i>Era de noche y llovía. De repente, **sonó** el timbre y **abrí** la puerta.</i>"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>Yo **tení**</i> → <i>Yo **tuve**</i> (fort : pas d’accent, radical <i>tuv-</i>).",
            "<i>Ellos **dijieron**</i> → <i>Ellos **dijeron**.</i>",
            "<i>Ella **hablo**</i> → <i>Ella **habló**</i> (sans accent = présent).",
            "<i>Fui profesor</i> = « j’ai été » ; <i>Fui a Madrid</i> = « je suis allé » : le contexte tranche."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>Ayer (yo) ___ (tener) un examen.</i>",
            "<i>Ellos ___ (decir) la verdad.</i>",
            "<i>Anoche ella ___ (pedir) una pizza.</i>"
          ],
          "reponses": "1) tuve 2) dijeron 3) pidió"
        }
      ]
    }
  ]
}
