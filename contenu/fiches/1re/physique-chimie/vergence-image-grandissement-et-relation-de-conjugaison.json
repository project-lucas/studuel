{
  "titre": "Lentille convergente",
  "titreSurligne": "convergente",
  "accroche": "Vergence, image et grandissement.",
  "bonus": "C = 1 ÷ f′ (**δ**) · 1 ÷ OA′ − 1 ÷ OA = 1 ÷ f′ · γ = OA′ ÷ OA",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/1re/physique-chimie/vergence-image-grandissement-et-relation-de-conjugaison.webp",
