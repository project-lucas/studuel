          "items": [
            {
              "titre": "look forward to",
              "texte": "<i>I look forward to **seeing** you.</i>"
            },
            {
              "titre": "be used to",
              "texte": "<i>I’m used to **getting up** early.</i>"
            },
            {
              "titre": "object to",
              "texte": "<i>She objects to **paying**.</i>"
