{
  "titre": "Les démonstratifs",
  "titreSurligne": "démonstratifs",
  "accroche": "Montrer du doigt, en anglais.",
  "bonus": "**this / these** = proche · **that / those** = loin",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/4e/anglais/les-adjectifs-demonstratifs.webp",
    "prompt": "a glossy violet pointing hand with a golden index finger, two small golden objects, one near and one far away, sparkles, same art style as the reference icons, magenta background"
  },
  "marcel": "Celui-ci&nbsp;?\nOu celui-là&nbsp;?",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "Les quatre mots",
          "lignes": [
            "**this** · **these** / **that** · **those**"
          ],
          "petite": true,
          "regle": "Deux choix&nbsp;: le **nombre** (un ou plusieurs) et la **distance** (près ou loin).",
          "note": "pas de -s en plus"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Le tableau",
          "entetes": [
            "",
            "Proche",
            "Éloigné"
          ],
          "lignes": [
            [
              "Singulier",
              "**this** <i>book</i>",
              "**that** <i>house</i>"
            ],
            [
              "Pluriel",
              "**these** <i>shoes</i>",
              "**those** <i>days</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Ce qu’on peut montrer",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "Dans l’espace",
              "texte": "<i>**This** book is interesting.</i> (je le tiens) / <i>**That** house over there is old.</i>"
            },
            {
              "titre": "Dans le temps",
              "texte": "<i>**this** morning, **this** week</i> (maintenant) / <i>**that** summer</i> (autrefois)"
            },
            {
              "titre": "Adjectif ou pronom",
              "texte": "Avec un nom&nbsp;: <i>this car</i>. Seul&nbsp;: <i>I prefer **these**.</i>"
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Accorder avec le nom",
          "oui": {
            "titre": "Même nombre",
            "texte": "<i>**These** children are tired.</i> (Ces enfants sont fatigués.)"
          },
          "non": {
            "titre": "Nombres mélangés",
            "texte": "<i>**This** children are tired.</i> — <i>children</i> est un pluriel."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>___ shoes (près de moi) are new.</i> → **These**&nbsp;: pluriel et proche."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Combien&nbsp;?",
              "texte": "Un seul → **this / that**. Plusieurs → **these / those**."
            },
            {
              "titre": "C’est où&nbsp;?",
              "texte": "Près de moi → **this / these**. Loin → **that / those**."
            },
            {
              "titre": "Pas de -s",
              "texte": "**those** est déjà un pluriel&nbsp;: jamais <i>thoses</i>."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "Présenter, téléphoner",
          "deux": true,
          "items": [
            {
              "titre": "This is my sister, Kate.",
              "texte": "pour présenter quelqu’un"
            },
            {
              "titre": "Hello, this is Paul.",
              "texte": "au téléphone&nbsp;: «&nbsp;c’est Paul&nbsp;»"
            },
            {
              "titre": "this [ɪ] / these [iː]",
              "texte": "voyelle courte / longue"
            },
            {
              "titre": "That was strange.",
              "texte": "pour un fait passé"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>thoses books</i> → <i>**those** books.</i>",
            "<i>this books</i> → <i>**these** books.</i>",
            "Au téléphone, pas <i>I am Paul</i> : <i>**this** is Paul.</i>",
            "<i>this</i> et <i>these</i> se différencient à l’oreille : [ɪ] court, [iː] long."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "texte",
          "numero": 7,
          "titre": "En situation",
          "paragraphes": [
            "<i>Look at **this** photo! **These** children are my cousins, and **that** boy over there is my brother.</i> (Regarde cette photo&nbsp;! Ces enfants sont mes cousins, et ce garçon là-bas est mon frère.)"
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>___ child (près de moi) is my cousin.</i>",
            "<i>___ mountains (là-bas) are high.</i>",
            "Pluriel de <i>this car</i>&nbsp;?"
          ],
          "reponses": "1) This 2) Those 3) these cars"
        }
      ]
    }
  ]
}
