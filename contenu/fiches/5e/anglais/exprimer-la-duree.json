          },
          "non": {
            "titre": "Present perfect",
            "texte": "<i>I **have met** him three years ago.</i>"
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>She has lived here ___ 2020.</i> → **since**&nbsp;: un point de départ."
