  },
  "marcel": "Demain&nbsp;? Choisis\nta forme&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "Le degré de préparation",
          "lignes": [
            "**will** + base verbale"
          ],
          "petite": true,
          "regle": "Décision immédiate → **will**. Intention ou indice → **be going to**. Rendez-vous fixé → **BE + -ING**.",
          "note": "won’t = will not"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Les quatre formes",
          "entetes": [
            "La forme",
            "Ce qu’elle dit",
            "L’exemple"
          ],
          "lignes": [
            [
              "will",
              "décision, prédiction, promesse",
              "<i>I’ll get it!</i> (je m’en occupe&nbsp;!)"
            ],
            [
              "be going to",
              "intention, indice présent",
              "<i>It’s going to rain.</i> (il va pleuvoir)"
            ],
            [
              "BE + -ING",
              "rendez-vous organisé",
              "<i>I’m meeting Sarah at six.</i>"
            ],
            [
              "Présent simple",
              "horaire officiel",
              "<i>The train leaves at 7.15.</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Les formes pas à pas",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "will",
              "texte": "<i>I **will** help you.</i> <i>I **won’t** help you.</i> <i>**Will** you help me?</i>"
            },
            {
              "titre": "be going to",
              "texte": "<i>She **is going to** travel.</i> <i>She **isn’t going to** travel.</i> <i>**Is** she **going to** travel?</i>"
            },
            {
              "titre": "BE + -ING",
              "texte": "<i>We **are leaving** tomorrow.</i> <i>We **aren’t leaving**.</i> <i>**Are** you **leaving**?</i>"
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Après when, if, as soon as",
          "oui": {
            "titre": "Le présent",
            "texte": "<i>I’ll call you when I **arrive**.</i> — après une conjonction de temps, présent."
          },
          "non": {
            "titre": "Pas de will",
            "texte": "<i>I’ll call you when I **will** arrive.</i> — faux, même si le sens est futur."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>When I ___ (be) older, I’ll travel.</i> → **am**&nbsp;: présent après <i>when</i>."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Décidé à l’instant&nbsp;?",
              "texte": "Ou une prédiction, une promesse → **will**."
            },
            {
              "titre": "Intention, indice&nbsp;?",
              "texte": "Nuages, projet déjà formé → **be going to**."
            },
            {
              "titre": "Fixé avec quelqu’un&nbsp;?",
              "texte": "**BE + -ING**&nbsp;; un horaire officiel&nbsp;: **présent simple**."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "Les emplois de will",
          "deux": true,
          "items": [
            {
              "titre": "L’offre, la promesse",
              "texte": "<i>I’ll carry your bag.</i> <i>I will always be there.</i>"
            },
            {
              "titre": "L’opinion",
              "texte": "<i>I think it will be sunny.</i>"
            },
            {
              "titre": "Le futur du passé",
              "texte": "<i>I was going to call you, but I forgot.</i> (j’avais l’intention de t’appeler)"
            },
            {
              "titre": "Après les conjonctions",
              "texte": "<i>when, as soon as, before, after, until</i> + présent."
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>I will to go</i> → <i>I will **go**</i>&nbsp;: will est un modal.",
            "<i>When I will be older</i> → <i>When I **am** older.</i>",
            "<i>I go to call you</i> → <i>I’m **going to** call you.</i>",
            "<i>It will rain</i> devant les nuages → <i>It’s **going to** rain.</i>"
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>Look at the sky! It ___ (rain).</i>",
            "<i>I’ll call you as soon as I ___ (arrive).</i>",
            "<i>I’m meeting Tom at six</i>&nbsp;: quelle forme&nbsp;?"
          ],
          "reponses": "1) is going to rain 2) arrive 3) BE + -ING"
        }
      ]
    }
  ]
}
