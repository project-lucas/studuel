{
  "titre": "Prép. + datif",
  "titreSurligne": "datif",
  "accroche": "Aus, bei, mit, nach, seit, von, zu.",
  "bonus": "**aus · bei · mit · nach · seit · von · zu** + **datif**, toujours",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/3e/allemand/les-prepositions-suivies-du-datif.webp",
    "prompt": "a glossy violet train station sign with seven small golden arrows around it, sparkles, same art style as the reference icons, magenta background"
  },
  "marcel": "Aus, bei, mit…\nTout au datif&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "La liste",
          "lignes": [
            "**aus – bei – mit – nach – seit – von – zu**"
          ],
          "petite": true,
          "regle": "Ces sept prépositions imposent le **datif** dans **tous** leurs emplois. La suite se retient comme une formule.",
          "note": "gegenüber, außer, ab aussi"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Les sept",
          "entetes": [
            "Préposition",
            "Sens",
            "Exemple"
          ],
          "lignes": [
            [
              "**aus**",
              "hors de, en (matière)",
              "<i>aus der Schweiz</i>"
            ],
            [
              "**bei**",
              "chez, près de",
              "<i>bei meinen Eltern</i>"
            ],
            [
              "**mit**",
              "avec, en (transport)",
              "<i>mit dem Bus</i>"
            ],
            [
              "**nach**",
              "après ; vers (ville)",
              "<i>nach dem Film</i>"
            ],
            [
              "**seit · von · zu**",
              "depuis · de · chez, vers",
              "<i>seit einem Jahr · zum Arzt</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Nach, in ou zu&nbsp;?",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "nach",
              "texte": "Pays ou ville **sans article** : <i>nach Deutschland, nach Wien</i>."
            },
            {
              "titre": "in + accusatif",
              "texte": "Pays **avec** article : <i>in die Schweiz, in die Türkei</i>."
            },
            {
              "titre": "zu",
              "texte": "Personne ou bâtiment but : <i>zum Arzt, zur Post</i>."
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Seit et le présent",
          "oui": {
            "titre": "Présent avec seit",
            "texte": "<i>Ich lerne **seit** drei Jahren Deutsch.</i> — j’apprends depuis trois ans."
          },
          "non": {
            "titre": "Passé composé",
            "texte": "<i>Ich habe seit drei Jahren Deutsch gelernt.</i> — l’allemand fait comme le français."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>Er wohnt seit ___ Jahr hier (n.).</i> → **einem**&nbsp;: datif neutre."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Reconnais la liste",
              "texte": "<i>aus, bei, mit, nach, seit, von, zu</i> → **datif**, sans exception."
            },
            {
              "titre": "Écris l’article au datif",
              "texte": "<i>dem</i> (m., n.), <i>der</i> (f.), <i>den</i> + **-n** (pluriel)."
            },
            {
              "titre": "Contracte",
              "texte": "<i>beim, vom, zum, zur</i> sont obligatoires à l’usage."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "Contractions et figés",
          "deux": true,
          "items": [
            {
              "titre": "bei dem, von dem",
              "texte": "<i>beim, vom</i>"
            },
            {
              "titre": "zu dem, zu der",
              "texte": "<i>zum, zur</i>&nbsp;: <i>zum Bahnhof, zur Schule</i>"
            },
            {
              "titre": "nach Hause",
              "texte": "rentrer (**avec** mouvement)"
            },
            {
              "titre": "zu Hause",
              "texte": "être à la maison (**sans** mouvement)"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "Employer l’accusatif après <i>mit</i>&nbsp;: <i>mit den Bus</i> → <i>mit **dem** Bus</i>.",
            "<i>nach</i> devant un pays à article&nbsp;: <i>nach die Schweiz</i> → <i>**in** die Schweiz</i>.",
            "Mettre le passé avec <i>seit</i>&nbsp;: l’allemand garde le **présent**.",
            "Confondre <i>nach Hause</i> et <i>zu Hause</i>."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "Cite les sept prépositions du datif.",
            "Complète&nbsp;: <i>Ich fahre mit ___ Bus (m.).</i>",
            "Traduis&nbsp;: je rentre à la maison."
          ],
          "reponses": "1) aus bei mit nach seit von zu 2) dem 3) Ich gehe nach Hause"
        }
      ]
    }
  ]
}
