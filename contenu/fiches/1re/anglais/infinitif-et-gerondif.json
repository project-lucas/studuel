          "lignes": [
            "préposition + **-ING**"
          ],
          "petite": true,
          "regle": "Toujours, sans exception&nbsp;: <i>before leaving, instead of waiting, good at singing</i>. Même avec **to** préposition&nbsp;: <i>look forward to **seeing** you</i>.",
          "note": "to = préposition ici"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Les deux listes",
          "entetes": [
            "Suivis de -ING",
            "Suivis de l’infinitif"
          ],
          "lignes": [
            [
              "<i>enjoy, avoid, finish</i>",
              "<i>want, decide, hope</i>"
            ],
            [
              "<i>mind, suggest, practise</i>",
              "<i>promise, refuse, agree</i>"
            ],
            [
              "<i>keep, give up, deny</i>",
              "<i>manage, offer, seem</i>"
            ],
            [
              "<i>can’t stand</i>",
              "<i>afford, expect</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Deux formes, deux sens",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "remember / forget",
              "texte": "+ infinitif&nbsp;: penser à faire (<i>Remember **to lock**</i>) · + -ING&nbsp;: se souvenir d’avoir fait (<i>I remember **locking** it</i>)."
            },
            {
              "titre": "stop",
              "texte": "<i>He stopped **to smoke**</i> (pour fumer) · <i>He stopped **smoking**</i> (il a arrêté)."
            },
            {
              "titre": "try / mean",
              "texte": "<i>Try **to open** it</i> (s’efforcer) · <i>Try **opening** it</i> (pour voir) · <i>I meant **to call**</i>."
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Stop&nbsp;: le contraire&nbsp;!",
          "oui": {
            "titre": "Arrêter de",
            "texte": "<i>I stopped **smoking**.</i> — j’ai arrêté de fumer."
          },
          "non": {
            "titre": "S’arrêter pour",
            "texte": "<i>I stopped **to smoke**.</i> — je me suis arrêté pour fumer."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>I look forward to ___ (see) you.</i> → **seeing**&nbsp;: <i>to</i> est une préposition."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Une préposition&nbsp;?",
              "texte": "<i>before, of, in, to</i> préposition → **-ING**."
            },
            {
              "titre": "Quel verbe&nbsp;?",
              "texte": "<i>enjoy</i> → -ING · <i>want</i> → infinitif."
            },
            {
              "titre": "Deux sens&nbsp;?",
              "texte": "<i>stop, remember, try</i> : le sens décide."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "To préposition",
