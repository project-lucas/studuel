          },
          "non": {
            "titre": "Amplitude",
            "texte": "Hauteur du motif&nbsp;: elle donne le **volume** (fort, faible)."
          },
          "essai": {
            "texte": "Changer l’amplitude ne change <i>pas</i> la note&nbsp;: on joue la même note plus ou moins fort."
          }
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
