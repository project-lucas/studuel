              "<i>feliz → **felicísimo**</i>",
              "<i>z</i> devant <i>i</i> s’écrit <i>c</i>"
            ],
            [
              "diphtongue réduite",
              "<i>fuerte → **fortísimo**</i>",
              "<i>bueno → buenísimo</i> admis"
            ]
