{
  "titre": "Les pronoms personnels",
  "titreSurligne": "pronoms",
  "accroche": "Je, me, mon, le mien, moi-même.",
  "bonus": "I – me – my – mine – myself · it = sujet vide · they = singulier neutre",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/4e/anglais/les-pronoms-personnels.webp",
    "prompt": "a glossy violet speech bubble with a golden pointing hand and small golden people icons, same art style as the reference icons, magenta background"
  },
  "marcel": "I, me, my, mine…\nlequel choisir&nbsp;?",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "Sujet ou complément",
          "lignes": [
            "**sujet** + verbe + **compl.**"
          ],
          "petite": true,
          "regle": "Le **sujet** (I, he…) est **obligatoire** devant le verbe. Le **complément** (me, him…) suit le verbe ou une préposition.",
          "note": "with them, for us"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Le tableau complet",
          "entetes": [
            "Sujet",
            "Complément",
            "Adjectif",
            "Possessif",
            "Réfléchi"
          ],
          "lignes": [
            [
              "I",
              "me",
              "my",
              "mine",
              "myself"
            ],
            [
              "you",
              "you",
              "your",
              "yours",
              "yourself"
            ],
            [
              "he",
              "him",
              "his",
              "his",
              "himself"
            ],
            [
              "she",
              "her",
              "her",
              "hers",
              "herself"
            ],
            [
              "it",
              "it",
              "its",
              "—",
              "itself"
            ],
            [
              "we / they",
              "us / them",
              "our / their",
              "ours / theirs",
              "ourselves / themselves"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Trois emplois à connaître",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "IT",
              "texte": "Sujet vide&nbsp;: <i>It’s cold. It’s five o’clock.</i> (Il fait froid.)"
            },
            {
              "titre": "ONE / ONES",
              "texte": "Évite de répéter un nom&nbsp;: <i>I prefer the red **one**.</i>"
            },
            {
              "titre": "THEY neutre",
              "texte": "Genre inconnu&nbsp;: <i>Someone called — **they** left a message.</i>"
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Réfléchi ou pas&nbsp;?",
          "oui": {
            "titre": "L’action revient",
            "texte": "<i>He hurt **himself**.</i> (Il s’est blessé.)"
          },
          "non": {
            "titre": "Pas de réfléchi",
            "texte": "<i>I wash myself.</i> — on dit <i>I **wash**.</i> (je me lave)"
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>She lives ___. (toute seule)</i> → **by herself**."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "Choisir le bon pronom",
          "etapes": [
            {
              "titre": "Sujet&nbsp;?",
              "texte": "Devant le verbe → **I, he, she, we, they**."
            },
            {
              "titre": "Complément&nbsp;?",
              "texte": "Après le verbe ou une préposition → **me, him, us**."
            },
            {
              "titre": "Possession&nbsp;?",
              "texte": "Avec un nom → **my** ; seul → **mine**."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "Les réfléchis",
          "deux": true,
          "items": [
            {
              "titre": "L’action revient",
              "texte": "<i>He hurt himself.</i>"
            },
            {
              "titre": "L’insistance",
              "texte": "<i>I did it **myself**.</i> (moi-même)"
            },
            {
              "titre": "by + réfléchi",
              "texte": "= tout seul&nbsp;: <i>by herself</i>"
            },
            {
              "titre": "Sans réfléchi",
              "texte": "<i>I get up, I feel</i> (je me lève, je me sens)"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>I saw he</i> → <i>I saw **him**.</i>",
            "<i>She loves hers dog</i> → <i>her dog.</i>",
            "« Je me lève » → <i>I get up</i>, pas <i>I get myself up</i>.",
            "Après une préposition, toujours le complément&nbsp;: <i>with **them**</i>."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>I saw ___. (he → complément)</i>",
            "<i>This book is ___. (à moi → pronom possessif)</i>",
            "<i>She lives by ___.</i>"
          ],
          "reponses": "1) him 2) mine 3) herself"
        }
      ]
    }
  ]
}
