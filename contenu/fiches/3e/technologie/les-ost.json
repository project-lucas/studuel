            {
              "terme": "Matière d’œuvre",
              "definition": "ce **sur quoi** l’objet agit"
            },
            {
              "terme": "Fonction d’usage",
              "definition": "le **but**, un verbe à l’infinitif (éclairer)"
            },
            {
              "terme": "Utilisateur",
              "definition": "celui à qui l’objet **rend service**"
            }
          ]
        },
        {
          "type": "tableau",
          "numero": 2,
