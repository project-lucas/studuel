{
  "titre": "Exprimer l’habitude",
  "titreSurligne": "habitude",
  "accroche": "Aujourd’hui, autrefois, s’habituer.",
  "bonus": "**used to** + base · **be / get used to** + -ING · **would** + action répétée",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/5e/anglais/exprimer-l-habitude.webp",
    "prompt": "a glossy violet circular arrow around a golden calendar page, tiny golden sparkles, same art style as the reference icons, magenta background"
  },
  "marcel": "Avant, je faisais…\nUsed to&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "Habitude passée",
          "lignes": [
            "**used to** + base verbale"
          ],
          "petite": true,
          "regle": "Une habitude **révolue**&nbsp;: avant oui, maintenant non.",
          "note": "avant, mais plus maintenant"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Le tableau qui range tout",
          "entetes": [
            "Sens",
            "Structure",
            "Suite"
          ],
          "lignes": [
            [
              "Habitude passée",
              "<i>used to</i>",
              "base verbale&nbsp;: <i>I used to **play**.</i>"
            ],
            [
              "Être habitué à",
              "<i>be used to</i>",
              "-ING ou nom&nbsp;: <i>I am used to **getting** up early.</i>"
            ],
            [
              "S’habituer à",
              "<i>get used to</i>",
              "-ING ou nom&nbsp;: <i>She is getting used to **her school**.</i>"
            ],
            [
              "Habitude présente",
              "présent simple",
              "<i>She **plays** tennis every Saturday.</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Trois moments",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "Aujourd’hui",
              "texte": "Présent simple + <i>always, usually, often, sometimes, rarely, never</i>, **avant** le verbe."
            },
            {
              "titre": "Autrefois",
              "texte": "<i>I **used to** play football.</i><br><i>Every summer, we **would** go to the beach.</i>"
            },
            {
              "titre": "Maintenant",
              "texte": "<i>I am **used to** getting up early.</i><br><i>She is **getting used to** her school.</i>"
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Used to, la base verbale",
          "oui": {
            "titre": "Base verbale",
            "texte": "<i>I used to **swim**.</i> / <i>Did you **use** to live here?</i>"
          },
          "non": {
            "titre": "-ING après used to",
            "texte": "<i>I used to **swimming**.</i> / <i>I didn’t **used** to like it.</i>"
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>I am used to ___ (get) up early.</i> → **getting**&nbsp;: <i>be used to</i> + -ING."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Passé ou présent&nbsp;?",
              "texte": "Révolu → <i>used to</i>. Acquis → <i>be used to</i>."
            },
            {
              "titre": "La suite",
              "texte": "<i>used to</i> + **base**&nbsp;; <i>be / get used to</i> + **-ING**."
            },
            {
              "titre": "Would&nbsp;?",
              "texte": "Seulement pour une **action répétée**, jamais un état."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "Les petites règles",
          "deux": true,
          "items": [
            {
              "titre": "Négation",
              "texte": "<i>I **didn’t use to** like it.</i> (sans -d)"
            },
            {
              "titre": "Question",
              "texte": "<i>**Did** you **use to** live here?</i>"
            },
            {
              "titre": "Would et état",
              "texte": "<i>I used to be shy.</i> (jamais <i>would be shy</i>)"
            },
            {
              "titre": "Fréquence",
              "texte": "<i>always, often, never</i> avant le verbe"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>I am used to play</i> → <i>I am used to **playing**.</i>",
            "<i>I used to swimming</i> → <i>I used to **swim**.</i>",
            "<i>I would be shy</i> (état) → <i>I **used to** be shy.</i>",
            "<i>didn’t used to</i> → <i>didn’t **use** to</i>"
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>I ___ play football.</i> (habitude passée)",
            "<i>She is used to ___ (get) up early.</i>",
            "<i>Did you ___ to live here?</i>"
          ],
          "reponses": "1) used to 2) getting 3) use"
        }
      ]
    }
  ]
}
