              "texte": "quand répond-on directement ?"
            },
            {
              "titre": "Hypothèse",
              "texte": "supposer que la fonction marche pour n − 1"
            },
            {
              "titre": "Combiner",
              "texte": "en déduire le résultat pour n"
            },
            {
              "titre": "Tester",
              "texte": "vérifier sur n = 0, puis n = 1, puis n = 3"
