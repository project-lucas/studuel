{
  "titre": "Le comparatif",
  "titreSurligne": "comparatif",
  "accroche": "Plus, moins, aussi.",
  "bonus": "-er than · more … than · less … than · as … as",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/4e/anglais/le-comparatif.webp",
    "prompt": "a glossy violet balance scale with a golden coin on one side and a golden star on the other, same art style as the reference icons, magenta background"
  },
  "marcel": "Court&nbsp;: -er.\nLong&nbsp;: more&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "La supériorité",
          "lignes": [
            "**-er** than",
            "**more** … than"
          ],
          "petite": true,
          "regle": "**Court** (1 syllabe) → **-er than**. **Long** (2+ syllabes) → **more … than**.",
          "note": "jamais les deux"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Les trois comparatifs",
          "entetes": [
            "Le comparatif",
            "Construction",
            "Exemple"
          ],
          "lignes": [
            [
              "Supériorité",
              "-er than / more … than",
              "<i>taller than · more expensive than</i>"
            ],
            [
              "Infériorité",
              "**less** … than",
              "<i>less expensive than</i>"
            ],
            [
              "Égalité",
              "**as** … **as**",
              "<i>She is as tall as her brother.</i>"
            ],
            [
              "Égalité négative",
              "not as … as",
              "<i>He is not as fast as you.</i>"
            ],
            [
              "Adjectif en -y",
              "y → i + er",
              "<i>happy → happier than</i>"
            ],
            [
              "Consonne finale",
              "on la double",
              "<i>big → bigger than</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Les irréguliers",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "good → better",
              "texte": "<i>This film is better than that one.</i>"
            },
            {
              "titre": "bad → worse",
              "texte": "<i>The weather is worse today.</i>"
            },
            {
              "titre": "far → farther / further",
              "texte": "much / many → **more**, little → **less**."
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Une seule marque",
          "oui": {
            "titre": "-er ou more",
            "texte": "<i>tall**er** · **more** expensive</i>"
          },
          "non": {
            "titre": "Les deux",
            "texte": "<i>more taller</i> — jamais -er **et** more."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>big → ___ than</i> → **bigger** (consonne doublée)."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "Comparer",
          "etapes": [
            {
              "titre": "Court ou long&nbsp;?",
              "texte": "1 syllabe (ou -y) → **-er** ; 2+ → **more**."
            },
            {
              "titre": "Ajoute than",
              "texte": "Après un comparatif de supériorité ou d’infériorité."
            },
            {
              "titre": "Orthographe",
              "texte": "big → bigger · happy → happ**ier**."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "Avec un nom",
          "deux": true,
          "items": [
            {
              "titre": "Dénombrable",
              "texte": "<i>more books · **fewer** books</i>"
            },
            {
              "titre": "Indénombrable",
              "texte": "<i>more money · **less** money</i>"
            },
            {
              "titre": "De plus en plus",
              "texte": "<i>bigger and bigger</i>"
            },
            {
              "titre": "Plus… plus…",
              "texte": "<i>The more you practise, the better you get.</i>"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>more taller</i> → <i>taller</i>.",
            "<i>She is taller that me</i> → <i>than me.</i>",
            "<i>less books</i> → <i>fewer books.</i>",
            "« Aussi grand que » → <i>as tall as</i>, pas <i>as tall than</i>."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>happy → ___ than</i>",
            "<i>expensive → ___ expensive than</i>",
            "<i>She is as tall ___ her brother.</i>"
          ],
          "reponses": "1) happier 2) more 3) as"
        }
      ]
    }
  ]
}
