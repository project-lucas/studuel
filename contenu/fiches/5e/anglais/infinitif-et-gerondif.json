      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "La règle",
          "lignes": [
            "verbe + **to** … ou verbe + **-ING**"
          ],
          "petite": true,
          "regle": "Après certains verbes on met **to + verbe**, après d’autres le verbe en **-ING**. Il faut apprendre les listes.",
          "note": "après une préposition : -ING"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Deux listes à connaître",
          "entetes": [
            "Suivi de",
            "Les verbes",
            "L’exemple"
          ],
          "lignes": [
            [
              "**to** + verbe",
              "want, decide, hope, need, learn, promise",
              "<i>She decided to leave.</i>"
            ],
            [
              "**-ING**",
              "enjoy, like, love, hate, finish, avoid",
              "<i>I enjoy reading.</i>"
            ],
            [
              "**-ING**",
              "mind, suggest, keep, practise, miss",
              "<i>She finished working.</i>"
            ],
            [
              "**-ING** (piège)",
              "look forward to",
              "<i>I look forward to seeing you.</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Les règles automatiques",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "Après une préposition",
              "texte": "Toujours -ING&nbsp;: <i>before leaving</i>, <i>good at swimming</i>."
            },
            {
              "titre": "Après un modal",
              "texte": "Le verbe simple&nbsp;: <i>You must go.</i> / <i>I can swim.</i>"
            },
            {
              "titre": "Pour dire « pour »",
              "texte": "**to** ou **in order to**&nbsp;: <i>I went to the shop to buy bread.</i>"
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Stop to ou stop -ING&nbsp;?",
          "oui": {
            "titre": "Stop + -ING",
            "texte": "<i>He stopped **smoking**.</i> — il a arrêté de fumer."
          },
          "non": {
            "titre": "Stop + to",
            "texte": "<i>He stopped **to smoke**.</i> — il s’est arrêté pour fumer."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>I enjoy ___ (swim).</i> → **swimming**&nbsp;: enjoy + -ING."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Regarde ce qui précède",
              "texte": "Préposition → -ING. Modal → verbe simple."
            },
            {
              "titre": "Sinon, le verbe",
              "texte": "Sa liste&nbsp;: **to** ou **-ING**."
            },
            {
              "titre": "Si but",
              "texte": "« Pour… » se dit **to** ou **in order to**."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "Deux sens possibles",
          "deux": true,
          "items": [
            {
              "titre": "remember",
              "texte": "<i>remember to lock</i> (penser à) / <i>remember locking</i> (se rappeler avoir)"
            },
            {
              "titre": "try",
              "texte": "<i>try to open</i> (essayer de) / <i>try opening</i> (tester)"
            },
            {
              "titre": "stop",
              "texte": "arrêter de (-ING) ou s’arrêter pour (to)"
            },
            {
              "titre": "look forward to",
              "texte": "le to est une préposition → -ING"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>I enjoy to read</i> → <i>I enjoy **reading**.</i>",
            "<i>for buying</i> (le but) → <i>**to** buy.</i>",
            "<i>I look forward to see you</i> → <i>to **seeing** you.</i>",
            "<i>I can to swim</i> → <i>I can **swim**.</i>"
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>She decided ___ (leave).</i>",
            "<i>I enjoy ___ (read).</i>",
            "<i>He is good at ___ (swim).</i>"
          ],
          "reponses": "1) to leave 2) reading 3) swimming"
        }
      ]
    }
  ]
