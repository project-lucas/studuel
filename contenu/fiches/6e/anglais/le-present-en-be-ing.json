            {
              "titre": "Maintenant&nbsp;?",
              "texte": "L’action se passe **en ce moment** → BE + -ing."
            },
            {
              "titre": "Choisis BE",
              "texte": "**am** (I), **is** (he, she, it), **are** (you, we, they)."
            },
            {
              "titre": "Ajoute -ing",
              "texte": "Retire le e, double la consonne si le verbe est court."
