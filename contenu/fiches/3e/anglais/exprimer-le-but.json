{
  "titre": "Exprimer le but",
  "titreSurligne": "but",
  "accroche": "To, in order to, so that&nbsp;: pourquoi on agit.",
  "bonus": "**to** + base · **so as not to** (négatif) · **so that** + autre sujet · jamais **for** + verbe",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/3e/anglais/exprimer-le-but.webp",
    "prompt": "a glossy violet archery target with a golden arrow in the bullseye, tiny golden sparkles, same art style as the reference icons, magenta background"
  },
  "marcel": "Pour quoi faire&nbsp;?\nTo + verbe&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "Le but, même sujet",
          "lignes": [
            "**to** + base verbale"
          ],
          "petite": true,
          "regle": "<i>I went to the shop **to buy** bread.</i> En version formelle&nbsp;: **in order to / so as to**.",
          "note": "jamais for + verbe"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Les trois constructions",
          "entetes": [
            "La forme",
            "Quand",
            "L’exemple"
          ],
          "lignes": [
            [
              "to + base",
              "même sujet",
              "<i>She works hard **to succeed**.</i>"
            ],
            [
              "in order to / so as to",
              "même sujet, formel",
              "<i>He left early **in order to catch** the train.</i>"
            ],
            [
              "so that + proposition",
              "autre sujet",
              "<i>I’ll speak slowly **so that you can** understand.</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "For, deux emplois",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "for + nom",
              "texte": "aller chercher&nbsp;: <i>I went to the shop **for** bread.</i>"
            },
            {
              "titre": "for + -ING",
              "texte": "à quoi sert un objet&nbsp;: <i>This knife is **for cutting** bread.</i>"
            },
            {
              "titre": "Le but d’une action",
              "texte": "<i>I came **to see** you.</i> — to + base, **jamais** <i>for seeing</i>."
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "For ou to&nbsp;?",
          "oui": {
            "titre": "To + base verbale",
            "texte": "<i>I went to the shop **to buy** bread.</i>"
          },
          "non": {
            "titre": "For + verbe",
            "texte": "<i>I went to the shop for buying bread.</i> / <i>I came for see you.</i>"
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>I study ___ pass my exam.</i> → **to**&nbsp;: pas de <i>for to</i>&nbsp;!"
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Même sujet&nbsp;?",
              "texte": "**to** + base verbale (ou **in order to**)."
            },
            {
              "titre": "Autre sujet&nbsp;?",
              "texte": "**so that** + sujet + **can / could / will / would**."
            },
            {
              "titre": "But négatif&nbsp;?",
              "texte": "**so as not to** ou **in order not to**."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "Exemples traduits",
          "deux": true,
          "items": [
            {
              "titre": "To",
              "texte": "<i>I’m saving money **to buy** a bike.</i> (pour acheter)"
            },
            {
              "titre": "So as not to",
              "texte": "<i>She got up early **so as not to miss** the bus.</i>"
            },
            {
              "titre": "So that + can",
              "texte": "<i>Speak louder **so that** everyone **can** hear you.</i>"
            },
            {
              "titre": "What… for?",
              "texte": "<i>What did you do that **for**?</i> — Why? → <i>To ask…</i>"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>I came for see you</i> → <i>I came **to see** you</i>",
            "<i>I study for to pass</i> → <i>I study **to pass**</i>",
            "<i>so as to not forget</i> → <i>so as **not to** forget</i> (not avant to)",
            "<i>so that you finish</i> → <i>so that you **can** finish</i>"
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "texte",
          "numero": 7,
          "titre": "Le but négatif",
          "paragraphes": [
            "**not** se place **avant** to&nbsp;: <i>I wrote it down **so as not to** forget.</i> Avec un autre sujet&nbsp;: <i>He whispered **so that** the baby **wouldn’t** wake up.</i> Et jamais **for not** + verbe."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>I came ___ see you.</i> (for / to)",
            "<i>She got up early so as ___ to miss the bus.</i>",
            "<i>Speak louder so that everyone ___ hear you.</i>"
          ],
          "reponses": "1) to 2) not 3) can"
        }
      ]
    }
  ]
}
