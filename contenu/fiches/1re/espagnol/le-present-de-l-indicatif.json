        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>Yo (salir) ___ a las ocho.</i>",
            "<i>Ella (poder) ___ venir, nosotros (poder) ___ también.</i>",
            "<i>Tú (estar) ___ en casa.</i>"
          ],
          "reponses": "1) salgo 2) puede / podemos 3) estás"
        }
      ]
    }
  ]
