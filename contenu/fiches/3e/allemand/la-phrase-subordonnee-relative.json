    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "Règles de construction",
          "deux": true,
          "items": [
            {
              "titre": "Préposition",
              "texte": "devant le relatif, elle commande le cas&nbsp;: <i>Der Freund, mit **dem** ich fahre</i>."
            },
            {
              "titre": "was",
              "texte": "après <i>alles, nichts, etwas, viel</i>, un superlatif neutre ou une phrase entière."
            },
            {
              "titre": "Exemple",
              "texte": "<i>Alles, **was** du sagst, ist richtig.</i>"
            },
            {
              "titre": "Phrase entière",
              "texte": "<i>Er kam zu spät, **was** mich geärgert hat.</i>"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "Prendre le cas de l’antécédent&nbsp;: <i>Der Mann, **der** ich sehe</i> → <i>**den** ich sehe</i> (COD).",
            "<i>Alles, das du sagst</i> → <i>Alles, **was** du sagst</i>.",
            "<i>Der Freund, dem ich mit fahre</i> → <i>mit **dem** ich fahre</i>.",
            "Oublier une virgule&nbsp;: la relative est toujours entre virgules."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>Das Buch, ___ ich lese, ist spannend.</i> (COD, neutre)",
            "<i>Der Freund, mit ___ ich fahre.</i> (masculin)",
            "<i>Alles, ___ du sagst, ist richtig.</i>"
          ],
          "reponses": "1) das 2) dem 3) was"
        }
      ]
    }
  ]
