            {
              "titre": "Soutenu",
              "texte": "<i>the girl to whom I spoke</i>"
            },
            {
              "titre": "Pas mot à mot",
              "texte": "« que » donne <i>that, which, who</i> ou **rien**."
            },
            {
              "titre": "Whose",
              "texte": "<i>the boy whose bike was stolen</i>"
            }
