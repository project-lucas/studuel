            {
              "titre": "Obligation ou supposition&nbsp;?",
              "texte": "<i>deber</i> + inf. oblige ; <i>deber de</i> + inf. suppose."
            },
            {
              "titre": "Quel temps&nbsp;?",
              "texte": "<i>había que, habrá que, hubo que</i> : <i>hay que</i> reste invariable."
