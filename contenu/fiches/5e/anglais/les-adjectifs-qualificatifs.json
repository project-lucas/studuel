            {
              "titre": "-ed = ce que je ressens",
              "texte": "<i>I am **bored**.</i> (je m’ennuie) · <i>interested, tired, surprised</i>"
            },
            {
              "titre": "-ing = ce qui le provoque",
              "texte": "<i>The film is **boring**.</i> (ennuyeux) · <i>interesting, tiring, surprising</i>"
            },
            {
              "titre": "Le piège",
              "texte": "<i>I am boring</i> = « je suis ennuyeux ». Pour dire que tu t’ennuies&nbsp;: <i>I am bored</i>."
