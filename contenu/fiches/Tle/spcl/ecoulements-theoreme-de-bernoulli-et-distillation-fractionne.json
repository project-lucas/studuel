        {
          "type": "formule",
          "numero": 1,
          "titre": "Débit et conservation",
          "petite": true,
          "teinte": "jaune",
          "lignes": [
            "Q<sub>v</sub> = S × v",
            "S₁ × v₁ = S₂ × v₂"
          ],
          "regle": "Liquide incompressible, écoulement permanent&nbsp;: le débit **se conserve**. q<sub>m</sub> = ρ × Q<sub>v</sub>.",
          "note": "rétrécir = accélérer"
        },
        {
          "type": "formule",
          "numero": 2,
          "titre": "Bernoulli",
          "petite": true,
          "teinte": "jaune",
          "lignes": [
            "p + ½ρv² + ρgz = cte"
          ],
          "regle": "Fluide parfait, le long d’une ligne de courant. Réel&nbsp;: ajouter la **pompe** et les **pertes de charge**.",
          "note": "10 m d’eau ≈ 1 bar"
        }
      ]
    },
    {
      "colonnes": "1fr 262px",
      "blocs": [
        {
          "type": "etapes",
          "numero": 3,
          "titre": "Lire un diagramme binaire",
          "etapes": [
            {
              "titre": "Ébullition",
              "texte": "courbe du **bas** : première bulle"
            },
            {
              "titre": "Rosée",
              "texte": "courbe du **haut** : première goutte"
            },
            {
              "titre": "Entre les deux",
              "texte": "vapeur **plus riche** en volatil"
            }
          ]
        },
        {
          "type": "postit",
