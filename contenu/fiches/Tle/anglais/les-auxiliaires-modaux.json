          "petite": true,
          "regle": "Jamais de **-s** à la 3<sup>e</sup> personne, jamais de **to** ensuite&nbsp;: <i>He **can swim**</i>. Deux modaux ne se suivent pas&nbsp;: <i>he will **be able to**</i>.",
          "note": "cannot, mustn’t"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Les valeurs",
          "entetes": [
            "Modal",
            "Il exprime",
            "Exemple"
          ],
          "lignes": [
            [
              "**can / could**",
              "capacité, permission",
              "<i>She can drive.</i>"
            ],
            [
              "**may / might**",
              "possibilité incertaine",
              "<i>It might rain.</i>"
            ],
            [
              "**should**",
              "conseil",
              "<i>You should rest.</i>"
            ],
            [
              "**will / would**",
              "prédiction, habitude passée",
              "<i>He would spend hours there.</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Must et have to",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "must",
              "texte": "Obligation du **locuteur**&nbsp;: <i>You **must** go now.</i> Ou déduction&nbsp;: <i>He **must** be exhausted.</i>"
            },
            {
              "titre": "have to",
              "texte": "Obligation des **circonstances**&nbsp;: <i>I **have to** work on Saturdays.</i>"
            },
            {
              "titre": "Modal + have + pp",
              "texte": "Regard sur le passé&nbsp;: <i>must have missed</i> (déduction), <i>should have called</i> (reproche), <i>can’t have seen</i>."
