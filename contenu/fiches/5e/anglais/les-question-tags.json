      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "Le tag",
          "lignes": [
            "phrase, **aux. + pronom**?"
          ],
          "petite": true,
          "regle": "Même **auxiliaire**, **polarité inverse**, sujet en **pronom**.",
          "note": "positive → tag négatif"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Des exemples",
          "entetes": [
            "La phrase",
            "Son tag",
            "Pourquoi"
          ],
          "lignes": [
            [
              "<i>She is a teacher,</i>",
              "<i>**isn’t she**?</i>",
              "positive → négatif"
            ],
            [
              "<i>They didn’t come,</i>",
              "<i>**did they**?</i>",
              "négative → positif"
            ],
            [
              "<i>You like coffee,</i>",
              "<i>**don’t you**?</i>",
              "pas d’auxiliaire → do"
            ],
            [
              "<i>He has finished,</i>",
              "<i>**hasn’t he**?</i>",
              "on reprend <i>has</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Les cas particuliers",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "I am",
              "texte": "<i>I am late, **aren’t I**?</i> — forme consacrée"
            },
            {
              "titre": "Let’s et impératif",
              "texte": "<i>Let’s go, **shall we**?</i> / <i>Close the door, **will you**?</i>"
            },
            {
              "titre": "There et somebody",
              "texte": "<i>There is a problem, **isn’t there**?</i> / <i>Somebody called, **didn’t they**?</i>"
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Polarité inverse",
          "oui": {
            "titre": "Inversée",
            "texte": "<i>You are French, **aren’t you**?</i> / <i>You aren’t French, **are you**?</i>"
          },
          "non": {
            "titre": "Même polarité",
            "texte": "<i>You are French, **are you**?</i> / <i>You like it, **do you**?</i>"
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>They can swim, ___?</i> → **can’t they**."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "L’auxiliaire",
              "texte": "Repère-le&nbsp;; s’il n’y en a pas, <i>do / does / did</i>."
            },
            {
              "titre": "La polarité",
              "texte": "Phrase positive → tag **négatif**&nbsp;; négative → **positif**."
            },
            {
              "titre": "Le pronom",
              "texte": "Reprends le sujet en **pronom** (<i>she, they, there</i>)."
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "texte",
          "numero": "★",
          "titre": "À retenir",
          "paragraphes": [
            "Un tag se **déduit**&nbsp;: tu reprends l’auxiliaire, tu **inverses** le positif et le négatif, tu mets le sujet en **pronom**. Rien à deviner."
          ],
          "teinte": "jaune"
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "L’intonation",
          "deux": true,
          "items": [
            {
              "titre": "Voix qui descend",
              "texte": "Tu es **sûr**, tu cherches l’accord."
            },
            {
              "titre": "Voix qui monte",
              "texte": "Tu **doutes** vraiment&nbsp;: c’est une vraie question."
            },
            {
              "titre": "Le tag est court",
              "texte": "La négation se contracte&nbsp;: <i>isn’t, don’t</i>."
            },
            {
              "titre": "Réponse",
              "texte": "<i>Yes, she is.</i> / <i>No, she isn’t.</i>"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>He is tall, is he?</i> → <i>He is tall, **isn’t he**?</i>",
            "<i>You like it, doesn’t you?</i> → <i>**don’t** you?</i>",
            "Pas de nom dans le tag&nbsp;: <i>isn’t Tom?</i> → <i>isn’t **he**?</i>",
            "Le tag ne s’invente pas : il se **déduit**."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>She is a teacher, ___?</i>",
            "<i>They didn’t come, ___?</i>",
            "<i>I am right, ___?</i>"
          ],
          "reponses": "1) isn’t she 2) did they 3) aren’t I"
        }
      ]
    }
  ]
