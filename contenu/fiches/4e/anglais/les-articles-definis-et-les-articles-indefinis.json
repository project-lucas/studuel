            { "titre": "Sans article", "texte": "Les pays, villes, langues&nbsp;: <i>France, Paris, English</i>. Les repas&nbsp;: <i>for breakfast</i>." },
            { "titre": "Avec a", "texte": "Un métier&nbsp;: <i>She is **a** dentist.</i> Une fréquence&nbsp;: <i>twice **a** week</i>." }
