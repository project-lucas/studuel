          "titre": "Le repère qui tranche",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "Passé composé",
              "texte": "<i>hoy, esta semana, este mes, este año</i> — le marqueur contient **este / esta**."
            },
            {
              "titre": "Passé composé aussi",
              "texte": "<i>últimamente, ya, todavía no, aún no, nunca, alguna vez</i>"
            },
            {
              "titre": "Passé simple",
              "texte": "<i>ayer, anoche, el año pasado, en 1990</i> — une date ou **ayer**."
            }
