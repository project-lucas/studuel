          "titre": "Les idées clés",
          "items": [
            {
              "titre": "Prévenir",
              "texte": "mieux vaut ne pas produire de déchet"
            },
            {
              "titre": "Économiser les atomes",
              "texte": "tout dans le produit"
            },
            {
              "titre": "Solvants sûrs",
              "texte": "eau, éthanol"
            },
            {
              "titre": "Catalyse",
              "texte": "plutôt qu’un réactif en excès"
            },
            {
              "titre": "Renouvelable",
              "texte": "biomasse plutôt que pétrole"
            },
            {
              "titre": "Énergie",
              "texte": "température ambiante si possible"
            },
            {
              "titre": "Dégradable",
              "texte": "des produits qui ne persistent pas"
            },
            {
              "titre": "Analyse",
              "texte": "suivre la réaction en temps réel"
            }
