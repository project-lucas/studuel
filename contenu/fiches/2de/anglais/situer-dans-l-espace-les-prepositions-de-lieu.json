{
  "titre": "Prépositions de lieu",
  "titreSurligne": "lieu",
  "accroche": "In, on, at : trois façons de voir.",
  "bonus": "**in** = volume · **on** = surface · **at** = point",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/2de/anglais/situer-dans-l-espace-les-prepositions-de-lieu.webp",
    "prompt": "a glossy violet map pin above a golden box, a golden flat tile and a golden dot, sparkles, same art style as the reference icons, magenta background"
  },
  "marcel": "Volume, surface\nou point&nbsp;?",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "La règle",
          "lignes": [
            "**in** · **on** · **at**"
          ],
          "petite": true,
          "regle": "Tout dépend de la façon dont on **voit le lieu** : un volume, une surface ou un point.",
          "note": "ville, pays : in"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Trois manières de voir",
          "entetes": [
            "Le lieu est…",
            "Exemples"
          ],
          "lignes": [
            [
              "**in** : un volume",
              "<i>in the kitchen, in London, in the car</i>"
            ],
            [
              "**on** : une surface",
              "<i>on the table, on the wall, on the 2nd floor</i>"
            ],
            [
              "**at** : un point",
              "<i>at the station, at school, at home</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 3,
          "titre": "Le même « à » français",
          "oui": {
            "titre": "Bien vu",
            "texte": "<i>She lives **in** Paris, **at** 10 Downing Street, **on** Oxford Street (US).</i>"
          },
          "non": {
            "titre": "Transports",
            "texte": "<i>**in** a car, a taxi</i> (enfermé) · <i>**on** a bus, a train, a plane, a bike</i>."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>I’m ___ the bus stop.</i> → **at**&nbsp;: un point de rendez-vous."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 4,
          "titre": "Situer précisément",
          "colonnes": 4,
          "cartes": [
            {
              "titre": "À côté",
              "texte": "<i>next to, beside, not far from</i>"
            },
            {
              "titre": "Face à face",
              "texte": "<i>opposite</i> (en face) · <i>between… and…</i>"
            },
            {
              "titre": "Devant / derrière",
              "texte": "<i>in front of · behind · at the far end of</i>"
            },
            {
              "titre": "Une image",
              "texte": "<i>in the foreground / background · on the left</i>"
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Vois le lieu",
              "texte": "Volume → <b>in</b>. Surface → <b>on</b>. Point → <b>at</b>."
            },
            {
              "titre": "Mouvement&nbsp;?",
              "texte": "Aller vers : <b>to</b>. Entrer : <b>into</b>. Rentrer : <b>home</b>."
            },
            {
              "titre": "Précise",
              "texte": "<i>next to, opposite, between… and…</i> ou la place dans l’image."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "postit",
          "titre": "Exemple résolu",
          "donnees": "« Une femme est assise sur un banc, dans le parc. »",
          "calcul": "<i>sitting on a bench in the park</i>\nPlus loin : <i>at the far end of the path</i>",
          "aparte": "surface → on · volume → in",
          "resultat": "[[on a bench in the park]]"
        },
        {
          "type": "pieges",
          "items": [
            "<i>arrive to London</i> → <i>arrive **in** London / **at** the station</i>.",
            "<i>go to home</i> → <i>go **home**</i> (sans to).",
            "<i>in the bus</i> → <i>**on** the bus</i>.",
            "Mouvement : <i>to</i> et <i>into</i> (<i>walked into the room</i>).",
            "Rue sans numéro : <i>in</i> Oxford Street (britannique), <i>on</i> (américain)."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>She is ___ school.</i> (in / on / at)",
            "Dis&nbsp;: « au premier plan ».",
            "<i>He arrived ___ London.</i>"
          ],
          "reponses": "1) at 2) in the foreground 3) in"
        }
      ]
    }
  ]
}