{
  "titre": "Exprimer l’habitude",
  "titreSurligne": "habitude",
  "accroche": "Aujourd’hui, autrefois, s’habituer.",
  "bonus": "used to + base · be used to + -ING · would",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/4e/anglais/exprimer-l-habitude.webp",
    "prompt": "a glossy violet calendar with golden checkmarks and a small golden clock, same art style as the reference icons, magenta background"
  },
  "marcel": "Used to + base,\nbe used to + -ING&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "Habitude passée",
          "lignes": [
            "**used to** + base"
          ],
          "petite": true,
          "regle": "**used to** + base verbale = une habitude **révolue** (avant, plus maintenant).",
          "note": "didn’t use to (sans -d)"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Les trois structures",
          "entetes": [
            "Sens",
            "Structure",
            "Suite"
          ],
          "lignes": [
            [
              "Habitude passée",
              "**used to**",
              "base verbale"
            ],
            [
              "Être habitué à",
              "**be used to**",
              "-ING ou nom"
            ],
            [
              "S’habituer à",
              "**get used to**",
              "-ING ou nom"
            ],
            [
              "Habitude présente",
              "présent simple",
              "always, often, usually…"
            ],
            [
              "Négation passée",
              "**didn’t use to**",
              "base verbale"
            ],
            [
              "Question passée",
              "**Did** … **use to**…?",
              "base verbale"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Trois exemples",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "Passé révolu",
              "texte": "<i>I **used to play** football.</i> (avant, plus maintenant)"
            },
            {
              "titre": "Être habitué",
              "texte": "<i>I **am used to getting** up early.</i>"
            },
            {
              "titre": "S’habituer",
              "texte": "<i>She **is getting used to** her new school.</i>"
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Used to ou be used to",
          "oui": {
            "titre": "Passé : base",
            "texte": "<i>I used to **swim**.</i> (je nageais)"
          },
          "non": {
            "titre": "Habitude : -ING",
            "texte": "<i>I am used to **swimming**.</i> (j’ai l’habitude de nager)"
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>She is used to ___ (get up) early.</i> → **getting up**."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "Choisir",
          "etapes": [
            {
              "titre": "Passé fini&nbsp;?",
              "texte": "Avant, plus maintenant → **used to** + base."
            },
            {
              "titre": "Habitude acquise&nbsp;?",
              "texte": "**be used to** + -ING."
            },
            {
              "titre": "Progressif&nbsp;?",
              "texte": "**get used to** + -ING."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "Autres emplois",
          "deux": true,
          "items": [
            {
              "titre": "Négation",
              "texte": "<i>I didn’t use to like it.</i>"
            },
            {
              "titre": "Question",
              "texte": "<i>Did you use to live here?</i>"
            },
            {
              "titre": "Would",
              "texte": "actions répétées passées&nbsp;: <i>we would go to the beach</i>"
            },
            {
              "titre": "Fréquence",
              "texte": "**avant** le verbe&nbsp;: <i>I often go.</i>"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>I would be shy</i> → <i>I **used to** be shy.</i> (would jamais pour un état)",
            "<i>I didn’t used to</i> → <i>didn’t use to.</i>",
            "<i>I am used to swim</i> → <i>swimming.</i>",
            "« J’ai l’habitude de… » = <i>I am used to…</i>, pas <i>I use to.</i>"
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>I ___ ___ play football. (avant)</i>",
            "<i>I am used to ___ (get up) early.</i>",
            "<i>She is ___ ___ her new school. (s’habituer)</i>"
          ],
          "reponses": "1) used to 2) getting up 3) getting used to"
        }
      ]
    }
  ]
}
