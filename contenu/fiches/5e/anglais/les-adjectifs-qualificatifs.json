            "titre": "Avant le nom",
            "texte": "<i>a **beautiful** house, a **small** blue bag</i>"
          },
          "non": {
            "titre": "Comme en français",
            "texte": "<i>a house **beautiful**, two **reds** cars</i>"
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>It is a ___ film. (bored / boring)</i> → **boring**&nbsp;: le film ennuie."
