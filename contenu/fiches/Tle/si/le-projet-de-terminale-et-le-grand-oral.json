          "resultat": "une [[question]] générale"
        },
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Choisir sa question",
          "oui": { "titre": "Un problème", "texte": "« Un vélo électrique peut-il être plus sobre qu’un scooter&nbsp;? »" },
          "non": { "titre": "Une récitation", "texte": "« Qu’est-ce qu’un moteur électrique&nbsp;? » ou « Mon projet de robot »." },
          "essai": { "texte": "Une bonne question pose un <i>problème</i>, vise le programme, tient en dix minutes." }
        }
      ]
    },
    {
      "colonnes": "1fr 296px",
      "blocs": [
        {
          "type": "copie",
          "titre": "À dire au jury",
          "lignes": [
            { "texte": "Ma part du projet&nbsp;: le suivi de ligne", "quoi": "SA part" },
            { "texte": "Elle s’articule avec la motorisation", "quoi": "le lien aux autres" },
            { "texte": "Limites du modèle, choix écartés, suite", "quoi": "le recul" }
