        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 5,
          "titre": "Pompe et pression",
          "deux": true,
          "items": [
            {
              "titre": "Puissance utile",
              "texte": "P<sub>h</sub> = Q<sub>v</sub> × Δp"
            },
            {
              "titre": "Rendement",
              "texte": "η = P<sub>h</sub> / P absorbée"
            },
            {
              "titre": "Statique",
              "texte": "plus profond, **plus de pression**"
