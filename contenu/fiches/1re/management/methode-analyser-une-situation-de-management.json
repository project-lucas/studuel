{
  "titre": "Analyser un cas",
  "titreSurligne": "cas",
  "accroche": "Notion + indice du document.",
  "bonus": "Écrit de terminale&nbsp;: **4 h** sur des organisations réelles · **2 points** pour l’orthographe",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/1re/management/methode-analyser-une-situation-de-management.webp",
    "prompt": "a glossy violet open document with a golden magnifying glass and a small check mark, tiny golden sparkles, same art style as the reference icons, on magenta background, no text"
  },
  "marcel": "Une notion, un indice,\nune conclusion !",
  "rangs": [
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "tableau",
          "numero": 1,
          "titre": "Caractériser l’organisation",
          "entetes": ["Critère", "Question"],
          "lignes": [
            ["**Type**", "privée, publique, société civile&nbsp;?"],
            ["**Finalité**", "lucrative, intérêt général, non lucrative&nbsp;?"],
            ["**Taille, secteur**", "effectif, métier précis"],
            ["**Production**", "biens ou services, marchands ou non&nbsp;?"]
          ]
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Le verbe de la question",
          "entetes": ["Verbe", "Attendu"],
          "lignes": [
            ["**Identifier**", "nommer, avec un élément du document"],
            ["**Caractériser**", "décrire avec les notions du cours"],
            ["**Analyser**", "causes et effets"],
            ["**Évaluer**", "avantages, limites, conclusion"]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 3,
          "titre": "Répondre à une question",
          "etapes": [
            { "titre": "J’énonce", "texte": "la notion, définie en une phrase" },
            { "titre": "J’applique", "texte": "un indice précis du document" },
            { "titre": "Je conclus", "texte": "je réponds à la question posée" }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 262px",
      "blocs": [
        {
          "type": "postit",
          "titre": "Exemple résolu",
          "donnees": "« Caractérisez la modalité de croissance de Délices du Sud. » Document&nbsp;: elle a racheté la biscuiterie Lemoine et ses 45 salariés en 2025.",
          "calcul": "notion&nbsp;: se développer en rachetant\nindice&nbsp;: rachat de Lemoine, 45 salariés",
          "resultat": "[[croissance externe]]"
        },
        {
          "type": "liste",
          "numero": 4,
          "titre": "Soigner la rédaction",
          "items": [
            { "titre": "Phrases complètes", "texte": "un paragraphe par idée" },
            { "titre": "Vocabulaire du cours", "texte": "« facteur clé de succès »" },
            { "titre": "Citer court", "texte": "reformuler, ne pas recopier" },
            { "titre": "Relire", "texte": "l’orthographe compte" }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 280px",
      "blocs": [
        {
          "type": "copie",
          "titre": "Sur ta copie",
          "lignes": [
            { "texte": "La croissance externe consiste à se développer en rachetant d’autres entreprises.", "quoi": "notion" },
            { "texte": "Délices du Sud a racheté Lemoine en 2025, avec ses 45 salariés.", "quoi": "indice" },
            { "texte": "Il s’agit donc d’une croissance rapide, au risque d’un choc des cultures.", "quoi": "conclure" }
          ],
          "pied": "Une notion sans exemple est ==hors sujet== ; un exemple sans notion, de la paraphrase."
        },
        {
          "type": "pieges",
          "items": [
            "Confondre **finalité** et objectif.",
            "Confondre **opportunité** (externe) et force (interne).",
            "Répondre en général, **sans le cas**.",
            "**Oublier** de conclure."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "Que faut-il lire **avant** les documents&nbsp;?",
            "Que doit associer chaque réponse&nbsp;?",
            "Que fait-on pour le verbe **évaluer**&nbsp;?"
          ],
          "reponses": "1) les questions, et leur verbe · 2) une notion et un élément du document · 3) on pèse avantages et limites"
        }
      ]
    }
  ]
}
