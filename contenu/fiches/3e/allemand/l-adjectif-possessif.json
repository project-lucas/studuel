            {
              "titre": "Qu’est-ce qui est possédé&nbsp;?",
              "texte": "Repère **genre, nombre et cas** du nom."
            },
            {
              "titre": "Ajoute la terminaison",
              "texte": "Comme <i>ein</i>&nbsp;: rien au masculin nominatif, <i>-e</i> au féminin."
