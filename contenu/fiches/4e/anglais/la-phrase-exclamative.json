{
  "titre": "La phrase exclamative",
  "titreSurligne": "exclamative",
  "accroche": "What et how, pour s’exclamer.",
  "bonus": "what + nom · how + adjectif · so / such",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/4e/anglais/la-phrase-exclamative.webp",
    "prompt": "a glossy violet exclamation mark with golden stars and sparkles, same art style as the reference icons, magenta background"
  },
  "marcel": "What + nom,\nhow + adjectif&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "La règle",
          "lignes": [
            "**what** + nom",
            "**how** + adjectif"
          ],
          "petite": true,
          "regle": "**What** devant un **nom**, **how** devant un **adjectif** ou un **adverbe**.",
          "note": "pas d’inversion"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "What ou how&nbsp;?",
          "entetes": [
            "Le mot",
            "Après lui",
            "Exemple"
          ],
          "lignes": [
            [
              "what a / an",
              "nom singulier",
              "<i>What a beautiful day!</i>"
            ],
            [
              "what",
              "pluriel ou indénombrable",
              "<i>What terrible weather!</i>"
            ],
            [
              "how",
              "adjectif",
              "<i>How strange!</i>"
            ],
            [
              "how",
              "adverbe",
              "<i>How fast he runs!</i>"
            ],
            [
              "how + adjectif + sujet + verbe",
              "phrase complète",
              "<i>How beautiful this place is!</i>"
            ],
            [
              "what a + adjectif + nom",
              "singulier dénombrable",
              "<i>What a lovely surprise!</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "So et such",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "so",
              "texte": "+ adjectif ou adverbe&nbsp;: <i>She is **so** kind!</i>"
            },
            {
              "titre": "such a",
              "texte": "+ adjectif + nom singulier&nbsp;: <i>**such a** good film!</i>"
            },
            {
              "titre": "such",
              "texte": "+ nom pluriel&nbsp;: <i>**such** nice people!</i>"
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "L’ordre des mots",
          "oui": {
            "titre": "Sujet puis verbe",
            "texte": "<i>How beautiful this place **is**!</i>"
          },
          "non": {
            "titre": "Inversion",
            "texte": "<i>How beautiful **is this place**!</i> — c’est faux en exclamation."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>___ a pity!</i> → **What**&nbsp;! (« Quel dommage&nbsp;! »)"
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "S’exclamer",
          "etapes": [
            {
              "titre": "Un nom&nbsp;?",
              "texte": "**What** (a / an si singulier)."
            },
            {
              "titre": "Un adjectif&nbsp;?",
              "texte": "**How** + adjectif ou adverbe."
            },
            {
              "titre": "Garde l’ordre",
              "texte": "Sujet avant le verbe, **sans inversion**."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "Exclamations toutes faites",
          "deux": true,
          "items": [
            {
              "titre": "What a pity!",
              "texte": "Quel dommage&nbsp;!"
            },
            {
              "titre": "No way!",
              "texte": "Pas question&nbsp;!"
            },
            {
              "titre": "Well done!",
              "texte": "Bravo&nbsp;!"
            },
            {
              "titre": "How come?",
              "texte": "Comment ça se fait&nbsp;?"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>What beautiful day!</i> → <i>What **a** beautiful day!</i>",
            "<i>How a nice film!</i> → <i>What a nice film!</i>",
            "« Comme c’est beau&nbsp;! » → <i>How beautiful!</i>, jamais <i>How is it beautiful!</i>",
            "<i>such nice people</i> : pas de <i>a</i> devant un pluriel."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>___ a beautiful day!</i>",
            "<i>___ strange!</i>",
            "<i>She is ___ kind! (so / such)</i>"
          ],
          "reponses": "1) What 2) How 3) so"
        }
      ]
    }
  ]
}
