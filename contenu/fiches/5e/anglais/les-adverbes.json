          "items": [
            {
              "titre": "always · usually",
              "texte": "100 % · 90 %"
            },
            {
              "titre": "often · sometimes",
              "texte": "70 % · 50 %"
            },
            {
              "titre": "rarely",
              "texte": "10 %"
            },
            {
              "titre": "never",
