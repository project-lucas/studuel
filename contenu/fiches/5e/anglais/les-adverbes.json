          "titre": "La formation",
          "lignes": [
            "adjectif + **-ly**"
          ],
          "petite": true,
          "regle": "slow → slow**ly** · happy → happ**ily** · simple → simp**ly**. Un adverbe ne change jamais de forme.",
          "note": "good → well !"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Les irréguliers",
          "entetes": [
            "L’adjectif",
            "L’adverbe",
            "L’exemple"
          ],
          "lignes": [
            [
              "good",
              "**well**",
              "<i>She sings well.</i>"
            ],
            [
              "fast, early, late",
              "pareil",
              "<i>It goes fast.</i>"
            ],
            [
              "hard",
              "**hard** (dur) / hardly (à peine)",
              "<i>He works hard.</i>"
            ],
            [
              "late",
              "late (tard) / lately (récemment)",
              "<i>I’ve been tired lately.</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Où le placer",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "Fréquence",
              "texte": "**Avant** le verbe, **après** be&nbsp;: <i>I always get up early.</i> / <i>She is always late.</i>"
            },
            {
              "titre": "Manière, lieu, temps",
              "texte": "En fin de phrase, dans cet ordre&nbsp;: <i>She sang beautifully at the concert last night.</i>"
            },
            {
              "titre": "Degré, enough",
              "texte": "<i>very, quite, too</i> devant l’adjectif · <i>enough</i> après&nbsp;: <i>fast enough</i>."
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Adjectif ou adverbe&nbsp;?",
          "oui": {
            "titre": "Adverbe pour une action",
            "texte": "<i>She drives **carefully**.</i> / <i>He sings **well**.</i>"
          },
          "non": {
            "titre": "Après look, seem, feel",
            "texte": "<i>She looks **sad**.</i> — après ces verbes d’état, on met l’adjectif."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>He is a ___ (good) singer. He sings ___.</i> → **good** … **well**."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Que décrit-il&nbsp;?",
              "texte": "Un nom → adjectif. Un verbe → adverbe en **-ly**."
            },
            {
              "titre": "Fréquence",
              "texte": "Devant le verbe, mais après <i>be</i>."
            },
            {
              "titre": "Fin de phrase",
              "texte": "Manière, puis lieu, puis temps."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
