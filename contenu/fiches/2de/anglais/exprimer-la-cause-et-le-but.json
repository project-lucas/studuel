            [
              "**because of / due to**",
              "un **nom**"
            ],
            [
              "**thanks to**",
              "un nom (cause positive)"
            ],
            [
              "**for** + -ING",
              "une justification"
            ]
          ]
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Le but",
          "entetes": [
            "Expression",
            "Ce qui suit"
          ],
          "lignes": [
            [
              "**to**",
              "un verbe (courant)"
            ],
            [
              "**in order to / so as to**",
              "un verbe (formel)"
            ],
            [
              "**so that**",
              "une proposition, sujet différent"
            ],
            [
              "**so as not to**",
              "le but négatif"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Des exemples à retenir",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "because / because of",
              "texte": "<i>**because** it was raining</i> · <i>**because of** the rain</i>"
            },
            {
              "titre": "to / so that",
              "texte": "<i>I came **to help** you.</i> · <i>He spoke slowly **so that** everyone could understand.</i>"
            },
            {
              "titre": "for / to",
              "texte": "<i>for my sister</i> (un nom) · <i>to help</i> (un verbe)"
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Because ou because of&nbsp;?",
          "oui": {
            "titre": "Because + proposition",
            "texte": "<i>We stayed in **because it was raining**.</i>"
          },
          "non": {
            "titre": "Because of + nom",
            "texte": "<i>We stayed in **because of the rain**.</i> — jamais un sujet + verbe."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>I called ___ help.</i> (for / to) → **to**&nbsp;: un verbe suit."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Cause ou but&nbsp;?",
              "texte": "On remonte au pourquoi (cause) ou on avance vers un objectif (but)."
            },
            {
              "titre": "Nom ou verbe&nbsp;?",
              "texte": "Un **nom** → <i>because of, for</i>. Une proposition → <i>because, so that</i>."
            },
            {
              "titre": "Le pour français",
              "texte": "Un nom → **for**. Un verbe → **to**."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "À retenir",
          "deux": true,
          "items": [
            {
              "titre": "so that",
              "texte": "est suivi d’un modal&nbsp;: <i>can, could, would</i>."
            },
            {
              "titre": "since / as",
              "texte": "ouvrent la phrase&nbsp;: <i>As it was late, we left.</i>"
            },
            {
              "titre": "but négatif",
              "texte": "<i>so as **not** to be late</i>."
            },
            {
              "titre": "for + -ING",
              "texte": "<i>fined **for driving** too fast</i>."
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>because of it was raining</i> → <i>because it was raining</i>.",
            "<i>for to help</i> n’existe pas&nbsp;: <i>**to** help</i>.",
            "<i>to not be late</i> → <i>**so as not to** be late</i>.",
            "<i>for my sister</i> (nom) mais <i>to help my sister</i> (verbe)."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>We stayed in ___ the rain.</i> (because / because of)",
            "<i>I came ___ help you.</i> (for / to)",
            "<i>He left early ___ not to be late.</i>"
          ],
          "reponses": "1) because of 2) to 3) so as"
        }
      ]
    }
  ]
