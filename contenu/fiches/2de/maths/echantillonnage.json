          ],
          "regle": "Pour n assez grand et p ni proche de 0 ni de 1, environ **95 %** des échantillons ont une fréquence f dans cet intervalle. **p** : proportion de la population ; **f** : fréquence observée.",
          "note": "p = 0,5 et n = 100 : [0,4&nbsp;; 0,6]"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Taille et précision",
          "entetes": [
            "n",
            "{1/√n}"
          ],
          "lignes": [
            [
              "100",
              "**0,10**"
            ],
            [
              "400",
              "**0,05**"
            ],
            [
              "1 600",
              "**0,025**"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 3,
          "titre": "Tester une affirmation",
          "etapes": [
            {
              "titre": "Identifier",
              "texte": "p annoncée et la taille n de l’échantillon"
            },
            {
              "titre": "Encadrer",
              "texte": "calculer l’intervalle et la fréquence f"
            },
            {
              "titre": "Comparer",
              "texte": "hors de l’intervalle : on rejette ; dedans : on ne rejette pas"
            }
          ]
        }
      ]
    },
    {
      "colonnes": "262px 1fr",
      "blocs": [
        {
          "type": "postit",
          "titre": "Exemple résolu",
          "donnees": "Un dé donne 6 avec p = {1/6} ≈ 0,167. Sur __400 lancers__, 90 fois 6.",
          "calcul": "f = 90 ÷ 400 = 0,225\n[0,167 − 0,05&nbsp;; 0,167 + 0,05] = [0,117&nbsp;; 0,217]",
          "aparte": "{1/√400} = 0,05",
          "resultat": "0,225 hors de l’intervalle : [[on rejette]]"
        },
        {
          "type": "cartes",
          "numero": 4,
          "titre": "À savoir",
          "colonnes": 2,
          "cartes": [
            {
              "titre": "Fluctuation",
              "texte": "Deux échantillons, deux fréquences&nbsp;: pas une erreur."
            },
            {
              "titre": "Plus grand n",
              "texte": "La fluctuation **diminue** : quadrupler n divise l’incertitude par 2."
            },
            {
              "titre": "Dedans",
              "texte": "On ne rejette pas&nbsp;: ce n’est **pas** démontrer."
            },
            {
              "titre": "Biais",
              "texte": "Un mauvais recrutement ne se corrige pas par la taille."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 296px",
      "blocs": [
        {
          "type": "copie",
          "titre": "Sur ta copie",
          "lignes": [
            {
              "texte": "n = 400, p ≈ 0,167 : {1/√400} = 0,05",
              "quoi": "on identifie"
            },
            {
              "texte": "I = [0,117&nbsp;; 0,217] et f = 0,225",
              "quoi": "on encadre"
            },
            {
              "texte": "f ∉ I : on rejette au seuil de 95 %",
              "quoi": "on conclut"
            }
          ],
          "pied": "Conclure ==prudemment== : 5 % de risque."
