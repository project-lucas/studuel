          "aparte": "sans règles : vandalisme",
          "resultat": "[[intelligence collective]]"
        },
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Contribution ouverte",
          "oui": { "titre": "Avec règles", "texte": "Gouvernance, vérification, **communauté** qui corrige." },
          "non": { "titre": "Sans règles", "texte": "Vandalisme, **désinformation** et harcèlement." },
          "essai": { "texte": "OpenStreetMap et les logiciels libres suivent le même modèle." }
        }
      ]
    },
    {
      "colonnes": "1fr 296px",
      "blocs": [
        {
          "type": "copie",
          "titre": "Sur ta copie",
          "lignes": [
