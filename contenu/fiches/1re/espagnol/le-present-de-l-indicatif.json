          "type": "formule",
          "numero": 1,
          "titre": "Le radical + la fin",
          "lignes": ["habl**o** · com**o** · viv**o**"],
          "petite": true,
          "regle": "Le présent débloque **tous** les temps qui en dérivent, à commencer par le subjonctif. Aux deux dernières colonnes, seuls <i>nosotros</i> et <i>vosotros</i> diffèrent.",
          "note": "-ar · -er · -ir"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Les trois conjugaisons",
          "entetes": ["", "-ar", "-er", "-ir"],
          "lignes": [
            ["yo / tú", "<i>hablo, hablas</i>", "<i>como, comes</i>", "<i>vivo, vives</i>"],
            ["él", "<i>habla</i>", "<i>come</i>", "<i>vive</i>"],
            ["nosotros", "<i>hablamos</i>", "<i>comemos</i>", "<i>vivimos</i>"],
            ["vosotros", "<i>habláis</i>", "<i>coméis</i>", "<i>vivís</i>"],
            ["ellos", "<i>hablan</i>", "<i>comen</i>", "<i>viven</i>"]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Les irréguliers qui comptent",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "Seul <i>yo</i> change",
              "texte": "<i>hago, pongo, salgo, traigo, caigo, valgo, veo, doy</i> · <i>sé, quepo</i> · en <i>-cer/-cir</i> : <i>conozco, conduzco</i>."
            },
            {
              "titre": "Le radical en « botte »",
              "texte": "Diphtongue : <i>pienso, puedo, juego</i> · affaiblissement : <i>pido</i>. <i>Nosotros</i> et <i>vosotros</i> restent **réguliers**."
            },
            {
              "titre": "Les cumulards",
              "texte": "<i>tengo, vengo, digo</i> (+ diphtongue : <i>tienes, vienes, dices</i>) · <i>soy, voy, he, estoy</i> : à connaître par cœur."
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "L’accent d’« estar »",
          "oui": {
            "titre": "Quatre formes accentuées",
            "texte": "<i>est**á**s, est**á**, est**á**is, est**á**n</i> — l’accent marque la tonique."
          },
          "non": {
            "titre": "Sans accent",
            "texte": "<i>estoy</i> et <i>estamos</i>&nbsp;: aucun accent. Écrire <i>esta</i> pour <i>está</i> est une faute d’orthographe."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>Mis padres ___ en casa.</i> → **están**."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "Conjuguer au présent",
          "etapes": [
            {
              "titre": "Repère le verbe",
              "texte": "Irrégulier de <i>yo</i> ? À radical ? Cumulard ?"
            },
            {
              "titre": "Prends les terminaisons",
              "texte": "<i>-ar</i>, <i>-er</i> ou <i>-ir</i> selon l’infinitif."
            },
            {
              "titre": "Vérifie la « botte »",
              "texte": "Radical changé partout **sauf** <i>nosotros</i>, <i>vosotros</i>."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "Ce que dit le présent",
          "deux": true,
          "items": [
            {
              "titre": "Futur proche",
              "texte": "<i>Mañana **salgo** a las ocho.</i>"
            },
            {
              "titre": "Présent historique",
              "texte": "<i>En 1492, Colón **llega** a América.</i>"
            },
            {
              "titre": "Action commencée avant",
              "texte": "<i>**Estudio** español **desde hace** dos años.</i>"
            },
            {
              "titre": "Habitude",
              "texte": "<i>Todos los días **voy** al instituto.</i>"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>Yo **hacó**</i> → <i>Yo **hago**.</i>",
            "<i>Yo **poder**</i> → <i>Yo **puedo**</i> ; <i>nosotros **podemos**</i> (pas de diphtongue).",
            "<i>Yo **piedo**</i> → <i>Yo **pido**</i> : <i>pedir</i> perd son <i>e</i>, il ne diphtongue pas.",
