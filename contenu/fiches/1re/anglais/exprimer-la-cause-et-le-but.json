{
  "titre": "La cause et le but",
  "titreSurligne": "cause",
  "accroche": "Pourquoi&nbsp;? Remonter ou viser.",
  "bonus": "**because** + proposition · **because of** + nom · **to** + verbe · **so that** + proposition",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/1re/anglais/exprimer-la-cause-et-le-but.webp",
    "prompt": "a glossy violet archery target with a golden arrow in the center, a small golden arrow curving backwards, sparkles, same art style as the reference icons, magenta background"
  },
  "marcel": "Pourquoi&nbsp;?\nCause ou but&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "La règle",
          "lignes": ["**nom** ou **proposition**&nbsp;?"],
          "petite": true,
          "regle": "L’anglais distingue ce qui est suivi d’un **groupe nominal** de ce qui est suivi d’une **proposition** (sujet + verbe).",
          "note": "because of + nom"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "La cause",
          "entetes": ["Expression", "Ce qui suit", "Exemple"],
          "lignes": [
            ["**because**", "Une proposition", "<i>because it was raining</i>"],
            ["**since / as**", "Une proposition (cause connue)", "<i>As it was late, we left.</i>"],
            ["**because of / due to**", "Un **nom**", "<i>because of the rain</i>"],
            ["**thanks to**", "Un nom (cause positive)", "<i>thanks to your help</i>"]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Le but",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "to + base verbale",
              "texte": "Courant&nbsp;: <i>I came **to help** you.</i>"
            },
            {
              "titre": "in order to / so as to",
              "texte": "Formel&nbsp;: <i>in order to avoid delays</i>. Négatif&nbsp;: <i>so as **not** to be late</i>."
            },
            {
              "titre": "so that + proposition",
              "texte": "Sujet différent, avec un modal&nbsp;: <i>He spoke slowly **so that** everyone **could** understand.</i>"
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Because ou because of&nbsp;?",
          "oui": {
            "titre": "Le bon choix",
            "texte": "<i>because of **the rain**</i> (nom) · <i>because **it was raining**</i> (proposition)."
          },
          "non": {
            "titre": "La faute classique",
            "texte": "<i>because of **it was raining**</i> — après <i>because of</i>, jamais sujet + verbe."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>We stayed in ___ the weather.</i> → **because of** (un nom)."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "Le « pour » français",
          "etapes": [
            {
              "titre": "Suivi d’un nom",
              "texte": "**for**&nbsp;: <i>for my sister</i>."
            },
            {
              "titre": "Suivi d’un verbe",
              "texte": "**to**&nbsp;: <i>to help</i> — jamais <i>for to help</i>."
            },
            {
              "titre": "Autre sujet",
              "texte": "**so that** + proposition + modal&nbsp;: <i>so that she can come</i>."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "À retenir",
          "deux": true,
          "items": [
            {
              "titre": "for + -ING",
              "texte": "une justification&nbsp;: <i>fined for driving too fast</i>."
            },
            {
              "titre": "since / as",
              "texte": "en tête de phrase&nbsp;: cause déjà connue."
            },
            {
              "titre": "so as not to",
              "texte": "le négatif du but&nbsp;: <i>so as not to be late</i>."
            },
            {
              "titre": "so that + modal",
              "texte": "<i>can, could, would</i> presque toujours."
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>because of it was raining</i> → <i>because it was raining</i>.",
            "<i>for to help</i> → <i>**to** help</i>.",
            "<i>to not be late</i> → <i>so as **not to** be late</i>.",
            "<i>I came for helping</i> → <i>I came **to help**</i>."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>We left ___ the rain.</i> (because / because of)",
            "<i>I came ___ help you.</i> (for / to)",
            "<i>He left early ___ ___ ___ be late.</i> (négatif du but)"
          ],
          "reponses": "1) because of 2) to 3) so as not to"
        }
      ]
    }
  ]
}
