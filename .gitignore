# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify (graphe de connaissances local, reconstruit par le hook post-commit)
/graphify-out/

# outillage local (agent, config machine) — pas pour le depot
/_ASSOCIE/
/.claude/
# notes de critique d'interface produites en local par l'outil
/.impeccable/

.vercel

# sources brutes des vignettes matières (converties en webp dans public/images/matieres/vignettes/)
/assets-sources/

# sources brutes déposées dans public/ (PNG 4K des générateurs d'images) : elles
# ne sont JAMAIS servies — seules leurs conversions webp le sont — et pèsent des
# dizaines de Mo qui partiraient dans le dépôt et dans chaque déploiement.
#   fond écran/      → public/images/arene/arena-*.webp + defi/arene-finale.webp
#   écran chargement/ → public/images/splash.webp
/public/images/defi/fond écran/
/public/images/écran chargement/
#   mascotte/*.png   → public/images/mascotte/reaction-{bonne,mauvaise}.webp
/public/images/mascotte/*.png

# Sources d'illustration LOURDES, jamais servies par l'app : elles partaient
# dans chaque déploiement pour rien (19,6 Mo à elles trois, et zéro référence
# dans tout le dépôt). Le rendu final vit à côté en .webp.
/public/images/logo app/
/public/images/serie quizz/
/public/images/écran chargement/
/public/images/defi/modes/match v*.png

# doublon local des icônes PWA (identiques à /public/icons/, seul chemin servi
# et référencé par app/manifest.ts)
/public/LOGO/
#   serie quizz/     → public/images/mascotte/reaction-{bonne,mauvaise}-{1..5}.webp
#                      (régénérables : node scripts/serie-quizz.mjs)
/public/images/serie quizz/
