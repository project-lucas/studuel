  },
  "marcel": "Un chat, deux chats&nbsp;:\nun -s en plus&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "La règle de base",
          "lignes": [
            "nom + **-s**"
          ],
          "petite": true,
          "regle": "<i>a cat → two cats</i> (un chat → deux chats) · <i>a book → three books</i> (un livre → trois livres)",
          "note": "presque toujours"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Les cas particuliers",
          "entetes": [
            "Le nom finit par…",
            "On ajoute",
            "Exemple"
          ],
          "lignes": [
            [
              "**-s, -ss, -sh, -ch, -x**",
              "**-es**",
              "<i>a box → boxes</i> (des boîtes)"
            ],
            [
              "consonne + **y**",
              "**-ies**",
              "<i>a baby → babies</i> (des bébés)"
            ],
            [
              "voyelle + **y**",
              "**-s**",
              "<i>a boy → boys</i> (des garçons)"
            ],
            [
              "**-f / -fe**",
              "souvent **-ves**",
              "<i>a knife → knives</i> (des couteaux)"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Les pluriels bizarres (à connaître par cœur)",
          "colonnes": 4,
          "cartes": [
            {
              "titre": "man → men",
              "texte": "<i>woman → women</i> (femmes)"
            },
            {
              "titre": "child → children",
              "texte": "<i>two children</i> (deux enfants)"
            },
            {
              "titre": "foot → feet",
              "texte": "<i>tooth → teeth</i> (dents)"
            },
            {
              "titre": "person → people",
              "texte": "<i>mouse → mice</i> · <i>sheep → sheep</i>"
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": "★",
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Il est bizarre&nbsp;?",
              "texte": "<i>man, child, foot, person…</i> → je le connais par cœur."
            },
            {
              "titre": "Regarde la fin",
              "texte": "**-s, -sh, -ch, -x** → **-es** · consonne + **y** → **-ies**."
            },
            {
              "titre": "Sinon",
              "texte": "J’ajoute simplement un **-s**."
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Peut-on compter&nbsp;?",
          "oui": {
            "titre": "Dénombrable",
            "texte": "Pluriel et <i>a / an</i>&nbsp;: <i>an apple, two apples.</i> (une pomme, deux pommes)"
          },
          "non": {
            "titre": "Indénombrable",
            "texte": "Ni pluriel, ni <i>a / an</i>&nbsp;: <i>some water, some bread.</i> (de l’eau, du pain)"
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>I have two ___ (box).</i> → **boxes**&nbsp;: un nom en -x prend -es&nbsp;!"
          }
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 5,
          "titre": "Le -s se prononce…",
          "deux": true,
          "items": [
            {
              "titre": "/s/",
              "texte": "après p, t, k, f&nbsp;: <i>cats</i>"
            },
            {
              "titre": "/z/",
              "texte": "après une voyelle ou un son doux&nbsp;: <i>dogs</i>"
            },
            {
              "titre": "/ɪz/",
              "texte": "après un sifflement&nbsp;: <i>buses, watches</i>"
            },
            {
              "titre": "Indénombrables",
              "texte": "<i>water, money, bread, information, homework</i>"
            },
            {
              "titre": "Ne changent pas",
              "texte": "<i>one sheep, two sheep · one fish, two fish</i>"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>information</i> et <i>homework</i> n’ont **pas de pluriel** (en français : « des informations », « des devoirs »).",
            "<i>a water</i> ✗ → <i>some water</i> ✓.",
            "<i>two childs</i> ✗ → <i>two **children**</i> ✓.",
            "<i>a city → citys</i> ✗ → <i>cit**ies**</i> ✓.",
            "<i>two sheeps</i> ✗ → <i>two **sheep**</i> ✓."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "Pluriel de <i>a watch</i>&nbsp;?",
            "Pluriel de <i>a baby</i>&nbsp;?",
            "<i>I have some ___ (homework / homeworks).</i>"
          ],
          "reponses": "1) watches 2) babies 3) homework (jamais de -s)"
        }
      ]
    }
  ]
