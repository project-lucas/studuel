{
  "titre": "Le conditionnel",
  "titreSurligne": "conditionnel",
  "accroche": "Si… alors… : les trois types de if.",
  "bonus": "**if** + présent, **will** · **if** + prétérit, **would** · **if** + past perfect, **would have**",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/5e/anglais/exprimer-le-conditionnel.webp",
    "prompt": "a glossy violet fork in the road with a golden question mark and small golden sparkles, same art style as the reference icons, magenta background"
  },
  "marcel": "Si tu pouvais…\nWould&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "Les trois types",
          "lignes": [
            "**if** + temps, … **will / would**"
          ],
          "petite": true,
          "regle": "Le temps de **if** décide du type. Jamais de **will** ni de **would** juste après **if**.",
          "note": "if + will : faux !"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Le tableau",
          "entetes": [
            "Type",
            "If…",
            "Principale"
          ],
          "lignes": [
            [
              "**1** possible",
              "présent",
              "will + verbe"
            ],
            [
              "**2** irréel présent",
              "prétérit",
              "would + verbe"
            ],
            [
              "**3** irréel passé",
              "past perfect",
              "would have + participe"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Un exemple par type",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "Type 1",
              "texte": "<i>If it rains, I will stay home.</i>"
            },
            {
              "titre": "Type 2",
              "texte": "<i>If I had more time, I would travel.</i> (je n’en ai pas)"
            },
            {
              "titre": "Type 3",
              "texte": "<i>If I had studied, I would have passed.</i> (je n’ai pas révisé)"
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "If I were you…",
          "oui": {
            "titre": "were pour tous",
            "texte": "<i>If I **were** you, I would apologise.</i> — were à toutes les personnes."
          },
          "non": {
            "titre": "Pas de would après if",
            "texte": "<i>If I would have time</i> est faux."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>If I ___ (have) a dog, I would walk it.</i> → **had**&nbsp;: type 2."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Réel ou irréel&nbsp;?",
              "texte": "Possible → type 1. Irréel présent → 2. Passé → 3."
            },
            {
              "titre": "Écris if",
              "texte": "présent / prétérit / past perfect."
            },
            {
              "titre": "Écris la suite",
              "texte": "will / would / would have + verbe."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "Hors de if",
          "deux": true,
          "items": [
            {
              "titre": "Politesse",
              "texte": "<i>I would like a coffee.</i>"
            },
            {
              "titre": "Préférence",
              "texte": "<i>I would rather stay.</i>"
            },
            {
              "titre": "Après wish",
              "texte": "<i>I wish I could come.</i>"
            },
            {
              "titre": "La virgule",
              "texte": "si if ouvre la phrase&nbsp;: <i>If it rains, I stay.</i>"
            },
            {
              "titre": "Type 1",
              "texte": "le plus courant, pour le possible"
            },
            {
              "titre": "Type 3",
              "texte": "regret&nbsp;: <i>If I had known…</i>"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>If it will rain</i> → <i>If it **rains**.</i>",
            "<i>If I would have time</i> → <i>If I **had** time.</i>",
            "<i>If I had known, I would come</i> → <i>would **have** come.</i>",
            "Pas de virgule oubliée quand **if** ouvre la phrase.",
            "<i>If I will go</i> → <i>If I **go**, I will…</i>",
            "<i>If I was you</i> : on dit mieux <i>If I **were** you.</i>"
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>If it ___ (rain), I will stay home.</i>",
            "<i>If I ___ (have) more time, I would travel.</i>",
            "Type 3 : <i>If I had known, I would ___ come.</i>"
          ],
          "reponses": "1) rains 2) had 3) have"
        }
      ]
    }
  ]
}
