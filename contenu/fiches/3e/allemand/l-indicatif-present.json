{
  "titre": "L’indicatif présent",
  "titreSurligne": "présent",
  "accroche": "Un seul présent, qui dit aussi le futur.",
  "bonus": "radical + **-e · -st · -t · -en · -t · -en** · **seit** + présent",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/3e/allemand/l-indicatif-present.webp",
    "prompt": "a glossy violet alarm clock with golden bells and a small golden arrow pointing right, sparkles, same art style as the reference icons, magenta background"
  },
  "marcel": "Un seul présent,\npour tout dire&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "La forme",
          "lignes": [
            "radical + **terminaison**"
          ],
          "petite": true,
          "regle": "Radical = infinitif sans <i>-en</i>. <i>Ich spiele</i> = je joue = je suis en train de jouer&nbsp;: **une seule forme**.",
          "note": "pas de forme en -ing"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Les terminaisons",
          "entetes": [
            "Personne",
            "Terminaison",
            "spielen"
          ],
          "lignes": [
            [
              "ich",
              "**-e**",
              "<i>spiele</i>"
            ],
            [
              "du",
              "**-st**",
              "<i>spielst</i>"
            ],
            [
              "er / sie / es",
              "**-t**",
              "<i>spielt</i>"
            ],
            [
              "wir",
              "**-en**",
              "<i>spielen</i>"
            ],
            [
              "ihr",
              "**-t**",
              "<i>spielt</i>"
            ],
            [
              "sie / Sie",
              "**-en**",
              "<i>spielen</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Les trois valeurs du présent",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "Le moment présent",
              "texte": "<i>Ich spiele jetzt.</i> (je joue en ce moment)"
            },
            {
              "titre": "L’habitude",
              "texte": "<i>Ich spiele jeden Tag.</i> (je joue tous les jours)"
            },
            {
              "titre": "L’avenir proche",
              "texte": "<i>Morgen fahre ich nach Berlin.</i> — avec un adverbe de temps, le présent **suffit**."
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Seit&nbsp;: présent ou parfait&nbsp;?",
          "oui": {
            "titre": "Présent",
            "texte": "<i>Ich lerne **seit** drei Jahren Deutsch.</i> — comme en français, au présent."
          },
          "non": {
            "titre": "Parfait",
            "texte": "<i>Ich habe seit drei Jahren Deutsch gelernt.</i> — une faute avec <i>seit</i>."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>Sie ___ (wohnen) seit zwei Jahren hier.</i> → **wohnt**."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Trouve le radical",
              "texte": "L’infinitif sans <i>-en</i>&nbsp;: <i>spielen → spiel-</i>."
            },
            {
              "titre": "Ajoute la terminaison",
              "texte": "<i>-e, -st, -t, -en, -t, -en</i> selon la personne."
            },
            {
              "titre": "Contrôle",
              "texte": "Radical en <i>-d / -t</i> → un **e** de plus. En <i>-s, -ß, -z</i> → <i>du</i> sans <i>s</i>. Verbe fort → voyelle."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "Les aménagements",
          "deux": true,
          "items": [
            {
              "titre": "-d, -t, -n après consonne",
              "texte": "on intercale un **e**&nbsp;: <i>du arbeitest, ihr findet</i>"
            },
            {
              "titre": "-s, -ß, -z, -x",
              "texte": "le <i>-st</i> perd son s&nbsp;: <i>du heißt, du sitzt</i>"
            },
            {
              "titre": "-el",
              "texte": "le e tombe à <i>ich</i>&nbsp;: <i>ich sammle</i>"
            },
            {
              "titre": "Verbes forts (du, er)",
              "texte": "<i>gibst, siehst, fährst, läufst</i>"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>du heißst</i> → <i>du **heißt**.</i>",
            "<i>du fahrst</i> → <i>du **fährst**</i>, <i>er **fährt**.</i>",
            "« Je suis en train de jouer » = <i>Ich spiele</i>, **pas** de forme progressive.",
            "<i>wir gibt</i> → <i>wir **geben**</i>&nbsp;: la voyelle revient au pluriel."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>Du ___ (arbeiten) viel.</i>",
            "<i>Er ___ (lesen) ein Buch.</i>",
            "<i>Du ___ (heißen) Lea.</i>"
          ],
          "reponses": "1) arbeitest 2) liest 3) heißt"
        }
      ]
    }
  ]
}
