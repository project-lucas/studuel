{
  "titre": "Exprimer le futur",
  "titreSurligne": "futur",
  "accroche": "Quatre façons de parler de demain.",
  "bonus": "**will** (décidé à l’instant) · **be going to** (intention) · **BE + -ING** (rendez-vous)",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/4e/anglais/exprimer-le-futur.webp",
