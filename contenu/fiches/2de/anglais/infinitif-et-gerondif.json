{
  "titre": "Infinitif et gérondif",
  "titreSurligne": "gérondif",
  "accroche": "To do ou doing : le verbe choisit.",
  "bonus": "Après une **préposition** : toujours **-ING**",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/2de/anglais/infinitif-et-gerondif.webp",
