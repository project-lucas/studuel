            ["**-ose**", "affection non inflammatoire"],
            ["**-algie**, **-ectomie**", "douleur, ablation"],
            ["**-scopie**, **-graphie**", "examen visuel, image"],
            ["**dys-**, **a-/an-**", "difficulté, absence"]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
