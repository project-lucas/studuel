  },
  "marcel": "Depuis, pendant…\nUn mot pour chaque&nbsp;!",
  "rangs": [
    {
      "blocs": [
        {
          "type": "tableau",
          "numero": 1,
          "titre": "Le tableau qui tranche",
          "entetes": [
            "Mot",
            "Il introduit",
            "Le temps",
            "Exemple"
          ],
          "lignes": [
            [
              "**for**",
              "une **durée**",
              "present perfect",
              "<i>for six years</i>"
            ],
            [
              "**since**",
              "un **point de départ**",
              "present perfect",
              "<i>since 2019</i>"
            ],
            [
              "**ago**",
              "un point compté à rebours",
              "**prétérit**",
              "<i>two years ago</i>"
            ],
            [
              "**during**",
              "un **nom**",
              "variable",
              "<i>during the meeting</i>"
            ],
            [
              "**while**",
              "une **proposition**",
              "variable",
              "<i>while we were talking</i>"
            ]
          ]
        }
      ]
    },
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 2,
          "titre": "AGO",
          "lignes": [
            "durée + **ago**"
          ],
          "petite": true,
          "regle": "Il se place **après** la durée et appelle le **prétérit** : un fait daté n’est jamais au present perfect.",
          "note": "I met her three days ago"
        },
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Les autres repères",
          "colonnes": 2,
          "cartes": [
            {
              "titre": "by / until",
              "texte": "**by Friday** : d’ici, au plus tard. **until Friday** : jusqu’à."
            },
            {
              "titre": "in / within",
              "texte": "**in two weeks** : dans deux semaines. **within a week** : d’ici moins d’une semaine."
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "During ou while&nbsp;?",
          "oui": {
            "titre": "Préposition + nom",
            "texte": "<i>**during** the meeting</i> — il faut un nom."
          },
          "non": {
            "titre": "Conjonction + verbe",
            "texte": "<i>**while** we were talking</i> — sujet + verbe."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>I have lived here ___ 2019.</i> → **since**&nbsp;: 2019 est un point de départ."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Durée ou départ&nbsp;?",
              "texte": "Une durée (six years) → **for**. Une date, un point → **since**."
            },
            {
              "titre": "Date dans le passé&nbsp;?",
              "texte": "Compté à rebours → **ago** et **prétérit**."
            },
            {
              "titre": "Nom ou verbe&nbsp;?",
              "texte": "Un **nom** → **during**. Un sujet + verbe → **while**."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "À retenir",
          "deux": true,
          "items": [
            {
              "titre": "for et since",
              "texte": "ils disent la même chose autrement, et appellent le present perfect&nbsp;: ça **dure encore**."
            },
            {
              "titre": "depuis (fr.)",
              "texte": "se traduit par **for** ou **since**, jamais <i>ago</i>."
            },
            {
              "titre": "pendant (fr.)",
              "texte": "**for** + durée, **during** + nom."
            },
            {
              "titre": "ago",
              "texte": "jamais devant la durée&nbsp;: <i>two years ago</i>."
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>I live here since 2019</i> → <i>I **have lived** here since 2019.</i>",
            "<i>I have met her three days ago</i> → <i>I **met** her three days ago.</i>",
            "<i>during we were talking</i> → <i>**while** we were talking</i>.",
            "<i>ago two years</i> → <i>two years **ago**</i>."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>I have lived here ___ six years.</i> (for / since)",
            "<i>I met her three days ___.</i>",
            "<i>She called ___ the meeting.</i> (during / while)"
          ],
          "reponses": "1) for 2) ago 3) during"
        }
      ]
    }
  ]
}
