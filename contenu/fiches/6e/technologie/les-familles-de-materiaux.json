{
  "titre": "Familles de matériaux",
  "titreSurligne": "matériaux",
  "accroche": "Chaque matière a ses qualités.",
  "bonus": "**Métaux · Plastiques · Céramiques et verres · Organiques · Composites**",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/6e/technologie/les-familles-de-materiaux.webp",
