        {
          "type": "pieges",
          "items": [
            "<i>taller that me</i> → <i>taller **than** me</i>",
            "<i>more big</i> → <i>**bigger**</i> ; <i>gooder</i> → <i>**better**</i>",
            "<i>as tall than</i> → <i>as tall **as**</i>",
