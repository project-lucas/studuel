{
  "titre": "La capacité",
  "titreSurligne": "capacité",
  "accroche": "Can, could, be able to.",
  "bonus": "**can** (présent) · **could** (passé général) · **was able to** (une fois) · **will be able to**",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/5e/anglais/expression-de-la-modalite-la-capacite.webp",
    "prompt": "a glossy violet flexed arm with a golden star on the muscle, sparkles, same art style as the reference icons, magenta background"
  },
  "marcel": "Je sais nager&nbsp;:\nI can swim&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "La forme",
          "lignes": [
            "**can** + base verbale"
          ],
          "petite": true,
          "regle": "**can** est invariable&nbsp;: pas de -s, pas de to. Négation <i>can’t</i> (ou <i>cannot</i>), question <i>Can you…?</i>",
          "note": "I can swim"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Quelle forme&nbsp;?",
          "entetes": [
            "La situation",
            "La forme",
            "L’exemple"
          ],
          "lignes": [
            [
              "Capacité présente",
              "**can**",
              "<i>She can speak three languages.</i>"
            ],
            [
              "Capacité passée générale",
              "**could**",
              "<i>I could swim at five.</i>"
            ],
            [
              "Réussite d’une fois (passé)",
              "**was / were able to**",
              "<i>He was able to open the door.</i>"
            ],
            [
              "Futur",
              "**will be able to**",
              "<i>I’ll be able to drive.</i>"
            ],
            [
              "Demande polie",
              "**could**",
              "<i>Could you help me?</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Trois usages de can",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "Savoir faire",
              "texte": "<i>I **can** swim.</i> (je sais nager)"
            },
            {
              "titre": "Être en mesure",
              "texte": "<i>I **can** help you.</i> (je peux t’aider)"
            },
            {
              "titre": "Percevoir",
              "texte": "<i>I **can** see the sea.</i> (je vois la mer)"
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Passé&nbsp;: could ou was able to&nbsp;?",
          "oui": {
            "titre": "Général = could",
            "texte": "<i>When I was five, I **could** swim.</i>"
          },
          "non": {
            "titre": "Une fois = was able to",
            "texte": "<i>Yesterday, I **was able to** finish.</i> — pas <i>could finish</i>."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>Next year I ___ drive.</i> → **will be able to**&nbsp;: can n’a pas de futur."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "Choisir la forme",
          "etapes": [
            {
              "titre": "Quand&nbsp;?",
              "texte": "Présent → **can**. Passé → étape 2. Futur → **will be able to**."
            },
            {
              "titre": "Général ou ponctuel&nbsp;?",
              "texte": "Général → **could**. Réussi une fois → **was able to**."
            },
            {
              "titre": "Poli&nbsp;?",
              "texte": "Une demande → **Could you…?**"
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "Be able to partout",
          "deux": true,
          "items": [
            {
              "titre": "Futur",
              "texte": "<i>I will be able to drive.</i>"
            },
            {
              "titre": "Present perfect",
              "texte": "<i>I have been able to finish.</i>"
            },
            {
              "titre": "Après un modal",
              "texte": "<i>You might be able to come.</i>"
            },
            {
              "titre": "Négation",
              "texte": "<i>can’t</i> / <i>couldn’t</i> / <i>wasn’t able to</i>"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>She cans swim</i> → <i>She **can** swim</i>.",
            "<i>I can to swim</i> → <i>I can swim</i> (pas de to).",
            "<i>I will can</i> → <i>I will **be able to**</i>.",
            "<i>I can see</i> = « je vois », pas « je peux voir »."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "Traduis&nbsp;: «&nbsp;Elle sait nager.&nbsp;»",
            "<i>Last night, he ___ (réussir à) fix it.</i>",
            "Futur de <i>I can drive</i>&nbsp;?"
          ],
          "reponses": "1) She can swim 2) was able to 3) I will be able to drive"
        }
      ]
    }
  ]
}
