            ["**mit**", "<i>mit dem Bus</i>", "en bus"],
            ["**nach**", "<i>nach dem Film</i>", "après le film"],
            ["**seit**", "<i>seit einem Jahr</i>", "depuis un an"],
            ["**von**", "<i>ein Brief von meinem Freund</i>", "une lettre de mon ami"],
            ["**zu**", "<i>zum Arzt</i>", "chez le médecin"]
