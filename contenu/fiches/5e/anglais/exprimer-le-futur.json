{
  "titre": "Exprimer le futur",
  "titreSurligne": "futur",
  "accroche": "Will, going to ou présent en -ING.",
  "bonus": "**will** décision · **be going to** intention · **BE + -ING** rendez-vous",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/5e/anglais/exprimer-le-futur.webp",
    "prompt": "a glossy violet rocket flying up with a golden flame and small golden sparkles, same art style as the reference icons, magenta background"
  },
  "marcel": "Demain&nbsp;?\nChoisis ta forme&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "Will",
          "lignes": [
            "**will** + verbe"
          ],
          "petite": true,
          "regle": "**will** dit une décision prise **à l’instant**, une prédiction, une promesse. Négation&nbsp;: **won’t**.",
          "note": "décision immédiate"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Les quatre formes",
          "entetes": [
            "La forme",
            "Elle dit…",
            "L’exemple"
          ],
          "lignes": [
            [
              "**will**",
              "décision, promesse",
              "<i>The phone rings — I’ll get it!</i>"
            ],
            [
              "**be going to**",
              "intention, indice",
              "<i>Look at those clouds! It’s going to rain.</i>"
            ],
            [
              "**BE + -ING**",
              "rendez-vous fixé",
              "<i>I am meeting Sarah at six.</i>"
            ],
            [
              "présent simple",
              "horaire officiel",
              "<i>The train leaves at 7.15.</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Degré de préparation",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "Pas préparé",
              "texte": "**will** : on décide en parlant."
            },
            {
              "titre": "Déjà prévu",
              "texte": "**going to** : j’en ai l’intention."
            },
            {
              "titre": "Organisé",
              "texte": "**BE + -ING** : date et lieu fixés."
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Après when, as soon as…",
          "oui": {
            "titre": "Présent simple",
            "texte": "<i>I’ll call you when I **arrive**.</i> — présent après when."
          },
          "non": {
            "titre": "Pas de will",
            "texte": "<i>when I will arrive</i> est faux."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>I’ll text you as soon as I ___ (get) home.</i> → **get**."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Décision à l’instant&nbsp;?",
              "texte": "→ **will**."
            },
            {
              "titre": "Intention ou indice&nbsp;?",
              "texte": "→ **be going to**."
            },
            {
              "titre": "Rendez-vous fixé&nbsp;?",
              "texte": "→ **BE + -ING**."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "À retenir",
          "deux": true,
          "items": [
            {
              "titre": "Conjonctions",
              "texte": "when, as soon as, before, after, until + présent"
            },
            {
              "titre": "won’t",
              "texte": "négation de will"
            },
            {
              "titre": "was going to",
              "texte": "j’avais l’intention&nbsp;: <i>I was going to call you.</i>"
            },
            {
              "titre": "think + will",
              "texte": "<i>I think it will be sunny.</i>"
            },
            {
              "titre": "going to",
              "texte": "prévu&nbsp;: <i>I’m going to study.</i>"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>when I will come</i> → <i>when I **come**.</i>",
            "<i>I will to go</i> → <i>I will **go**.</i>",
            "<i>It will rain</i> avec des nuages noirs : mieux <i>It’s **going to** rain.</i>",
            "<i>I go tomorrow</i> pour un projet perso : <i>I’m going.</i>",
            "<i>I will meeting</i> → <i>I am **meeting**.</i>"
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>Look at the clouds! It ___ rain.</i>",
            "<i>I’ll call you when I ___ (arrive).</i>",
            "Négation de <i>will</i>&nbsp;: ___"
          ],
          "reponses": "1) is going to 2) arrive 3) won’t"
        }
      ]
    }
  ]
}
