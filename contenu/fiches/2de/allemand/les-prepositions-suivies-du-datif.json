        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Repère le mot",
              "texte": "<i>aus, bei, mit, nach, seit, von, zu</i> → **datif**."
            },
            {
              "titre": "Mets l’article",
              "texte": "<i>dem</i> (m. et n.), <i>der</i> (f.), <i>den + -n</i> (pluriel)."
            },
            {
              "titre": "Contracte",
              "texte": "<i>bei dem → **beim**</i> · <i>von dem → **vom**</i> · <i>zu dem → **zum**</i> · <i>zu der → **zur**</i>."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
