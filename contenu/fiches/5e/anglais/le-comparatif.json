  "marcel": "Plus grand que…\nTaller than&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "Supériorité",
          "lignes": [
            "adj. + **-er** than",
            "**more** adj. + than"
          ],
          "petite": true,
          "regle": "Adjectif **court** → **-er**. Adjectif **long** → **more**.",
          "note": "tall → taller"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Les trois comparatifs",
          "entetes": [
            "Sens",
            "Forme",
            "Exemple"
          ],
          "lignes": [
            [
              "Supériorité",
              "<i>-er than</i> / <i>more … than</i>",
              "<i>She is **taller than** me.</i>"
            ],
            [
              "Infériorité",
              "<i>less … than</i>",
              "<i>It is **less expensive than** that.</i>"
            ],
            [
              "Égalité",
              "<i>as … as</i>",
              "<i>She is **as tall as** her brother.</i>"
            ],
            [
              "Égalité négative",
              "<i>not as … as</i>",
              "<i>He is **not as fast as** you.</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Les formes à retenir",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "Petits changements",
              "texte": "<i>big → big**ger**</i> (consonne doublée)<br><i>happy → happ**ier**</i> (y → i)"
            },
            {
              "titre": "Irréguliers",
              "texte": "<i>good → **better**</i><br><i>bad → **worse**</i><br><i>far → **farther / further**</i>"
            },
            {
              "titre": "Avec un nom",
              "texte": "Dénombrable&nbsp;: <i>**fewer** books</i><br>Indénombrable&nbsp;: <i>**less** money</i>"
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Une seule marque",
          "oui": {
            "titre": "-er ou more",
            "texte": "<i>taller than</i> / <i>**more** expensive than</i>"
          },
          "non": {
            "titre": "Les deux à la fois",
            "texte": "<i>**more** taller than</i> / <i>more better</i>"
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>This film is ___ (interesting) than that one.</i> → **more interesting**."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Compte les syllabes",
              "texte": "Une syllabe (ou <i>-y</i>) → court. Deux ou plus → long."
            },
            {
              "titre": "Choisis la marque",
              "texte": "Court → **-er**. Long → **more**. Irrégulier → par cœur."
            },
            {
              "titre": "Ajoute than",
              "texte": "<i>…**than** + l’autre élément.</i>"
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "Deux structures utiles",
          "deux": true,
          "items": [
            {
              "titre": "De plus en plus",
              "texte": "<i>bigger and bigger</i>, <i>more and more expensive</i>"
            },
            {
              "titre": "Plus… plus…",
              "texte": "<i>The more you practise, the better you get.</i>"
            },
            {
              "titre": "Égalité",
              "texte": "<i>as tall **as**</i> (deux fois as)"
            },
            {
              "titre": "Moins",
              "texte": "<i>less … than</i> + adjectif long"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>more taller</i> → <i>tall**er**</i>",
            "<i>good than</i> → <i>**better** than</i>",
            "<i>taller that</i> → <i>taller **than**</i>",
            "<i>less books</i> → <i>**fewer** books</i> (dénombrable)."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>He is ___ (tall) than me.</i>",
            "<i>This bag is ___ (expensive) than that one.</i>",
            "<i>My cake is ___ (good) than yours.</i>"
          ],
          "reponses": "1) taller 2) more expensive 3) better"
        }
      ]
    }
  ]
