            {
              "titre": "seit + présent",
              "texte": "<i>Ich lerne seit drei Jahren Deutsch.</i>"
            },
            {
              "titre": "nach Hause",
              "texte": "rentrer à la maison (mouvement)"
            },
            {
              "titre": "zu Hause",
              "texte": "être à la maison (sans mouvement)"
            }
