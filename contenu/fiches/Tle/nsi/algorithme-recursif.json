        {
          "type": "definitions",
          "numero": 1,
          "titre": "Les deux composants",
          "items": [
            {
              "terme": "Cas de base",
              "definition": "un cas résolu **sans appel**&nbsp;: il arrête la récursion"
            },
            {
              "terme": "Appel récursif",
              "definition": "la fonction se rappelle sur un cas **strictement plus petit**"
            },
            {
              "terme": "Pile d’appels",
              "definition": "les appels **s’empilent** puis se résolvent en remontant"
            },
            {
              "terme": "Terminaison",
              "definition": "l’argument **décroît** à chaque appel jusqu’au cas de base"
            }
          ]
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Factorielle",
          "entetes": [
            "Python",
            "Rôle"
          ],
          "lignes": [
            [
              "<i>def fact(n):</i>",
              "n entier ≥ 0"
            ],
            [
              "<i>&nbsp;&nbsp;if n == 0:</i>",
              "**cas de base**"
            ],
            [
              "<i>&nbsp;&nbsp;&nbsp;&nbsp;return 1</i>",
              "0! = 1"
            ],
            [
              "<i>&nbsp;&nbsp;return n * fact(n - 1)</i>",
              "**appel** récursif"
            ],
            [
              "<i>fact(3)</i>",
              "3 × 2 × 1 = **6**"
            ],
            [
              "<i>fact(4)</i>",
              "4 × 6 = **24**"
            ],
            [
              "<i>fact(5)</i>",
              "5 × 24 = **120**"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
