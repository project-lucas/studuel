{
  "titre": "La capacité",
  "titreSurligne": "capacité",
  "accroche": "Can, could, be able to&nbsp;: savoir faire.",
  "bonus": "**can** présent · **could** passé général · **was able to** réussite ponctuelle · **will be able to** futur",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/4e/anglais/expression-de-la-modalite-la-capacite.webp",
    "prompt": "a glossy violet flexing arm muscle with a golden star badge and a small golden trophy, sparkles, same art style as the reference icons, magenta background"
  },
  "marcel": "Je sais nager&nbsp;!\nI can swim&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "Can",
          "lignes": [
            "**can** + base verbale"
          ],
          "petite": true,
          "regle": "Invariable&nbsp;: jamais de -s, jamais de <i>to</i> derrière. Négation&nbsp;: **can’t**. Question&nbsp;: <i>**Can** you swim?</i>",
          "note": "she can swim (pas cans)"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Quelle forme&nbsp;?",
          "entetes": [
            "La situation",
            "La forme",
            "L’exemple"
          ],
          "lignes": [
            [
              "Capacité présente",
              "**can**",
              "<i>I **can** swim.</i>"
            ],
            [
              "Capacité passée générale",
              "**could**",
              "<i>I **could** swim at five.</i>"
            ],
            [
              "Réussite ponctuelle",
              "**was / were able to**",
              "<i>He **was able to** open it.</i>"
            ],
            [
              "Capacité future",
              "**will be able to**",
              "<i>I **will be able to** drive.</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Autres emplois",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "Les sens",
              "texte": "Avec <i>see, hear, feel</i>&nbsp;: <i>I **can** see the sea.</i> (Je vois la mer.)"
            },
            {
              "titre": "La politesse",
              "texte": "<i>**Could** you help me, please?</i> — plus poli que <i>can</i>."
            },
            {
              "titre": "Les autres temps",
              "texte": "<i>I **have been able to** finish.</i> / <i>You might **be able to** come.</i>"
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Could ou was able to&nbsp;?",
          "oui": {
            "titre": "Réussite ponctuelle",
            "texte": "<i>He **was able to** open the door.</i> (Il y est arrivé, cette fois-là.)"
          },
          "non": {
            "titre": "Could pour une fois",
            "texte": "<i>He **could** open the door (hier, une seule fois).</i> — on dit <i>was able to</i>."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>Next year I ___ drive.</i> → **will be able to**&nbsp;: <i>can</i> n’a pas de futur."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Quand&nbsp;?",
              "texte": "Présent → **can**. Futur → **will be able to**."
            },
            {
              "titre": "Passé&nbsp;?",
              "texte": "Capacité générale → **could**."
            },
            {
              "titre": "Une seule fois&nbsp;?",
              "texte": "Réussite précise → **was / were able to**."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "À retenir",
          "deux": true,
          "items": [
            {
              "titre": "cannot / can’t",
              "texte": "la négation de <i>can</i>"
            },
            {
              "titre": "managed to",
              "texte": "= <i>was able to</i> : il y est parvenu"
            },
            {
              "titre": "Could I…? Can I…?",
              "texte": "demandes, <i>could</i> plus poli"
            },
            {
              "titre": "might be able to",
              "texte": "après un autre modal"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>She cans swim</i> → <i>She **can** swim.</i>",
            "<i>I can to swim</i> → <i>I can swim.</i>",
            "<i>I will can</i> → <i>I will **be able to**.</i>",
            "<i>I can see the sea</i> : en français « je vois la mer », sans « pouvoir »."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "texte",
          "numero": 7,
          "titre": "En situation",
          "paragraphes": [
            "<i>I **can** swim now. At five, I **couldn’t**. Next summer I **will be able to** dive.</i> (Je sais nager. À cinq ans, non. L’été prochain je saurai plonger.)"
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>When I was five, I ___ swim.</i>",
            "<i>Tomorrow, I ___ finish.</i> (être capable)",
            "<i>She ___ speak Spanish.</i> (can / cans)"
          ],
          "reponses": "1) could 2) will be able to 3) can"
        }
      ]
    }
  ]
}
