    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Qui agit&nbsp;?",
              "texte": "C’est le **sujet** : I, you, he, she, it, we, they."
            },
            {
              "titre": "Qui reçoit&nbsp;?",
              "texte": "C’est le **complément** : me, you, him, her, it, us, them."
            },
            {
              "titre": "Toujours un sujet",
              "texte": "Même pour la pluie : <i>It rains.</i>"
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "L’ordre de la phrase",
          "deux": true,
          "items": [
            {
              "titre": "Sujet",
              "texte": "<i>**We** love pizza.</i>"
            },
            {
              "titre": "Verbe",
              "texte": "<i>We **love** pizza.</i>"
            },
            {
              "titre": "Complément",
              "texte": "<i>We love **it**.</i>"
            },
            {
              "titre": "À retenir",
              "texte": "L’ordre ne change presque jamais : la **place** dit le rôle du mot."
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>Is raining</i> → <i>**It** is raining.</i>",
            "<i>Me like pizza</i> → <i>**I** like pizza.</i>",
            "<i>i am happy</i> → <i>**I** am happy</i> (majuscule).",
            "<i>Give it to he</i> → <i>Give it to **him**.</i>"
          ]
        }
      ]
    },
