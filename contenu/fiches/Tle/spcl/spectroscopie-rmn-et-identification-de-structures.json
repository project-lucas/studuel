            { "titre": "Vérifier", "texte": "multiplicité (n + 1), puis **δ** avec la table" },
            { "titre": "Confirmer", "texte": "**IR**&nbsp;: C=O ≈ 1 700 cm⁻¹, O–H large ≈ 3 300" }
          ]
        }
      ]
    },
