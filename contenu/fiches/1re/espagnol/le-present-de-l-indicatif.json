{
  "titre": "Le présent",
  "titreSurligne": "présent",
  "accroche": "Le temps le plus employé, le plus irrégulier.",
  "bonus": "**-o, -as, -a, -amos, -áis, -an** · **-o, -es, -e, -emos, -éis, -en** · **-o, -es, -e, -imos, -ís, -en**",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/1re/espagnol/le-present-de-l-indicatif.webp",
