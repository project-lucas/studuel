{
  "titre": "Analyser un document",
  "titreSurligne": "document",
  "accroche": "Lire les chiffres, argumenter.",
  "bonus": "Tle : épreuve écrite de **3 h**, coefficient **16** · 6 pts connaissances + 14 pts documents",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/1re/sciences-sanitaires-sociales/methode-analyser-un-document-sanitaire-et-social.webp",
    "prompt": "a glossy violet document with a golden pie chart and a golden magnifying glass, sparkles, same art style as the reference icons, on magenta background, no text"
  },
  "marcel": "Lis bien,\nargumente mieux !",
  "rangs": [
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "definitions",
          "numero": 1,
          "titre": "Les mots clés",
          "items": [
            { "terme": "Taux d’évolution", "definition": "(arrivée − départ) / départ × 100" },
            { "terme": "Coefficient multiplicateur", "definition": "valeur d’**arrivée / départ**" },
            { "terme": "Part", "definition": "partie / total × 100" },
            { "terme": "Écart en points", "definition": "différence entre **deux pourcentages**" }
          ]
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Calculer pour comparer",
          "entetes": ["Calcul", "Exemple"],
          "lignes": [
            ["**Évolution**", "200 → 250 : **+ 25 %**"],
            ["**Coefficient**", "250 / 200 = **1,25**"],
            ["**Part**", "30 sur 120 = **25 %**"],
            ["**Écart**", "12 % → 15 % : **+ 3 points**"]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 3,
          "titre": "Lire un document statistique",
          "etapes": [
            { "titre": "Identifier", "texte": "titre, **source**, date, champ, unité" },
            { "titre": "Dégager", "texte": "la **tendance**, puis les écarts entre groupes ou années" },
            { "titre": "Expliquer", "texte": "avec le **cours** : déterminants, inégalités, protection sociale" }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 262px",
      "blocs": [
        {
          "type": "cartes",
          "numero": 4,
          "titre": "Répondre à une question",
          "colonnes": 1,
          "cartes": [
            { "titre": "Définir", "texte": "les **notions** du sujet." },
            { "titre": "Organiser", "texte": "un paragraphe par **idée**." },
            { "titre": "Illustrer", "texte": "dispositif, loi, acteur, **chiffre**." }
          ]
        },
        {
          "type": "postit",
          "titre": "Argumenter avec des documents",
          "donnees": "Intro courte, puis par paragraphe :",
          "calcul": "idée → document cité → explication",
          "aparte": "puis conclusion qui répond",
          "resultat": "[[connaissances du cours]]"
        }
      ]
    },
    {
      "colonnes": "1fr 296px",
      "blocs": [
        {
          "type": "copie",
          "titre": "Sur ta copie",
          "lignes": [
            { "texte": "Selon l’INSEE, en 2023, 15 % des personnes…", "quoi": "lire un chiffre" },
            { "texte": "Le taux passe de 12 % à 15 % : il augmente de 3 points.", "quoi": "comparer" },
            { "texte": "Ce document montre que… car selon le cours, …", "quoi": "expliquer" }
          ],
          "pied": "Rédige des ==phrases== liées par des connecteurs, pas une liste."
        },
        {
          "type": "pieges",
          "items": [
            "Confondre « + 3 **points** » et « + 25 **%** ».",
            "**Paraphraser** le document.",
            "Citer un chiffre **sans source ni date**.",
            "Confondre **CAF**, CPAM, France Travail et département."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "Taux d’évolution de **200 à 250** ?",
            "De **12 % à 15 %** : quel écart ?",
            "Que faut-il **mobiliser** en plus des documents ?"
          ],
          "reponses": "1) + 25 % · 2) + 3 points · 3) ses connaissances du cours"
        }
      ]
    }
  ]
}
