          "lignes": ["valeur finale = valeur initiale × CM", "taux = {finale − initiale/initiale}"],
          "regle": "**Hausse de t %** : CM = 1 + {t/100}. **Baisse de t %** : CM = 1 − {t/100}. Une proportion, c’est ==partie ÷ tout==.",
          "note": "Évolutions successives : on multiplie&nbsp;!"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Du % au coefficient",
          "entetes": ["Évolution", "CM"],
          "lignes": [
            ["+ 5 %", "× 1,05"],
            ["− 30 %", "× 0,7"],
            ["+ 100 %", "× 2"],
            ["indice 112", "+ 12 % depuis la base 100"]
