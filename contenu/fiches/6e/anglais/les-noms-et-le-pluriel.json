{
  "titre": "Les noms et le pluriel",
  "titreSurligne": "pluriel",
  "accroche": "Un -s à la fin… sauf quand il ne faut pas.",
  "bonus": "**-s** · **-es** (bus, box, watch) · **-ies** (city) · **-ves** (knife) · men, women, children",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/6e/anglais/les-noms-et-le-pluriel.webp",
