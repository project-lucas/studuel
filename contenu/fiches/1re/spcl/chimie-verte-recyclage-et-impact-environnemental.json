          },
          "non": {
            "titre": "Rendement trompeur",
            "texte": "95 % de rendement avec un solvant **toxique** et beaucoup de déchets."
          },
          "essai": {
            "texte": "Un bon rendement ne suffit pas&nbsp;: compte aussi l’<i>économie d’atomes</i>, la toxicité et l’énergie."
