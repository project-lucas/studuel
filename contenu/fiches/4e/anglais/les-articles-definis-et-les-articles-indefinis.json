        {
          "type": "tableau",
          "numero": 2,
          "titre": "Trois choix devant un nom",
          "entetes": ["L’article", "Quand", "L’exemple"],
          "lignes": [
            ["**a / an**", "un élément pas encore identifié", "<i>I bought **a** car.</i> (J’ai acheté une voiture.)"],
            ["**the**", "déjà mentionné, unique", "<i>**The** car is red. **The** sun is hot.</i>"],
            ["**zéro**", "pluriel ou indénombrable en général", "<i>I like dogs. Water is essential.</i>"]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
