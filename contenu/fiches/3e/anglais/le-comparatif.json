          "lignes": [
            [
              "Supériorité",
              "-er than / more … than",
              "<i>taller than</i>"
            ],
            [
              "Infériorité",
              "less … than",
              "<i>less expensive than</i>"
            ],
            [
              "Égalité",
              "as … as",
              "<i>as tall as her brother</i>"
            ],
            [
              "Égalité négative",
              "not as … as",
              "<i>not as fast as you</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "L’orthographe de -er",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "Adjectif en -e",
              "texte": "On ajoute seulement -r&nbsp;: nice → nic**er**."
            },
            {
              "titre": "Consonne-voyelle-consonne",
              "texte": "Consonne doublée&nbsp;: big → big**ger**, hot → hot**ter**."
            },
            {
              "titre": "Adjectif en -y",
              "texte": "y devient i&nbsp;: happy → happ**ier**, easy → eas**ier**."
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Les irréguliers",
          "oui": {
            "titre": "Par cœur",
            "texte": "good → **better** · bad → **worse** · far → **farther / further** · little → **less** · much / many → **more**"
          },
          "non": {
            "titre": "Inventés",
            "texte": "<i>gooder, more good, more big, more taller</i> — ça n’existe pas."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>This test is ___ (easy) than the last one.</i> → **easier**&nbsp;: y devient i&nbsp;!"
