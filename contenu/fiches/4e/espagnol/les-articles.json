{
  "titre": "Les articles",
  "titreSurligne": "articles",
  "accroche": "Un article de plus que le français : lo.",
  "bonus": "**el / la / los / las** · **un / una** · **al, del** · **el agua** · **lo** + adjectif",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/4e/espagnol/les-articles.webp",
    "prompt": "a glossy violet block letter tile and a golden block letter tile side by side with a small golden neutral star above, tiny golden sparkles, same art style as the reference icons, magenta background"
  },
  "marcel": "El, un, lo&nbsp;:\ntrois séries&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "Le neutre lo",
          "lignes": [
            "**lo** + adjectif"
          ],
          "petite": true,
          "regle": "Il ne précède **jamais** un nom, mais un adjectif, un adverbe ou un relatif&nbsp;: <i>lo importante</i>, <i>lo mejor</i>, <i>lo que dices</i>.",
          "note": "n’existe pas en français"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Les formes",
          "entetes": [
            "Type",
            "Masculin",
            "Féminin"
          ],
          "lignes": [
            [
              "Défini singulier",
              "<i>el</i>",
              "<i>la</i>"
            ],
            [
              "Défini pluriel",
              "<i>los</i>",
              "<i>las</i>"
            ],
            [
              "Indéfini singulier",
              "<i>un</i>",
              "<i>una</i>"
            ],
            [
              "Indéfini pluriel (« quelques »)",
              "<i>unos</i>",
              "<i>unas</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Trois règles à tenir",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "Contractions",
              "texte": "Deux seulement&nbsp;: a + el = **al** (<i>Voy al cine</i>), de + el = **del** (<i>la casa del profesor</i>). Pas devant un nom propre&nbsp;: <i>Voy a El Escorial</i>."
            },
            {
              "titre": "El devant un féminin",
              "texte": "Féminin singulier à **a- / ha- tonique**&nbsp;: <i>el agua fría</i>, <i>un águila</i> — mais <i>las aguas</i>."
            },
            {
              "titre": "Sans article",
              "texte": "Profession ou nationalité en attribut&nbsp;: <i>Es profesor</i> (mais <i>Es un profesor excelente</i>). Devant <i>otro</i>&nbsp;: <i>otro día</i>."
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "El ou la devant « a- »&nbsp;?",
          "oui": {
            "titre": "A- tonique : el",
            "texte": "<i>el agua</i>, <i>el aula</i>, <i>el hambre</i>, <i>el alma</i> — le nom reste féminin (<i>el agua fría</i>)."
          },
          "non": {
            "titre": "A- atone : la",
            "texte": "<i>la avenida</i>, <i>la harina</i> — le test est l’**accent tonique**, pas la lettre."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>___ águila blanca</i> (el / la) → **el**&nbsp;: <i>el águila blanca</i> (adjectif au féminin)."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Défini ou indéfini&nbsp;?",
              "texte": "Connu → el / la. Nouveau → un / una."
            },
            {
              "titre": "Un a- tonique&nbsp;?",
              "texte": "Féminin singulier → <i>el / un</i>, adjectif au féminin."
            },
            {
              "titre": "Neutre&nbsp;?",
              "texte": "Qualité abstraite → <i>lo</i> + adjectif."
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "texte",
          "numero": "★",
          "titre": "Le coup d’œil",
          "paragraphes": [
            "Devant un nom féminin qui commence par **a-** ou **ha-** accentué, pense **el agua, el hambre** — et garde le féminin pour l’adjectif : <i>el agua fría</i>."
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "Les emplois de lo",
          "deux": true,
          "items": [
            {
              "titre": "lo + adjectif",
              "texte": "<i>lo importante, lo mejor, lo difícil</i>"
            },
            {
              "titre": "lo que",
              "texte": "« ce que »&nbsp;: <i>No entiendo lo que dices.</i>"
            },
            {
              "titre": "lo + adj. + que",
              "texte": "intensité&nbsp;: <i>No sabes lo cansado que estoy.</i>"
            },
            {
              "titre": "unos / unas",
              "texte": "« quelques »&nbsp;: <i>unos amigos</i>"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>La agua</i> → <i>**El** agua</i> (a- tonique) — mais <i>**las** aguas</i>.",
            "<i>Voy a el cine</i> → <i>Voy **al** cine.</i>",
            "<i>Es un profesor</i> sans adjectif → <i>Es profesor.</i>",
            "<i>lo libro</i> : **lo** ne précède jamais un nom."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>___ agua fría</i> (el / la) ; au pluriel&nbsp;?",
            "<i>Voy a + el cine</i> → ?",
            "<i>No entiendo ___ que dices.</i> (lo / el)"
          ],
          "reponses": "1) el agua fría ; las aguas 2) Voy al cine 3) lo"
        }
      ]
    }
  ]
}
