        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Hoy ou ayer&nbsp;?",
          "oui": {
            "titre": "Passé composé = raccroché",
            "texte": "<i>Hoy **he ido** al cine.</i> · <i>Este año **he viajado** mucho.</i>"
          },
          "non": {
            "titre": "Passé simple = coupé",
            "texte": "<i>Ayer **fui** al cine.</i> · <i>El año pasado **viajé** mucho.</i>"
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>Este año (yo) ___ (leer) tres novelas.</i> → **he leído**."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "Choisir et former",
          "etapes": [
            {
              "titre": "Lis le marqueur",
              "texte": "<i>este / esta</i>, <i>ya</i>, <i>nunca</i> → passé composé. <i>Ayer</i>, une date → passé simple."
            },
            {
              "titre": "Conjugue « haber »",
              "texte": "<i>he, has, ha, hemos, habéis, han</i>."
            },
            {
              "titre": "Ajoute le participe",
              "texte": "<i>-ado</i> (-ar), <i>-ido</i> (-er, -ir). **Invariable**."
            },
            {
              "titre": "Rien au milieu",
              "texte": "<i>Nunca he visto</i> : l’adverbe passe devant l’auxiliaire."
            }
          ]
        }
      ]
