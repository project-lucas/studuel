{
  "titre": "Le présent",
  "titreSurligne": "présent",
  "accroche": "Trois conjugaisons, des irréguliers.",
  "bonus": "**-o · -as · -a · -amos · -áis · -an** · **-o · -es · -e · -emos · -éis · -en**",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/2de/espagnol/le-present-de-l-indicatif.webp",
