{
  "titre": "Exprimer l’habitude",
  "titreSurligne": "habitude",
  "accroche": "Used to, would, be used to.",
  "bonus": "**used to** + base · **would** + base · **be used to** + -ING",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/Tle/anglais/exprimer-l-habitude.webp",
    "prompt": "a glossy violet circular arrow loop around a golden alarm clock, tiny golden sparkles, same art style as the reference icons, magenta background"
  },
  "marcel": "Avant, je faisais.\nMaintenant, j’ai l’habitude&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "Les trois structures",
          "lignes": [
            "**used to** + base",
            "**be used to** + -ING"
          ],
          "petite": true,
          "regle": "Les deux premières parlent du **passé** ; la troisième d’un état **actuel**. Elles ne se ressemblent que par les lettres.",
          "note": "to = préposition"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Qui dit quoi&nbsp;?",
          "entetes": [
            "Structure",
            "Sens",
            "Exemple"
          ],
          "lignes": [
            [
              "used to + base",
              "habitude ou état passés, révolus",
              "<i>I **used to smoke**.</i> (je ne fume plus)"
            ],
            [
              "would + base",
              "action répétée, dans un récit",
              "<i>Every summer, we **would go** to the sea.</i>"
            ],
            [
              "be used to + -ING",
              "être habitué à",
              "<i>I’m **used to getting up** early.</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": "★",
          "titre": "En français, ça donne",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "Je fumais (avant)",
              "texte": "<i>I **used to** smoke.</i> — c’est fini, contraste avec aujourd’hui."
            },
            {
              "titre": "Chaque été, on allait",
              "texte": "<i>Every summer we **would** go.</i> — souvenir répété, ton de récit."
            },
            {
              "titre": "J’ai l’habitude de",
              "texte": "<i>I’m **used to** the noise.</i> — je m’y suis fait, c’est normal pour moi."
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 3,
          "titre": "Used to ou be used to&nbsp;?",
          "oui": {
            "titre": "Used to + base",
            "texte": "<i>I **used to live** in York.</i> — je n’y vis plus."
          },
          "non": {
            "titre": "Be used to + -ING",
            "texte": "<i>I’m **used to living** in York.</i> — je m’y suis fait, j’y vis."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>She’s used to ___ (work) late.</i> → **working** : <i>to</i> est une préposition."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 4,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Passé ou présent&nbsp;?",
              "texte": "Plus vrai aujourd’hui → **used to**. Habitué maintenant → **be used to**."
            },
            {
              "titre": "Action ou état&nbsp;?",
              "texte": "Une action répétée accepte **would** ; un état seulement **used to**."
            },
            {
              "titre": "Quelle forme derrière&nbsp;?",
              "texte": "Base verbale après **used to** et **would** ; **-ING** après **be used to**."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 5,
          "titre": "Les détails qui rapportent",
          "deux": true,
          "items": [
            {
              "titre": "Négation, question",
              "texte": "le -d tombe : <i>I **didn’t use to** smoke</i> · <i>**Did** you **use to** smoke?</i>"
            },
            {
              "titre": "get used to",
              "texte": "s’habituer : <i>You’ll **get used to** it.</i>"
            },
            {
              "titre": "L’habitude présente",
              "texte": "présent simple + fréquence : <i>I **usually** walk to school.</i>"
            },
            {
              "titre": "would et les états",
              "texte": "<i>I would live in York</i> est impossible : un état = <i>used to</i>."
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>I’m used to get up early</i> → <i>I’m used to **getting** up.</i>",
            "<i>I would be a shy child</i> → <i>I **used to** be a shy child</i> (un état).",
            "<i>I didn’t used to</i> → <i>I didn’t **use** to.</i>",
            "« J’ai l’habitude de » ne se traduit pas toujours par <i>I used to</i> : tout dépend du temps."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>I ___ (live) in Leeds, but I moved.</i> (used to)",
            "<i>He is used to ___ (drive) at night.</i>",
            "<i>Did you ___ to play chess?</i>"
          ],
          "reponses": "1) used to live 2) driving 3) use"
        }
      ]
    }
  ]
}
