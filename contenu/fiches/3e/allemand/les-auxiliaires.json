        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Les formes à savoir",
          "entetes": [
            "Verbe",
            "Présent",
            "Prétérit",
            "Participe"
          ],
          "lignes": [
            [
              "**sein**",
              "<i>bin, bist, ist, sind, seid, sind</i>",
              "<i>war</i>",
              "<i>gewesen</i>"
            ],
            [
              "**haben**",
              "<i>habe, hast, hat, haben, habt, haben</i>",
              "<i>hatte</i>",
              "<i>gehabt</i>"
            ],
            [
              "**werden**",
              "<i>werde, wirst, wird, werden, werdet, werden</i>",
              "<i>wurde</i>",
              "<i>geworden</i> (<i>worden</i> au passif)"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Les emplois comme auxiliaire",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "sein",
              "texte": "Parfait des verbes de **mouvement** et de **changement d’état**&nbsp;; passif d’état. <i>Ich bin müde.</i> (être)"
            },
            {
              "titre": "haben",
              "texte": "Parfait de **tous les autres** verbes. <i>Ich habe ein Auto.</i> (avoir)"
            },
            {
              "titre": "werden",
              "texte": "**Futur** et **passif** d’action. <i>Er wird Arzt.</i> (devenir)"
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Haben ou sein au parfait&nbsp;?",
          "oui": {
            "titre": "sein",
            "texte": "<i>Ich **bin** nach Berlin gefahren.</i> — je me suis déplacé."
          },
          "non": {
            "titre": "haben",
            "texte": "<i>Ich **habe** das Auto gefahren.</i> — il y a un COD&nbsp;: haben, même avec <i>fahren</i>."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>Sie ___ um acht Uhr eingeschlafen.</i> → **ist**&nbsp;: un changement d’état."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Mouvement&nbsp;?",
              "texte": "D’un point à un autre (<i>gehen, fahren, kommen, fliegen</i>) → **sein**."
            },
            {
              "titre": "Changement d’état&nbsp;?",
              "texte": "<i>aufstehen, einschlafen, aufwachen, sterben</i> → **sein**. Et les quatre à part&nbsp;: <i>sein, bleiben, werden, passieren</i>."
            },
            {
              "titre": "Sinon",
              "texte": "**haben**, y compris un verbe de mouvement avec un COD."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "À retenir",
          "deux": true,
          "items": [
            {
              "titre": "Les verbes en sein",
              "texte": "<i>gehen, fahren, kommen, fliegen, laufen, reisen</i>"
            },
            {
              "titre": "Les changements d’état",
              "texte": "<i>aufstehen, einschlafen, aufwachen, wachsen, sterben</i>"
            },
            {
              "titre": "werden",
              "texte": "nom ou adjectif → devenir&nbsp;; infinitif → futur&nbsp;; participe II → passif"
            },
            {
              "titre": "bekommen",
              "texte": "= **recevoir**. « Je deviens » se dit <i>ich werde</i>."
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>bekommen</i> **n’est pas** « devenir »&nbsp;: <i>Ich bekomme ein Buch</i> = je reçois un livre.",
            "<i>Ich habe nach Berlin gefahren</i> → <i>Ich **bin** nach Berlin gefahren.</i>",
            "<i>schlafen</i> prend **haben** (<i>Ich habe geschlafen</i>), mais <i>einschlafen</i> prend **sein**.",
            "Le même mot, trois sens&nbsp;: c’est ce qui **suit** <i>werden</i> qui tranche."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>Er ___ nach Paris geflogen.</i> (sein / haben)",
            "<i>Ich ___ gestern Fußball gespielt.</i>",
            "<i>Ich ___ Arzt.</i> (je deviens)"
          ],
          "reponses": "1) ist 2) habe 3) werde"
        }
      ]
    }
  ]
