            "titre": "Did + base",
            "texte": "<i>**Did** you go? I **didn’t** go.</i> — le passé est sur did."
          },
          "non": {
            "titre": "Passé deux fois",
            "texte": "<i>Did you went? I didn’t went.</i> — went est déjà au passé."
