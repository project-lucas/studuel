{
  "titre": "La permission",
  "titreSurligne": "permission",
  "accroche": "Can, may, could, be allowed to.",
  "bonus": "**Can I…?** familier · **Could I…?** poli · **May I…?** formel",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/5e/anglais/expression-de-la-modalite-la-permission.webp",
    "prompt": "a glossy violet door slightly open with a golden key in the lock and a golden check mark, sparkles, same art style as the reference icons, magenta background"
  },
  "marcel": "Puis-je entrer&nbsp;?\nMay I&nbsp;?",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "La forme",
          "lignes": [
            "**Can / May / Could** I + base&nbsp;?"
          ],
          "petite": true,
          "regle": "Trois modaux, du plus familier au plus poli. Tous sont invariables&nbsp;: pas de -s, pas de to.",
          "note": "Could = on demande seulement"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Selon le registre",
          "entetes": [
            "Registre",
            "Demander",
            "Accorder / refuser"
          ],
          "lignes": [
            [
              "Familier",
              "<i>**Can** I go out?</i>",
              "<i>You **can**. / You **can’t**.</i>"
            ],
            [
              "Poli",
              "<i>**Could** I borrow your pen?</i>",
              "—"
            ],
            [
              "Formel",
              "<i>**May** I come in?</i>",
              "<i>You **may**. / You **may not**.</i>"
            ],
            [
              "Règle écrite",
              "—",
              "<i>Students **may not** use phones.</i>"
            ],
            [
              "Passé, futur",
              "**be allowed to**",
              "<i>I was allowed to go.</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Les trois modaux",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "Can",
              "texte": "Le plus courant, à l’oral&nbsp;: <i>You **can** use my phone.</i> · <i>You **can’t** park here.</i>"
            },
            {
              "titre": "May",
              "texte": "Plus poli, avec un adulte ou dans un règlement&nbsp;: <i>**May** I leave?</i>"
            },
            {
              "titre": "Could",
              "texte": "Pour **demander** poliment, pas pour accorder&nbsp;: <i>**Could** I come?</i>"
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Could, pour accorder&nbsp;?",
          "oui": {
            "titre": "Pour demander",
            "texte": "<i>**Could** I borrow your pen?</i> — c’est poli et correct."
          },
          "non": {
            "titre": "Pas pour accorder",
            "texte": "<i>You could go</i> = « tu pourrais y aller », une suggestion. Dis <i>You **can** go</i>."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>Yesterday I ___ go out.</i> (j’avais le droit) → **was allowed to**."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "Choisir la forme",
          "etapes": [
            {
              "titre": "À qui parles-tu&nbsp;?",
              "texte": "Un ami → **Can I…?** Un adulte → **Could / May I…?**"
            },
            {
              "titre": "Quand&nbsp;?",
              "texte": "Au passé ou au futur → **be allowed to**."
            },
            {
              "titre": "Un refus&nbsp;?",
              "texte": "**can’t**, **may not**. Très fort&nbsp;: **mustn’t**."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "Be allowed to",
          "deux": true,
          "items": [
            {
              "titre": "Présent",
              "texte": "<i>I **am allowed to** stay up late.</i>"
            },
            {
              "titre": "Passé",
              "texte": "<i>We **weren’t allowed to** leave.</i>"
            },
            {
              "titre": "Futur",
              "texte": "<i>You **will be allowed to** vote at 18.</i>"
            },
            {
              "titre": "Il insiste",
              "texte": "sur une **règle extérieure**."
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>May I to go?</i> → <i>May I go?</i> (pas de to).",
            "<i>I could go yesterday</i> (permission) → <i>I **was allowed to** go</i>.",
            "<i>You could go</i> n’est pas une permission&nbsp;: c’est une suggestion.",
            "<i>You can’t</i> = interdit&nbsp;; <i>You mustn’t</i> = encore plus fort."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "Demande très poliment d’entrer, avec <i>May</i>.",
            "<i>We ___ leave yesterday.</i> (on n’avait pas le droit)",
            "Refuse&nbsp;: <i>You ___ park here.</i> (familier)"
          ],
          "reponses": "1) May I come in? 2) weren’t allowed to 3) can’t"
        }
      ]
    }
  ]
}
