        {
          "type": "pieges",
          "items": [
            "« que » ne se traduit pas toujours par <i>that</i> : c’est la **fonction** qui décide.",
            "<i>the man which called</i> → <i>the man **who** called.</i>",
            "<i>My dad, that is a pilot</i> → <i>My dad, **who** is a pilot.</i>",
            "<i>the man who called</i> : le pronom sujet ne saute jamais."
          ]
        }
      ]
