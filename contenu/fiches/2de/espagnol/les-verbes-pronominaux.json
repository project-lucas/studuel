          "note": "Me levanto a las siete"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Où se place le pronom",
          "entetes": [
            "Le verbe est…",
            "Le pronom",
            "Exemple"
          ],
          "lignes": [
            [
              "conjugué",
              "**devant**",
              "<i>Me levanto a las siete.</i>"
            ],
            [
              "à l’infinitif",
              "soudé derrière",
              "<i>levantarse</i>"
            ],
            [
              "au gérondif",
              "soudé derrière",
              "<i>levantándose</i>"
            ],
            [
              "impératif affirmatif",
              "soudé derrière",
              "<i>¡Levántate!</i>"
            ],
            [
              "avec un semi-auxiliaire",
              "devant ou derrière",
              "<i>Me voy a levantar</i> = <i>Voy a levantarme</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Trois valeurs de « se »",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "Réfléchie",
              "texte": "L’action revient sur le sujet&nbsp;: <i>**Se** lava.</i> (il se lave)"
            },
            {
              "titre": "Réciproque",
              "texte": "Plusieurs sujets, l’un sur l’autre&nbsp;: <i>**Se** escriben.</i> (ils s’écrivent)"
            },
            {
              "titre": "Lexicale",
              "texte": "Le pronom fait partie du verbe&nbsp;: <i>quejarse, arrepentirse, atreverse, darse cuenta de</i>."
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Passive ou impersonnelle&nbsp;?",
          "oui": {
            "titre": "Passive",
            "texte": "<i>**Se venden** pisos.</i> — il y a un sujet (<i>pisos</i>), le verbe se met au pluriel."
          },
          "non": {
            "titre": "Impersonnelle",
            "texte": "<i>**Se habla** de política.</i> — pas de sujet, le verbe reste au singulier."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>Se ___ (alquilar) habitaciones.</i> → **alquilan**&nbsp;: <i>habitaciones</i> est le sujet."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Quel verbe&nbsp;?",
              "texte": "Conjugué, infinitif, gérondif ou impératif&nbsp;?"
            },
            {
              "titre": "Place le pronom",
              "texte": "Devant s’il est conjugué, **soudé** derrière sinon."
            },
            {
              "titre": "Quelle valeur&nbsp;?",
              "texte": "Un sujet pluriel après <i>se</i> → passive&nbsp;; aucun sujet → impersonnelle."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "Le sens qui change",
          "deux": true,
          "items": [
            {
              "titre": "ir / irse",
              "texte": "aller / **partir**&nbsp;: <i>Me voy.</i>"
            },
            {
              "titre": "dormir / dormirse",
              "texte": "dormir / **s’endormir**."
            },
            {
              "titre": "quedar / quedarse",
              "texte": "convenir / **rester** sur place."
            },
            {
              "titre": "poner / ponerse",
              "texte": "mettre / **se mettre**, devenir."
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>Se venden pisos</i> ≠ <i>Se vende pisos</i>&nbsp;: la passive s’accorde avec ce qui est vendu.",
            "<i>levantarse</i> → <i>¡**Levántate**!</i>&nbsp;: à l’impératif affirmatif, le pronom se soude et l’accent apparaît.",
            "<i>Me doy cuenta</i> (je me rends compte)&nbsp;: <i>darse cuenta</i> est lexical, le pronom ne tombe jamais.",
            "<i>Yo se lava</i> → <i>Yo **me** lavo</i>&nbsp;: le pronom suit le sujet."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "Impératif affirmatif de <i>levantarse</i> (tú)&nbsp;?",
            "<i>Aquí ___ (comer) bien.</i> (impersonnelle)",
            "<i>Se ___ (vender) pisos.</i> (passive)"
          ],
          "reponses": "1) ¡Levántate! 2) se come 3) se venden"
        }
      ]
    }
  ]
