          "calcul": "v₂ = 1,5 × 2,0 / 0,50",
          "aparte": "S₁v₁ = S₂v₂",
          "resultat": "v₂ = [[6,0 m/s]]"
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 4,
          "titre": "Distillation fractionnée",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "En tête",
              "texte": "le constituant le plus **volatil**, ou l’azéotrope"
