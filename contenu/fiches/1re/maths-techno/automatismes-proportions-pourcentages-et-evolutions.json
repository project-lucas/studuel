          "aparte": "0,96 = 1 − 0,04",
          "resultat": "[[76,80 €]], soit [[− 4 %]]"
        },
        {
          "type": "cartes",
          "numero": 4,
          "titre": "Les réflexes",
          "colonnes": 2,
          "cartes": [
            { "titre": "Prendre t %", "texte": "15 % de 80 = 0,15 × 80 = **12**." },
            { "titre": "Taux d’évolution", "texte": "40 € → 50 €&nbsp;: 10 ÷ 40 = 0,25, soit **+ 25 %**." },
            { "titre": "Proportion de proportion", "texte": "40 % puis 25 %&nbsp;: 0,4 × 0,25 = **10 %**." },
            { "titre": "Évolution réciproque", "texte": "Après × 1,25, on revient avec 1 ÷ 1,25 = 0,8, soit **− 20 %**." }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 296px",
      "blocs": [
        {
          "type": "copie",
          "titre": "Sur ta copie",
          "lignes": [
            { "texte": "CM₁ = 1,2 et CM₂ = 0,8", "quoi": "les coefficients" },
            { "texte": "CM = 1,2 × 0,8 = 0,96", "quoi": "le coefficient global" },
            { "texte": "0,96 = 1 − 0,04 : baisse de 4 %", "quoi": "le taux global" }
          ],
          "pied": "Contrôle&nbsp;: 80 × 1,2 = 96 puis 96 × 0,8 = ==76,8==. ✔"
        },
        {
          "type": "pieges",
          "items": [
