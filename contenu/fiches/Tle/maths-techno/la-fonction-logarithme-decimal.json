{
  "titre": "Logarithme décimal",
  "titreSurligne": "Logarithme",
  "accroche": "10 puissance combien donne b ?",
  "epreuve": "bac",
  "bonus": "10ˣ = b ⇔ x = log b · log 1 = 0 · log 10 = 1 · croissante sur ]0 ; +∞[ · log(ab) = log a + log b",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/Tle/maths-techno/la-fonction-logarithme-decimal.webp",
    "prompt": "a glossy violet slowly rising curve beside a golden ladder of powers of ten, tiny golden sparkles"
  },
  "marcel": "log répond :\n10 puissance combien ?",
  "rangs": [
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "Les règles de calcul",
          "petite": true,
          "lignes": ["log(a × b) = log a + log b", "log({a/b}) = log a − log b", "log(a<sup>n</sup>) = n log a"],
          "regle": "Pour a, b ==strictement positifs==. Aussi log(10<sup>n</sup>) = n et 10<sup>log b</sup> = b.",
          "note": "log(a + b) ≠ log a + log b&nbsp;!"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Valeurs et signe",
          "entetes": ["b", "log b"],
          "lignes": [
            ["0,001", "−3"],
            ["0,1", "−1"],
            ["1", "0"],
            ["10", "1"],
            ["1 000", "3"]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 3,
          "titre": "La méthode en trois temps",
          "etapes": [
            { "titre": "Décomposer", "texte": "écrire le nombre avec 2, 10, des puissances : 20 = 2 × 10" },
            { "titre": "Appliquer", "texte": "produit en somme, quotient en différence, puissance en facteur" },
            { "titre": "Remplacer", "texte": "utiliser la valeur donnée, par exemple log 2 ≈ 0,301" }
          ]
        }
      ]
    },
    {
      "colonnes": "262px 1fr",
      "blocs": [
        {
          "type": "postit",
          "titre": "Exemple résolu",
          "donnees": "Sachant __log 2 ≈ 0,301__, calculer log 20 et log 0,25.",
          "calcul": "log 20 = log 2 + log 10 = 1,301\nlog 0,25 = −log 2² = −2 log 2",
          "aparte": "0,25 = 1 ÷ 4",
          "resultat": "[[1,301]] et [[−0,602]]"
        },
        {
          "type": "cartes",
          "numero": 4,
          "titre": "Les réflexes",
          "colonnes": 2,
          "cartes": [
            { "titre": "Ordre", "texte": "log est **croissante** : a &lt; b ⇔ log a &lt; log b." },
            { "titre": "Nombre de chiffres", "texte": "k − 1 ≤ log N &lt; k : **k chiffres**. 2<sup>100</sup> : 30,1, donc **31**." },
            { "titre": "pH", "texte": "pH = −log[H₃O⁺] : 10 fois plus acide, **1 point** de moins." },
            { "titre": "Repère semi-log", "texte": "Une suite géométrique s’y voit **alignée**." }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 296px",
      "blocs": [
        {
          "type": "copie",
          "titre": "Sur ta copie",
          "lignes": [
            { "texte": "log 20 = log(2 × 10) = log 2 + log 10", "quoi": "le produit" },
            { "texte": "log 0,25 = log(1 ÷ 4) = −2 log 2", "quoi": "l’inverse" },
            { "texte": "log 20 ≈ 1,301 et log 0,25 ≈ −0,602", "quoi": "les valeurs" }
          ],
          "pied": "Contrôle&nbsp;: 20 &gt; 1 donne un log positif, 0,25 &lt; 1 un négatif. ✔"
        },
        {
          "type": "pieges",
          "items": [
            "Écrire log(a + b) = log a + log b.",
            "Chercher log d’un nombre **≤ 0** : il n’existe pas.",
            "Oublier que log 10 = **1**.",
            "Dire que log b est positif pour **0 &lt; b &lt; 1**."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "**log 1** et **log 10** valent&nbsp;?",
            "**log 1 000** vaut&nbsp;?",
            "log 2 + log 5 vaut&nbsp;?"
          ],
          "reponses": "1) 0 et 1 · 2) 3 · 3) log 10 = 1"
        }
      ]
    }
  ]
}
