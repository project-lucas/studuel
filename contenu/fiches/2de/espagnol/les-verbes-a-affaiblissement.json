{
  "titre": "L’affaiblissement",
  "titreSurligne": "affaiblissement",
  "accroche": "Le e devient i : la famille de pedir.",
  "bonus": "**e → i** · tous les verbes en **-ir** · présent, passé simple (3<sup>es</sup> pers.), gérondif",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/2de/espagnol/les-verbes-a-affaiblissement.webp",
