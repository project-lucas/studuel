          "items": [
            {
              "titre": "Complément + to",
              "texte": "<i>I want **you to** listen.</i> / <i>She asked **me to** wait.</i>"
            },
            {
              "titre": "Pour + verbe",
              "texte": "<i>to</i> ou <i>in order to</i> : <i>I went there **to buy** bread.</i>"
            },
            {
              "titre": "Like, love, hate",
              "texte": "les deux : <i>I like swimming / to swim.</i>"
            },
            {
              "titre": "Would like",
              "texte": "toujours <i>to</i> : <i>I’d like **to** swim.</i>"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>I enjoy to read</i> → <i>I enjoy **reading**.</i>",
            "<i>before to leave</i> → <i>before **leaving**.</i>",
            "<i>for buying bread</i> → <i>**to buy** bread.</i>",
            "<i>I want that you listen</i> → <i>I want **you to** listen.</i>"
