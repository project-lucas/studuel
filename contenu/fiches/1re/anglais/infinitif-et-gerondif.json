            {
              "titre": "Après une préposition",
              "texte": "<i>instead of **waiting**, good at **singing**, interested in **learning**</i>"
            },
            {
              "titre": "mean",
              "texte": "<i>I meant **to call**</i> (intention) · <i>It means **waiting**</i> (implique)."
            }
          ]
