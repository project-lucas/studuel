        {
          "type": "pieges",
          "items": [
            "<i>He works hardly</i> → <i>He works **hard**.</i> (hardly = à peine)",
            "<i>She sings good</i> → <i>She sings **well**.</i>",
            "<i>I go always to school</i> → <i>I **always go**…</i>",
            "<i>I speak well English</i> → <i>I speak English **well**.</i>"
