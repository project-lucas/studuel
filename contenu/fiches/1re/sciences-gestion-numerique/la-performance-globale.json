{
  "titre": "Performance globale",
  "titreSurligne": "globale",
  "accroche": "Réussir sur tous les tableaux.",
  "bonus": "**Efficacité** = objectif atteint · **efficience** = avec quels moyens · **profitabilité** ≠ **rentabilité**",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/1re/sciences-gestion-numerique/la-performance-globale.webp",
    "prompt": "a glossy violet dashboard gauge with a golden needle and five small golden dials, tiny golden sparkles, same art style as the reference icons, magenta background, no text"
  },
  "marcel": "Un équilibre,\npas un record&nbsp;!",
  "rangs": [
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "tableau",
          "numero": 1,
          "titre": "Les cinq dimensions",
          "entetes": ["Dimension", "Indicateurs"],
          "lignes": [
            ["**Processus**", "délais, erreurs, productivité"],
            ["**Commerciale**", "part de marché, fidélité"],
            ["**Financière**", "rentabilité, autofinancement"],
            ["**Sociale**", "bilan social, absentéisme"],
            ["**Environnementale**", "CO2, déchets, énergie"]
          ]
        },
        {
          "type": "formule",
          "numero": 2,
          "titre": "Les calculs",
          "lignes": [
            "Profitabilité = {résultat/CA}"
          ],
          "regle": "Rentabilité = résultat ÷ capitaux propres. Part de marché = ventes ÷ marché",
          "note": "chacun × 100",
          "teinte": "jaune"
        }
      ]
    },
    {
      "colonnes": "1fr 262px",
      "blocs": [
        {
          "type": "etapes",
          "numero": 3,
          "titre": "Juger une performance",
          "etapes": [
            { "titre": "Calculer", "texte": "part de marché, profitabilité, rentabilité" },
            { "titre": "Comparer", "texte": "dans le temps et face au secteur" }
          ]
        },
        {
          "type": "postit",
          "titre": "Exemple résolu",
          "donnees": "Résultat 100 000 €, capitaux propres 500 000 €. Rentabilité&nbsp;?",
          "calcul": "100 000 ÷ 500 000 × 100",
          "resultat": "[[20 %]]"
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 4,
          "titre": "Des performances contradictoires",
          "colonnes": 3,
          "cartes": [
            { "titre": "Baisser les prix", "texte": "plus de **parts de marché**, moins de profitabilité." },
            { "titre": "Plus de dividendes", "texte": "moins d’**autofinancement**." },
            { "titre": "Usine propre", "texte": "pèse sur la finance, aide l’**environnement**." }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 296px",
      "blocs": [
        {
          "type": "copie",
          "titre": "Sur ta copie",
          "lignes": [
            { "texte": "La rentabilité financière est de 20&nbsp;%&nbsp;: très bonne pour les associés.", "quoi": "calculer" },
            { "texte": "Mais l’absentéisme de 9&nbsp;% dépasse celui du secteur&nbsp;: la performance sociale est faible.", "quoi": "nuancer" },
            { "texte": "La performance est un équilibre que l’organisation doit justifier.", "quoi": "conclure" }
          ],
          "pied": "Un ==tableau de bord== compare dans le temps et dans l’espace."
        },
        {
          "type": "pieges",
          "items": [
            "Confondre **efficacité** et efficience.",
            "Confondre **profitabilité** et rentabilité.",
            "Réduire la performance à la **finance**.",
            "Oublier de **comparer** au secteur."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "Que mesure la **profitabilité** ?",
            "Que mesure la **rentabilité** ?",
            "Qu’est-ce que l’**efficience** ?"
          ],
          "reponses": "1) le résultat par euro vendu · 2) le résultat par euro investi · 3) atteindre l’objectif avec peu de moyens"
        }
      ]
    }
  ]
}
