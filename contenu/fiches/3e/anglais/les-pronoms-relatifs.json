            },
            {
              "titre": "Le relatif",
              "texte": "Remplace-le dans la seconde&nbsp;: <i>who, which, whose, where</i>."
            },
            {
              "titre": "La place",
              "texte": "Relative **juste après** son antécédent, sans pronom en double."
            }
          ]
        }
