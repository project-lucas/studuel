        {
          "type": "tableau",
          "numero": 2,
          "titre": "Les trois règles",
          "entetes": [
            "La règle",
            "Son sens",
            "L’exemple"
          ],
          "lignes": [
            [
              "**Invariable**",
              "jamais de -s",
              "<i>a red car, two red cars</i>"
            ],
            [
              "**Avant** le nom",
              "inverse du français",
              "<i>a beautiful house</i>"
            ],
            [
              "Après un verbe d’état",
              "be, seem, look, feel, become",
              "<i>She looks tired.</i>"
            ],
            [
              "Composé",
              "trait d’union, nom singulier",
              "<i>a five-year-old boy</i>"
