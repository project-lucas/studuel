{
  "titre": "Souhait et regret",
  "titreSurligne": "regret",
  "accroche": "Dire ce qu’on voudrait, ce qu’on regrette.",
  "bonus": "**would like** + to · **wish** : on recule d’un temps · **should have** + participe passé",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/5e/anglais/expression-de-la-modalite-le-souhait-et-le-regret.webp",
    "prompt": "a glossy violet shooting star with a golden tail and small golden sparkles, same art style as the reference icons, magenta background"
  },
  "marcel": "Je voudrais…\nI wish&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "Wish",
          "lignes": [
            "**I wish** + prétérit"
          ],
          "petite": true,
          "regle": "Pour un regret sur le **présent**, on **recule d’un temps**&nbsp;: <i>I wish I had more time.</i> (je n’en ai pas assez)",
          "note": "were pour tous !"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Wish et les autres",
          "entetes": [
            "Je parle de…",
            "Le temps",
            "L’exemple"
          ],
          "lignes": [
            [
              "le **présent**",
              "prétérit",
              "<i>I wish I had a dog.</i> (j’aimerais en avoir un)"
            ],
            [
              "le **passé**",
              "past perfect",
              "<i>I wish I had studied.</i> (si seulement j’avais révisé)"
            ],
            [
              "un **changement**",
              "would",
              "<i>I wish it would stop raining.</i>"
            ],
            [
              "un souhait simple",
              "would like + to",
              "<i>I’d like to travel.</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Trois façons de regretter",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "Wish / If only",
              "texte": "<i>If only I knew!</i> (si seulement je savais&nbsp;!) — **If only** est plus fort que **wish**."
            },
            {
              "titre": "Should have",
              "texte": "<i>I should have told you.</i> (j’aurais dû te le dire)"
            },
            {
              "titre": "Regret + -ING",
              "texte": "<i>I regret saying that.</i> (je regrette d’avoir dit ça)"
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Quel temps après wish&nbsp;?",
          "oui": {
            "titre": "Recule d’un temps",
            "texte": "<i>I wish I **were** taller.</i> — were pour toutes les personnes."
          },
          "non": {
            "titre": "Pas de présent",
            "texte": "<i>I wish I have more time</i> est faux. Il faut **had**."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>I wish I ___ (have) a bike.</i> → **had**&nbsp;: regret sur le présent."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Présent ou passé&nbsp;?",
              "texte": "Je regrette ce qui est, ou ce qui était&nbsp;?"
            },
            {
              "titre": "Recule d’un temps",
              "texte": "Présent → prétérit. Passé → past perfect."
            },
            {
              "titre": "Poli&nbsp;?",
              "texte": "Pour demander, dis **I’d like**, pas I want."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "Les mots utiles",
          "deux": true,
          "items": [
            {
              "titre": "Would you like…?",
              "texte": "proposition polie&nbsp;: <i>Would you like a drink?</i>"
            },
            {
              "titre": "I wish you…",
              "texte": "le seul wish sans recul&nbsp;: <i>I wish you a happy birthday.</i>"
            },
            {
              "titre": "If only",
              "texte": "si seulement…"
            },
            {
              "titre": "should have",
              "texte": "j’aurais dû…"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>I would want a coffee</i> → <i>I’d **like** a coffee.</i>",
            "<i>I wish I have time</i> → <i>I wish I **had** time.</i>",
            "<i>I wish I was</i> : on écrit mieux <i>I wish I **were**.</i>",
            "<i>I regret to say</i> ≠ <i>I regret saying</i> (regret + -ING = regretter d’avoir dit)."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>I wish I ___ (be) taller.</i>",
            "<i>I wish I ___ (study) harder. (passé)</i>",
            "Dis poliment que tu veux un thé."
          ],
          "reponses": "1) were 2) had studied 3) I’d like a tea."
        }
      ]
    }
  ]
}
