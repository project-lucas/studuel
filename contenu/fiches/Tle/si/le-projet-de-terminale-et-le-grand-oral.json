            { "date": "Solutions", "texte": "comparées, choix justifié" },
            { "date": "Conception", "texte": "modèles, simulations, dimensionnement" },
            { "date": "Réalisation", "texte": "prototype ou maquette" },
            { "date": "Validation", "texte": "essais comparés au cahier des charges" }
          ]
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Le Grand oral",
          "entetes": ["Élément", "À savoir"],
          "lignes": [
            ["Questions", "deux préparées, le jury en choisit **une**"],
            ["Préparation", "**20 min**, support non évalué"],
            ["Temps 1", "**10 min** debout, présentation"],
            ["Temps 2", "**10 min** d’échange avec le jury"],
            ["Coefficient", "**8** (voie générale, 2027)"]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 3,
          "titre": "Relier projet et oral",
          "etapes": [
            { "titre": "Partir", "texte": "d’une difficulté réelle rencontrée pendant le projet" },
            { "titre": "Généraliser", "texte": "en tirer une question qui dépasse ton prototype" },
            { "titre": "Illustrer", "texte": "le projet en exemple, avec un ou deux chiffres parlants" }
          ]
        }
      ]
    },
    {
      "colonnes": "262px 1fr",
      "blocs": [
        {
          "type": "postit",
          "titre": "Exemple",
