            "titre": "Futur",
            "texte": "<i>Cuando llegarás, llámame.</i> — le français dit « quand tu arriveras », pas l’espagnol."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>Mientras ___ (estar, tú) aquí…</i> → **estés**&nbsp;: subordonnée de temps."
