{
  "titre": "Identifier une espèce",
  "titreSurligne": "espèce",
  "accroche": "Faire parler la matière.",
  "bonus": "**UV-visible** 200–800 nm : électrons · **IR** 2,5–25 µm : vibrations · σ = 1/λ en **cm⁻¹**",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/1re/spcl/identifier-une-espece-tests-spectroscopies-uv-visible-et-ir.webp",
    "prompt": "a glossy violet test tube with a golden precipitate next to a small spectrum curve with a peak, sparkles"
  },
  "marcel": "Chaque bande\nraconte une liaison&nbsp;!",
  "rangs": [
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "tableau",
          "numero": 1,
          "titre": "Tests d’ions",
          "entetes": ["Ion", "Réactif", "Précipité"],
          "lignes": [
            ["Cl⁻", "nitrate d’argent", "**blanc**"],
            ["SO₄²⁻", "chlorure de baryum", "**blanc**"],
            ["Cu²⁺", "soude", "**bleu**"],
            ["Fe²⁺", "soude", "**vert**"],
            ["Fe³⁺", "soude", "**rouille**"]
          ]
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Spectre IR",
          "entetes": ["Liaison", "σ (cm⁻¹)", "Aspect"],
          "lignes": [
            ["O–H alcool", "3 200–3 400", "**large**"],
            ["O–H acide", "2 500–3 200", "très large"],
            ["C–H", "2 850–3 100", "fine"],
            ["**C=O**", "1 650–1 750", "**intense**, fine"],
            ["C=C", "1 620–1 680", "moyenne"]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 3,
          "titre": "Lire un spectre IR",
          "etapes": [
            { "titre": "Au-dessus de 1 500", "texte": "repérer les **groupes caractéristiques**" },
            { "titre": "Associer", "texte": "bande + nombre d’onde = **liaison**" },
            { "titre": "Conclure", "texte": "la famille&nbsp;: acide, ester, alcool…" }
          ]
        }
      ]
    },
    {
      "colonnes": "262px 1fr",
      "blocs": [
        {
          "type": "postit",
          "titre": "Exemple résolu",
          "donnees": "Bande intense à 1 710 cm⁻¹ et bande très large de 2 500 à 3 200 cm⁻¹. __Molécule__&nbsp;?",
          "calcul": "1 710 : C=O",
          "aparte": "2 500–3 200 : O–H d’acide",
          "resultat": "un [[acide carboxylique]]"
        },
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Acide ou ester&nbsp;?",
          "oui": { "titre": "Acide carboxylique", "texte": "**C=O** vers 1 710 **et** bande O–H très large." },
          "non": { "titre": "Ester", "texte": "**C=O** vers 1 740 **sans** bande O–H." },
          "essai": { "texte": "En UV-visible, une molécule qui absorbe le <i>rouge</i> (650 nm) paraît de la couleur <b>complémentaire</b>&nbsp;: bleu-vert." }
        }
      ]
    },
    {
      "colonnes": "1fr 296px",
      "blocs": [
        {
          "type": "copie",
          "titre": "Sur ta copie",
          "lignes": [
            { "texte": "Bande intense vers 1 710 cm⁻¹&nbsp;: liaison C=O.", "quoi": "la 1<sup>re</sup> bande" },
            { "texte": "Bande très large 2 500–3 200 cm⁻¹&nbsp;: O–H d’acide.", "quoi": "la 2<sup>e</sup> bande" },
            { "texte": "La molécule est un acide carboxylique.", "quoi": "la conclusion" }
          ],
          "pied": "Plus de liaisons ==conjuguées==, plus on absorbe à grande longueur d’onde."
        },
        {
          "type": "pieges",
          "items": [
            "Lire l’axe IR de **gauche à droite en croissant** (il décroît).",
            "Confondre **nombre d’onde** et longueur d’onde.",
            "Oublier le **témoin** dans un test d’ion.",
            "Chercher les groupes dans l’**empreinte digitale**."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "Quel ion donne un précipité **bleu** avec la soude&nbsp;?",
            "Bande **intense** vers 1 700 cm⁻¹&nbsp;: quelle liaison&nbsp;?",
            "En quelle unité est le **nombre d’onde**&nbsp;?"
          ],
          "reponses": "1) Cu²⁺ · 2) C=O · 3) cm⁻¹"
        }
      ]
    }
  ]
}
