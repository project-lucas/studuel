            { "titre": "Additionner", "texte": "Même dénominateur&nbsp;: {2/3} + {1/6} = **{5/6}**." },
            { "titre": "Diviser", "texte": "Multiplier par l’**inverse**&nbsp;: {2/3} ÷ {4/5} = {2/3} × {5/4}." }
