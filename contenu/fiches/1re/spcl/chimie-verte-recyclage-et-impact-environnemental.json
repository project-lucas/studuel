            {
              "titre": "Économie",
              "texte": "réactifs, énergie, **traitement** des déchets"
            },
            {
              "titre": "Social",
              "texte": "**sécurité** des salariés et des riverains"
            }
          ]
        }
      ]
    },
    {
      "colonnes": "262px 1fr",
      "blocs": [
