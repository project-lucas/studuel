            "titre": "Explicative bien écrite",
            "texte": "<i>My brother, **who** lives in London, is a teacher.</i>"
          },
          "non": {
            "titre": "That entre virgules",
            "texte": "<i>My brother, **that** lives in London, is a teacher.</i>"
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>The book ___ I bought is great.</i> → **that / which / rien**&nbsp;: complément, donc facultatif."
