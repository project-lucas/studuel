            "titre": "Interdit",
            "texte": "<i>You **mustn’t** park here.</i> — il ne faut pas."
          },
          "non": {
            "titre": "Pas obligé",
            "texte": "<i>You **don’t have to** come.</i> — ce n’est pas la peine."
          },
          "essai": {
            "titre": "Essai",
            "texte": "« Il doit être épuisé. » → <i>He ___ be exhausted.</i> → **must** (déduction)."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Quel point de vue&nbsp;?",
              "texte": "Capacité, permission, obligation, conseil, probabilité."
            },
            {
              "titre": "Choisis le modal",
              "texte": "<i>can, may, must, should, will</i> selon la valeur."
            },
            {
              "titre": "Forme-le",
              "texte": "Modal + **base sans to** · passé : modal + **have** + pp."
