{
  "titre": "Temporalité et durée",
  "titreSurligne": "durée",
  "accroche": "For, since, ago, during : chacun son rôle.",
  "bonus": "**for** + durée · **since** + départ · **ago** + prétérit · **during** + nom · **while** + proposition",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/1re/anglais/exprimer-la-temporalite-et-la-duree.webp",
    "prompt": "a glossy violet calendar page with a golden stopwatch beside it, small golden arrows along a timeline, sparkles, same art style as the reference icons, magenta background"
  },
  "marcel": "Depuis, pendant&nbsp;?\nChoisis bien&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "La règle",
          "lignes": ["**for** = durée · **since** = départ"],
          "petite": true,
          "regle": "« Depuis » et « pendant » se traduisent chacun de plusieurs façons&nbsp;: chaque mot anglais a un emploi **précis et exclusif**.",
          "note": "since 2019, for 6 years"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Le tableau qui tranche",
          "entetes": ["Mot", "Il introduit", "Temps", "Exemple"],
          "lignes": [
            ["**for**", "Une durée", "Present perfect", "<i>for six years</i>"],
            ["**since**", "Un point de départ", "Present perfect", "<i>since 2019</i>"],
            ["**ago**", "Un point passé, à rebours", "**Prétérit**", "<i>two years ago</i>"],
            ["**during**", "Un **nom**", "Variable", "<i>during the meeting</i>"],
            ["**while**", "Une **proposition**", "Variable", "<i>while we talked</i>"]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Les autres repères",
          "colonnes": 4,
          "cartes": [
            {
              "titre": "by",
              "texte": "D’ici, au plus tard&nbsp;: <i>by Friday</i>."
            },
            {
              "titre": "until / till",
              "texte": "Jusqu’à&nbsp;: <i>until Friday</i>."
            },
            {
              "titre": "in + durée",
              "texte": "Dans&nbsp;: <i>in two weeks</i>."
            },
            {
              "titre": "within",
              "texte": "D’ici moins de&nbsp;: <i>within a week</i>."
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "During ou while&nbsp;?",
          "oui": {
            "titre": "Le bon mot",
            "texte": "<i>**while** we were talking</i> (sujet + verbe) · <i>**during** the meeting</i> (un nom)."
          },
          "non": {
            "titre": "Le mauvais mot",
            "texte": "<i>**during** we were talking</i> · <i>**while** the meeting</i> — préposition ≠ conjonction."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>I fell asleep ___ the film.</i> → **during** (un nom)."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Un fait daté&nbsp;?",
              "texte": "<i>ago</i> après la durée + **prétérit**&nbsp;: <i>I met her three days ago.</i>"
            },
            {
              "titre": "Ça dure encore&nbsp;?",
              "texte": "**present perfect** + <i>for</i> (durée) ou <i>since</i> (départ)."
            },
            {
              "titre": "Nom ou verbe&nbsp;?",
              "texte": "Un nom → <i>during</i> ; sujet + verbe → <i>while</i>."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "À retenir",
          "deux": true,
          "items": [
            {
              "titre": "for six years",
              "texte": "<i>I’ve lived here **for** six years.</i>"
            },
            {
              "titre": "since 2019",
              "texte": "<i>I’ve lived here **since** 2019.</i>"
            },
            {
              "titre": "ago",
              "texte": "se place **après** la durée&nbsp;: <i>two years ago</i>."
            },
            {
              "titre": "by / until",
              "texte": "<i>by Friday</i> = au plus tard ; <i>until Friday</i> = jusqu’à."
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>I have met her three days ago</i> → <i>I **met** her three days ago.</i> <i>Ago</i> date le fait.",
            "<i>ago two years</i> → <i>two years **ago**</i>.",
            "<i>I live here since 2019</i> → <i>I **have lived** here since 2019.</i>",
            "<i>since six years</i> → <i>**for** six years</i>."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>I’ve lived here ___ six years.</i> (for / since)",
            "<i>We met two years ___.</i>",
            "<i>She phoned ___ the meeting.</i> (during / while)"
          ],
          "reponses": "1) for 2) ago (+ prétérit) 3) during (un nom)"
        }
      ]
    }
  ]
}
