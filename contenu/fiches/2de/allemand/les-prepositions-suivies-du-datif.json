          "cartes": [
            {
              "titre": "nach",
              "texte": "Pays ou ville **sans article**&nbsp;: <i>nach Deutschland, nach Wien</i>."
            },
            {
              "titre": "in + accusatif",
              "texte": "Pays **avec** article&nbsp;: <i>in die Schweiz, in die Türkei</i>."
            },
            {
              "titre": "zu",
              "texte": "Une personne ou un bâtiment comme but&nbsp;: <i>zum Arzt, zur Post</i>."
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Quel cas après mit&nbsp;?",
          "oui": {
            "titre": "Le datif",
            "texte": "<i>Ich fahre **mit dem** Bus.</i> (Je vais en bus.)"
          },
          "non": {
            "titre": "Pas l’accusatif",
            "texte": "<i>Ich fahre mit **den** Bus.</i> — jamais : <i>mit</i> ne fait pas exception."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>Ich wohne bei ___ Tante (die).</i> → **bei meiner**&nbsp;: datif féminin, <i>-r</i>."
