          },
          "non": {
            "titre": "Sujet",
            "texte": "<i>the man who called</i> — le pronom est obligatoire."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>The film (that) we saw was great.</i> → <i>that</i> est **complément**&nbsp;: on peut l’omettre."
