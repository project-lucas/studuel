{
  "titre": "La comparaison",
  "titreSurligne": "comparaison",
  "accroche": "Más que, tan como, tanto como.",
  "bonus": "**tan** + adjectif · **tanto** + nom ou verbe · **más de** + chiffre · **no… más que** = seulement",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/5e/espagnol/la-comparaison.webp",
    "prompt": "a glossy golden balance scale with a violet cube on one side and a golden star on the other, sparkles, same art style as the reference icons, magenta background"
  },
  "marcel": "¡Más alto que yo,\ntan listo como tú&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "Tan ou tanto&nbsp;?",
          "lignes": [
            "**tan** + qualité",
            "**tanto** + ce qui se compte"
          ],
          "petite": true,
          "regle": "**tan** devant un mot qui **qualifie** (adjectif, adverbe), **tanto** devant un mot qui se **compte** (nom) ou après un verbe.",
          "note": "<i>tan alto como tú</i>"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Les comparatifs",
          "entetes": [
            "Relation",
            "Structure",
            "L’exemple"
          ],
          "lignes": [
            [
              "Supériorité",
              "<i>más… que</i>",
              "<i>Es más alto que yo</i>"
            ],
            [
              "Infériorité",
              "<i>menos… que</i>",
              "<i>Tengo menos dinero que tú</i>"
            ],
            [
              "Égalité (adj.)",
              "<i>tan… como</i>",
              "<i>Es tan alto como tú</i>"
            ],
            [
              "Égalité (nom)",
              "<i>tanto/a/os/as… como</i>",
              "<i>Tengo tantos libros como tú</i>"
            ],
            [
              "Égalité (verbe)",
              "<i>tanto como</i>",
              "<i>Trabaja tanto como yo</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 3,
          "titre": "Devant un chiffre",
          "oui": {
            "titre": "No… más que = seulement",
            "texte": "<i>No tengo **más que** diez euros</i> — je n’ai que dix euros."
          },
          "non": {
            "titre": "No… más de = au plus",
            "texte": "<i>No tengo **más de** diez euros</i> — pas plus de dix. <i>Más de veinte</i> = plus de vingt."
          },
          "essai": {
            "titre": "Essai",
            "texte": "Je n’ai que cinq livres&nbsp;: <i>No tengo ___ cinco libros.</i> → **más que**."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 4,
          "titre": "Irréguliers et cas particuliers",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "Irréguliers",
              "texte": "<i>bueno, bien</i> → **mejor** · <i>malo, mal</i> → **peor** · <i>grande</i> → **mayor** · <i>pequeño</i> → **menor**."
            },
            {
              "titre": "Proposition en second terme",
              "texte": "**de lo que** : <i>Es más difícil **de lo que** parece</i> · <i>Tiene más dinero **del que** dice</i>."
            },
            {
              "titre": "Progressif",
              "texte": "**cada vez más / menos** : <i>Hace cada vez más calor.</i>"
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Quelle relation&nbsp;?",
              "texte": "Plus, moins → <i>más, menos… que</i>. Autant → <i>tan / tanto… como</i>."
            },
            {
              "titre": "Qualité ou quantité&nbsp;?",
              "texte": "Adjectif, adverbe → **tan**. Nom, verbe → **tanto** (accordé devant un nom)."
            },
            {
              "titre": "Chiffre&nbsp;?",
              "texte": "**más de** veinte&nbsp;; **no… más que** diez = seulement."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "À retenir",
          "deux": true,
          "items": [
            {
              "titre": "Mayor, menor",
              "texte": "âge et abstrait&nbsp;: <i>mi hermano mayor</i>."
            },
            {
              "titre": "Pas de más",
              "texte": "<i>mejor, peor, mayor, menor</i> sont déjà comparatifs."
            },
            {
              "titre": "Tanto + nom",
              "texte": "s’accorde&nbsp;: <i>tantos libros, tanta agua</i>."
            },
            {
              "titre": "Progressif",
              "texte": "<i>cada vez más</i> · <i>cada vez menos</i>."
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>más mejor</i> → <i>**mejor**</i> (jamais <i>más</i> devant).",
            "<i>tan libros</i> → <i>**tantos** libros</i>.",
            "<i>No tengo más de diez</i> ≠ <i>No tengo más que diez</i>&nbsp;: au plus ≠ seulement.",
            "<i>más difícil que parece</i> → <i>más difícil **de lo que** parece</i>."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "Aussi grand que toi&nbsp;: <i>___ alto como tú.</i>",
            "Autant de livres que toi&nbsp;: <i>___ libros como tú.</i>",
            "Plus difficile qu’il n’y paraît&nbsp;: <i>más difícil ___ parece.</i>"
          ],
          "reponses": "1) tan 2) tantos 3) de lo que"
        }
      ]
    }
  ]
}
