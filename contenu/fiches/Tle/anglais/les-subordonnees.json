{
  "titre": "Les subordonnées",
  "titreSurligne": "subordonnées",
  "accroche": "Relatives, complétives, circonstancielles.",
  "bonus": "**who / which / that / whose** · **that** complétive · **when / if** + présent pour l’avenir",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/Tle/anglais/les-subordonnees.webp",
    "prompt": "a glossy violet puzzle piece linking to a golden puzzle piece, small golden chain links, sparkles, same art style as the reference icons, magenta background"
  },
  "marcel": "Une phrase en dépend&nbsp;?\nSubordonnée&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "Trois familles",
          "lignes": [
            "relative · complétive · circonstancielle"
          ],
          "petite": true,
          "regle": "Une subordonnée dépend d’une **principale**. Chaque famille a son piège.",
          "note": "virgule = appositive"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Les relatives",
          "entetes": [
            "Pronom",
            "Il reprend"
          ],
          "lignes": [
            [
              "<i>who</i>",
              "Une personne"
            ],
            [
              "<i>which</i>",
              "Une chose"
            ],
            [
              "<i>that</i>",
              "Les deux (oral)"
            ],
            [
              "<i>whose</i>",
              "Un possesseur : « dont »"
            ],
            [
              "<i>where / when</i>",
              "Un lieu, un moment"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Les circonstancielles",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "Temps · cause",
              "texte": "<i>when, while, as soon as, until</i> · <i>because, since, as</i>."
            },
            {
              "titre": "But · condition",
              "texte": "<i>so that, in order that</i> · <i>if, unless</i>."
            },
            {
              "titre": "Concession",
              "texte": "<i>although, even though</i>&nbsp;: <i>Although it rained, we left.</i>"
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Virgule ou pas&nbsp;?",
          "oui": {
            "titre": "Déterminative",
            "texte": "<i>The man **who** called is my uncle.</i> — identifie, **sans** virgule, <i>that</i> possible."
          },
          "non": {
            "titre": "Appositive",
            "texte": "<i>My uncle**,** who lives in York**,** called.</i> — ajoute une info, virgules, **jamais** <i>that</i>."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>My sister, ___ lives in Paris, is a nurse.</i> → **who** (pas <i>that</i>)."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "Les complétives",
          "etapes": [
            {
              "titre": "Après un verbe",
              "texte": "<i>say, tell, know, hope, believe</i> + <b>that</b>&nbsp;: <i>She said that she knew.</i>"
            },
            {
              "titre": "That s’omet",
              "texte": "<i>I think (that) he’s right.</i> <i>I hope (that) you’ll come.</i>"
            },
            {
              "titre": "Say / tell",
              "texte": "<i>tell **me**</i> (personne obligatoire) ; <i>say</i> l’interdit."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "À retenir",
          "deux": true,
          "items": [
            {
              "titre": "Relatif complément",
              "texte": "peut s’effacer&nbsp;: <i>The book (that) I read.</i>"
            },
            {
              "titre": "Relatif sujet",
              "texte": "ne s’efface **jamais**."
            },
            {
              "titre": "Après when, if…",
              "texte": "présent pour l’avenir&nbsp;: <i>when he arrives</i>."
            },
            {
              "titre": "whose",
              "texte": "= « dont »&nbsp;: <i>the girl whose bag…</i>"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>He said me</i> → <i>He **told** me</i> / <i>He **said** that…</i>",
            "<i>When he will arrive</i> → <i>When he **arrives**</i>.",
            "<i>My uncle, that lives…</i> → <i>who</i> (appositive).",
            "<i>The book I read it</i> → <i>The book I read</i> : le pronom relatif complément est déjà le complément, pas de reprise."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>The girl ___ bag was stolen…</i> (who / whose)",
            "<i>He ___ me he was tired.</i> (said / told)",
            "<i>I’ll call you when I ___ (get) home.</i>"
          ],
          "reponses": "1) whose 2) told 3) get (présent, jamais will)"
        }
      ]
    }
  ]
}
