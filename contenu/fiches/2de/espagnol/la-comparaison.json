{
  "titre": "La comparaison",
  "titreSurligne": "comparaison",
  "accroche": "Más que, tan como, tanto como.",
  "bonus": "**tan** + adjectif · **tanto** + nom ou verbe · **más de** + chiffre · **no… más que** = seulement",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/2de/espagnol/la-comparaison.webp",
    "prompt": "a glossy golden balance scale with a violet cube on one side and a golden star on the other, sparkles, same art style as the reference icons, magenta background"
  },
  "marcel": "¡Más alto que yo,\ntan listo como tú&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "Tan ou tanto&nbsp;?",
          "lignes": ["**tan** + qualité", "**tanto** + ce qui se compte"],
          "petite": true,
          "regle": "**tan** devant un mot qui **qualifie** (adjectif, adverbe), **tanto** devant un mot qui se **compte** (nom) ou après un verbe.",
          "note": "<i>tan alto como tú</i>"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Les comparatifs",
          "entetes": ["Relation", "Structure", "L’exemple"],
          "lignes": [
            ["Supériorité", "<i>más… que</i>", "<i>Es más alto que yo</i>"],
            ["Infériorité", "<i>menos… que</i>", "<i>Tengo menos dinero que tú</i>"],
            ["Égalité (adj.)", "<i>tan… como</i>", "<i>Es tan alto como tú</i>"],
            ["Égalité (nom)", "<i>tanto/a/os/as… como</i>", "<i>Tengo tantos libros como tú</i>"],
            ["Égalité (verbe)", "<i>tanto como</i>", "<i>Trabaja tanto como yo</i>"]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 3,
          "titre": "Devant un chiffre",
          "oui": {
            "titre": "No… más que = seulement",
            "texte": "<i>No tengo **más que** diez euros</i> — je n’ai que dix euros."
          },
          "non": {
            "titre": "No… más de = au plus",
            "texte": "<i>No tengo **más de** diez euros</i> — pas plus de dix. <i>Más de veinte</i> = plus de vingt."
          },
          "essai": {
            "titre": "Essai",
            "texte": "Je n’ai que cinq livres&nbsp;: <i>No tengo ___ cinco libros.</i> → **más que**."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 4,
          "titre": "Irréguliers et cas particuliers",
          "colonnes": 3,
          "cartes": [
            { "titre": "Irréguliers", "texte": "<i>bueno, bien</i> → **mejor** · <i>malo, mal</i> → **peor** · <i>grande</i> → **mayor** · <i>pequeño</i> → **menor**." },
            { "titre": "Proposition en second terme", "texte": "**de lo que** : <i>Es más difícil **de lo que** parece</i> · <i>Tiene más dinero **del que** dice</i>." },
            { "titre": "Progressif", "texte": "**cada vez más / menos** : <i>Hace cada vez más calor.</i>" }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            { "titre": "Quelle relation&nbsp;?", "texte": "Plus → <i>más… que</i>&nbsp;; moins → <i>menos… que</i>&nbsp;; égal → <i>tan / tanto… como</i>." },
            { "titre": "Tan ou tanto&nbsp;?", "texte": "Qualité → **tan**. Nom ou verbe → **tanto** (accordé devant un nom)." },
            { "titre": "Chiffre ou verbe&nbsp;?", "texte": "Un chiffre → <i>de</i>. Une proposition → <i>de lo que</i>." }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "À retenir",
          "deux": true,
          "items": [
            { "titre": "Mayor, menor", "texte": "surtout pour l’âge et l’abstrait&nbsp;: <i>mi hermano mayor</i>." },
            { "titre": "Plus de + chiffre", "texte": "<i>Tengo más de veinte libros.</i>" },
            { "titre": "Accord de tanto", "texte": "devant un nom&nbsp;: <i>tantas cosas</i>." },
            { "titre": "Pas de más devant mejor", "texte": "<i>mejor</i> suffit, il est déjà comparatif." }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>más mejor</i> → <i>**mejor**</i>.",
            "<i>tan libros como</i> → <i>**tantos** libros como</i>.",
            "<i>Es más difícil que parece</i> → <i>**de lo que** parece</i>.",
            "<i>No tengo más que diez</i> ≠ <i>No tengo más de diez</i>&nbsp;: seulement ou au plus."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "Aussi grand que toi&nbsp;: <i>Es ___ alto como tú.</i>",
            "Autant de livres que toi&nbsp;: <i>Tengo ___ libros como tú.</i>",
            "Meilleur&nbsp;: forme comparative de <i>bueno</i>."
          ],
          "reponses": "1) tan 2) tantos 3) mejor"
        }
      ]
    }
  ]
}
