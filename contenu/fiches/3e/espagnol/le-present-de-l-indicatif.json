              "titre": "Diphtongues",
              "texte": "e → ie (<i>pienso</i>), o → ue (<i>puedo</i>), u → ue (<i>juego</i>)&nbsp;: sauf <i>nosotros</i> et <i>vosotros</i>."
            },
