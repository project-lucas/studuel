{
  "titre": "Le futur",
  "titreSurligne": "futur",
  "accroche": "L’infinitif entier, plus la fin.",
  "bonus": "**-é, -ás, -á, -emos, -éis, -án** sur l’infinitif · 12 irréguliers, 3 familles",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/2de/espagnol/le-futur.webp",
    "prompt": "a glossy violet telescope pointing toward a golden glowing star on the horizon, tiny golden sparkles, same art style as the reference icons, magenta background"
  },
  "marcel": "Douze verbes,\ncinquante formes&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "La forme",
          "lignes": ["**infinitif** + é, ás, á…"],
          "petite": true,
          "regle": "Le futur se construit sur l’**infinitif entier**, pour les trois conjugaisons. Accent écrit partout, sauf à <i>nosotros</i>.",
          "note": "<i>hablaré, hablarás, hablará…</i>"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Les douze irréguliers",
          "entetes": ["Famille", "Ce qui se passe", "Verbes"],
          "lignes": [
            ["Le <i>e</i> tombe", "<i>pod-er → podr-</i>", "<i>poder, querer, saber, haber, caber</i>"],
            ["Un <i>d</i> remplace", "<i>ten-er → tendr-</i>", "<i>tener, poner, venir, salir, valer</i>"],
            ["Radical raccourci", "<i>hac-er → har-</i>", "<i>hacer, decir</i>"],
            ["Futurs", "<i>podré, querré, sabré, habré, cabré</i>", "<i>tendré, pondré, vendré, saldré, valdré, haré, diré</i>"]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Ce que dit le futur",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "L’avenir",
              "texte": "<i>Mañana **lloverá**.</i> · <i>ir a</i> + inf. pour l’intention et l’imminence, très courant à l’oral&nbsp;: <i>**Voy a estudiar**.</i>"
            },
            {
              "titre": "La probabilité",
              "texte": "Supposition sur le **présent**&nbsp;: <i>**Serán** las tres.</i> (Il doit être trois heures.)"
            },
            {
              "titre": "Futur antérieur et conditionnel",
              "texte": "<i>Ya **habré terminado**.</i> · Conditionnel : même radical + <i>-ía, -ías…</i> : <i>podría, tendría, haría, diría</i>."
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Futur après « cuando »&nbsp;?",
          "oui": {
            "titre": "Subjonctif présent",
            "texte": "<i>**Cuando llegues**, llámame.</i> · <i>En cuanto pueda, te aviso.</i> · <i>Mientras estés aquí…</i>"
          },
          "non": {
            "titre": "Jamais de futur",
            "texte": "<i>Cuando llegarás…</i> — calque de « quand tu arriveras » : faute lourde, vue dès la première ligne."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>Cuando (yo) ___ (tener) tiempo, te llamaré.</i> → **tenga**&nbsp;: subjonctif."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "Former le futur",
          "etapes": [
            {
              "titre": "Prends l’infinitif",
              "texte": "Entier&nbsp;: <i>hablar</i>, <i>comer</i>, <i>vivir</i>."
            },
            {
              "titre": "Irrégulier&nbsp;?",
              "texte": "Un des douze&nbsp;: change le radical (<i>podr-, tendr-, har-</i>)."
            },
            {
              "titre": "Ajoute <i>é, ás, á, emos, éis, án</i>",
              "texte": "Sur tous les verbes, **sans** changer les terminaisons."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "Les composés suivent la base",
          "deux": true,
          "items": [
            {
              "titre": "deshacer",
              "texte": "<i>desharé</i>"
            },
            {
              "titre": "mantener",
              "texte": "<i>mantendré</i>"
            },
            {
              "titre": "componer",
              "texte": "<i>compondré</i>"
            },
            {
              "titre": "Concession",
              "texte": "<i>**Será** muy inteligente, pero no lo parece.</i>"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>Cuando **llegarás**</i> → <i>Cuando **llegues**.</i>",
            "<i>Yo **poderé**</i> → <i>Yo **podré**</i> (le <i>e</i> tombe).",
            "<i>Yo **hacerá**</i> → <i>Yo **haré**</i> (radical <i>har-</i>).",
            "<i>Yo habl**are**</i> → <i>habl**aré**</i> : l’accent est obligatoire."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>Mañana (yo) ___ (hacer) los deberes.</i>",
            "<i>Mañana ellos ___ (venir).</i>",
            "<i>Cuando (tú) ___ (llegar), llámame.</i>"
          ],
          "reponses": "1) haré 2) vendrán 3) llegues"
        }
      ]
    }
  ]
