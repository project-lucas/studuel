  },
  "marcel": "To ou -ing&nbsp;?\nLe verbe décide&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "Après une préposition",
          "lignes": ["préposition + verbe-**ING**"],
          "petite": true,
          "regle": "Sans exception&nbsp;: <i>before leaving, instead of waiting, good at singing, interested in learning</i>.",
          "note": "to peut être une préposition !"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Les deux listes",
          "entetes": ["Suivis de -ING", "Suivis de l’infinitif"],
          "lignes": [
            ["<i>enjoy, avoid, finish</i>", "<i>want, decide, hope</i>"],
            ["<i>mind, suggest, practise</i>", "<i>promise, refuse, agree</i>"],
            ["<i>keep, give up, deny</i>", "<i>manage, offer, seem</i>"],
            ["<i>can’t stand</i>", "<i>afford, expect</i>"]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 3,
          "titre": "Stop + ? : deux sens opposés",
          "oui": {
            "titre": "Stop + -ING",
            "texte": "<i>He stopped **smoking**.</i> — il a arrêté de fumer."
          },
          "non": {
            "titre": "Stop + infinitif",
            "texte": "<i>He stopped **to smoke**.</i> — il s’est arrêté pour fumer."
          },
          "essai": {
            "titre": "Essai",
            "texte": "« Il a arrêté de parler » → <i>He stopped ___.</i> → **talking**."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "tableau",
          "numero": 4,
          "titre": "Les verbes aux deux constructions",
          "entetes": ["Verbe", "+ infinitif", "+ -ING"],
          "lignes": [
            ["**remember**", "penser à faire&nbsp;: <i>Remember to lock it.</i>", "se souvenir d’avoir fait&nbsp;: <i>I remember locking it.</i>"],
            ["**try**", "s’efforcer&nbsp;: <i>Try to open it.</i>", "essayer pour voir&nbsp;: <i>Try opening it.</i>"],
            ["**mean**", "avoir l’intention&nbsp;: <i>I meant to call.</i>", "impliquer&nbsp;: <i>It means waiting.</i>"],
            ["**forget**", "oublier de faire", "oublier d’avoir fait"]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {"titre": "Une préposition&nbsp;?", "texte": "Oui → **-ING**, même avec <i>look forward to</i>."},
            {"titre": "Quel verbe&nbsp;?", "texte": "Cherche-le dans les listes -ING ou infinitif."},
            {"titre": "Les deux&nbsp;?", "texte": "<i>remember, stop, try</i> : le **sens** décide."}
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "To préposition",
          "deux": true,
          "items": [
            {"titre": "look forward to", "texte": "<i>I look forward to **seeing** you.</i>"},
            {"titre": "be used to", "texte": "<i>She is used to **working** late.</i>"},
            {"titre": "object to", "texte": "<i>He objects to **paying**.</i>"},
            {"titre": "Le test", "texte": "Remplace par un nom&nbsp;: si ça marche, c’est une préposition."}
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>I look forward to see you</i> → <i>to **seeing** you.</i>",
            "<i>I enjoy to read</i> → <i>I enjoy **reading**.</i>",
            "<i>She decided leaving</i> → <i>She decided **to leave**.</i>",
            "<i>before to leave</i> → <i>before **leaving**.</i>"
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>I enjoy ___ (read).</i>",
            "<i>She decided ___ (leave).</i>",
            "<i>Instead of ___ (wait), he left.</i>"
          ],
          "reponses": "1) reading 2) to leave 3) waiting"
        }
      ]
    }
  ]
