{
  "titre": "Exprimer le but",
  "titreSurligne": "but",
  "accroche": "Pourquoi on agit&nbsp;: to, so that.",
  "bonus": "to + base · in order to · so that + proposition",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/4e/anglais/exprimer-le-but.webp",
    "prompt": "a glossy violet dart hitting a golden target bullseye with sparkles, same art style as the reference icons, magenta background"
  },
  "marcel": "Pour agir&nbsp;: to + base,\njamais for&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "Le but",
          "lignes": [
            "**to** + base"
          ],
          "petite": true,
          "regle": "**to** + base verbale quand le **sujet** est le même. Autre sujet → **so that** + proposition.",
          "note": "to buy, jamais for buying"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Les trois constructions",
          "entetes": [
            "La forme",
            "Registre",
            "Condition"
          ],
          "lignes": [
            [
              "**to** + base",
              "courant",
              "même sujet"
            ],
            [
              "**in order to / so as to**",
              "formel",
              "même sujet"
            ],
            [
              "**so that** + proposition",
              "toute",
              "autre sujet"
            ],
            [
              "**in order not to**",
              "négatif",
              "même sujet"
            ],
            [
              "**for** + nom",
              "aller chercher",
              "<i>for bread</i>"
            ],
            [
              "**for** + -ING",
              "usage d’un objet",
              "<i>for cutting</i>"
            ],
            [
              "**what … for?**",
              "demander le but",
              "<i>What did you do that for?</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Des exemples",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "to",
              "texte": "<i>I went to the shop **to buy** bread.</i>"
            },
            {
              "titre": "in order to",
              "texte": "<i>He left early **in order to** catch the train.</i>"
            },
            {
              "titre": "so that",
              "texte": "<i>I’ll speak slowly **so that** you can understand.</i>"
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "For ou to&nbsp;?",
          "oui": {
            "titre": "to + base",
            "texte": "<i>I went to the shop **to buy** bread.</i>"
          },
          "non": {
            "titre": "for + verbe",
            "texte": "<i>I went to the shop for buying bread.</i> — c’est faux."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>This knife is ___ cutting bread.</i> → **for** (à quoi sert l’objet)."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "Exprimer le but",
          "etapes": [
            {
              "titre": "Même sujet&nbsp;?",
              "texte": "Oui → **to / in order to** + base."
            },
            {
              "titre": "Autre sujet&nbsp;?",
              "texte": "Oui → **so that** + proposition."
            },
            {
              "titre": "Négatif&nbsp;?",
              "texte": "**so as not to** + base."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "For : deux emplois",
          "deux": true,
          "items": [
            {
              "titre": "for + nom",
              "texte": "aller chercher&nbsp;: <i>for bread</i>"
            },
            {
              "titre": "for + -ING",
              "texte": "à quoi sert un objet&nbsp;: <i>for cutting</i>"
            },
            {
              "titre": "Après so that",
              "texte": "souvent **can / could / will**"
            },
            {
              "titre": "Question",
              "texte": "<i>What… for? Why?</i> → réponse <i>To…</i>"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>I went there for buying bread</i> → <i>to buy.</i>",
            "<i>I work to my son study</i> → <i>so that my son can study.</i>",
            "<i>so that I can to go</i> → <i>can go</i> (base).",
            "Même sujet → pas besoin de **so that**."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>I went to the shop ___ buy bread. (to / for)</i>",
            "<i>She saved money ___ her son could study.</i>",
            "<i>This knife is ___ cutting bread. (for / to)</i>"
          ],
          "reponses": "1) to 2) so that 3) for"
        }
      ]
    }
  ]
}
