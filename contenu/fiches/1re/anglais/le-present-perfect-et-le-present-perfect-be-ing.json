{
  "titre": "Present perfect + ING",
  "titreSurligne": "Present perfect",
  "accroche": "Le bilan, maintenant — pas le récit.",
  "bonus": "**have / has** + participe passé · **have / has been** + -ING · **for** + durée · **since** + départ",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/1re/anglais/le-present-perfect-et-le-present-perfect-be-ing.webp",
    "prompt": "a glossy violet hourglass with golden sand and a small golden clock on top, a glowing golden arrow pointing to the present, sparkles, same art style as the reference icons, magenta background"
  },
  "marcel": "Un bilan&nbsp;?\nPresent perfect&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "La forme",
          "lignes": ["**have / has** + participe passé"],
          "petite": true,
          "regle": "Il fait le **bilan maintenant** : le **résultat** compte, pas la date. Un repère daté (<i>yesterday, in 2019</i>) est **impossible**.",
          "note": "pas de date !"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Prétérit ou present perfect&nbsp;?",
          "entetes": ["", "Prétérit", "Present perfect"],
          "lignes": [
            ["Il fait", "Il **raconte** un fait passé", "Il fait le **bilan**"],
            ["Ce qui compte", "L’événement, daté", "Le **résultat** actuel"],
            ["Exemple", "<i>I lost my keys yesterday.</i>", "<i>I **have lost** my keys.</i> (je ne les ai plus)"]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Les marqueurs et since / for",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "ever · never · already",
              "texte": "<i>Have you **ever** been to London?</i> · <i>I have **never** seen it.</i> · <i>She has **already** left.</i>"
            },
            {
              "titre": "yet · just · so far",
              "texte": "<i>I haven’t finished **yet**.</i> · <i>He has **just** arrived.</i> · <i>Three tests **so far**.</i>"
            },
            {
              "titre": "since / for",
              "texte": "**since** + point de départ&nbsp;: <i>since 2019</i> · **for** + durée&nbsp;: <i>for six years</i>. Ça **dure encore**."
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Depuis quand&nbsp;?",
          "oui": {
            "titre": "Present perfect",
            "texte": "<i>I **have lived** here **since** 2019.</i> — je vis ici depuis 2019."
          },
          "non": {
            "titre": "Présent",
            "texte": "<i>I **live** here since 2019.</i> — la faute la plus répandue au bac."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>She ___ (work) here for ten years.</i> → **has worked**."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "Simple ou BE + -ING&nbsp;?",
          "etapes": [
            {
              "titre": "Un résultat&nbsp;?",
              "texte": "Action achevée → **simple**&nbsp;: <i>I’ve written three letters.</i>"
            },
            {
              "titre": "Une durée&nbsp;?",
              "texte": "Action qui dure ou laisse des traces → **have been -ing**&nbsp;: <i>I’ve been waiting for two hours.</i>"
            },
            {
              "titre": "Des traces&nbsp;?",
              "texte": "<i>You’ve been crying.</i> (j’en vois les traces) ≠ <i>He has cried.</i>"
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "À retenir",
          "deux": true,
          "items": [
            {
              "titre": "3<sup>e</sup> colonne",
              "texte": "participe passé irrégulier&nbsp;: <i>go → gone, see → seen</i>."
            },
            {
              "titre": "has",
              "texte": "avec <i>he, she, it</i>&nbsp;: <i>She **has** gone.</i>"
            },
            {
              "titre": "yet",
              "texte": "en fin de phrase, questions et négations."
            },
            {
              "titre": "already, just, ever, never",
              "texte": "entre l’auxiliaire et le participe."
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>I have seen him yesterday</i> → <i>I **saw** him yesterday.</i> (date = prétérit)",
            "<i>I live here since 2019</i> → <i>I **have lived** here since 2019.</i>",
            "<i>for 2019</i> → <i>**since** 2019</i> ; <i>since six years</i> → <i>**for** six years</i>.",
            "<i>Have you ever been?</i> : pas de <i>did</i> ni de date."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>I ___ (live) here since 2019.</i>",
            "<i>They ___ (meet) three days ago.</i> (prétérit ou perfect&nbsp;?)",
            "<i>I’m tired: I ___ (run) for an hour.</i>"
          ],
          "reponses": "1) have lived 2) met (ago = prétérit) 3) have been running"
        }
      ]
    }
  ]
}
