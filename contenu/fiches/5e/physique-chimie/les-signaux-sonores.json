            },
            {
              "titre": "Mesurer",
              "texte": "sa durée **T**, en secondes"
            },
            {
              "titre": "Calculer",
              "texte": "**f = 1 ÷ T**, puis écrire l’unité (Hz)"
            }
          ]
        }
      ]
    },
    {
      "colonnes": "262px 1fr",
      "blocs": [
        {
          "type": "postit",
