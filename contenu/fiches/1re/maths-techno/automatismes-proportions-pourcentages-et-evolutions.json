        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 3,
          "titre": "La méthode en trois temps",
          "etapes": [
            { "titre": "Traduire", "texte": "chaque pourcentage d’évolution en coefficient multiplicateur" },
            { "titre": "Multiplier", "texte": "valeur × CM, ou CM₁ × CM₂ pour deux évolutions" },
            { "titre": "Reconvertir", "texte": "CM − 1 donne le taux global, en pourcentage" }
          ]
        }
      ]
    },
    {
      "colonnes": "262px 1fr",
      "blocs": [
        {
          "type": "postit",
          "titre": "Exemple résolu",
          "donnees": "80 € : __+ 20 % puis − 20 %__. Prix final&nbsp;?",
