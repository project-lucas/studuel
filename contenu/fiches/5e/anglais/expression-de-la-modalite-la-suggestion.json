          "petite": true,
          "regle": "Let’s = « allons-y, faisons… ». Après **Let’s**, le verbe reste tout simple&nbsp;: <i>Let’s go.</i>",
          "note": "Let’s not = ne… pas"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Les formules",
          "entetes": [
            "Je propose",
            "Ce qui suit",
            "L’exemple"
          ],
          "lignes": [
            [
              "**Let’s**",
              "le verbe",
              "<i>Let’s play tennis.</i>"
            ],
            [
              "**Shall we**",
              "le verbe",
              "<i>Shall we start?</i>"
            ],
            [
              "**Why don’t we**",
              "le verbe",
              "<i>Why don’t we meet at six?</i>"
            ],
            [
              "**How about / What about**",
              "un nom ou -ING",
              "<i>What about going out?</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Répondre à une idée",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "Accepter",
              "texte": "<i>Good idea!</i> / <i>That sounds great.</i> / <i>Why not!</i> (pourquoi pas&nbsp;!)"
            },
            {
              "titre": "Refuser poliment",
              "texte": "<i>I’m afraid I can’t.</i> (je ne peux pas) / <i>Sorry, I’m busy.</i> (je suis occupé)"
            },
            {
              "titre": "Préférer autre chose",
              "texte": "<i>I’d rather stay home.</i> (je préfère rester) — **would rather** + verbe"
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Verbe ou -ING&nbsp;?",
          "oui": {
            "titre": "Avec -ING",
            "texte": "<i>How about **going** to the cinema?</i> — après **How about**, le verbe prend -ING."
          },
          "non": {
            "titre": "Avec le verbe simple",
            "texte": "<i>Why don’t we **go**?</i> / <i>Let’s **go**!</i> — pas de -ING, pas de to."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>Let’s ___ (play) football.</i> → **play**&nbsp;: Let’s + verbe simple."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Quelle formule&nbsp;?",
              "texte": "Let’s, Shall we, Why don’t we, How about."
            },
            {
              "titre": "Regarde ce qui suit",
              "texte": "Verbe simple, sauf après **How about** (-ING)."
            },
            {
              "titre": "Réponds",
              "texte": "Accepte avec <i>Good idea!</i> ou refuse poliment."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "À retenir",
          "deux": true,
          "items": [
            {
              "titre": "Let’s not",
              "texte": "pour proposer de NE PAS faire&nbsp;: <i>Let’s not waste time.</i>"
            },
            {
              "titre": "Shall I / Shall we",
              "texte": "je propose ou on propose&nbsp;: <i>Shall I help you?</i>"
            },
            {
              "titre": "Why not",
              "texte": "« pourquoi pas&nbsp;? »&nbsp;: <i>Why not try again?</i>"
            },
            {
              "titre": "would rather",
              "texte": "je préfère&nbsp;: <i>I’d rather stay home.</i>"
            },
            {
              "titre": "Accepter",
              "texte": "<i>Good idea!</i> = bonne idée&nbsp;!"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>How about go?</i> → <i>How about **going**?</i>",
            "<i>Why don’t we going?</i> → <i>Why don’t we **go**?</i>",
            "<i>Let’s to go</i> → <i>Let’s **go**.</i>",
            "<i>I’d rather to stay</i> → <i>I’d rather **stay**.</i>",
            "<i>Shall we go?</i> ≠ <i>Shall we to go?</i> : pas de to."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>How about ___ (swim) today?</i>",
            "<i>Why don’t we ___ (meet) at six?</i>",
            "Accepte une idée en anglais."
          ],
          "reponses": "1) swimming 2) meet 3) Good idea! / Why not!"
        }
      ]
    }
  ]
}
