            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Les tournures",
          "colonnes": 4,
          "cartes": [
            {
              "titre": "What + nom",
              "texte": "<i>What a beautiful day!</i> (Quelle belle journée&nbsp;!)"
            },
            {
              "titre": "How + adjectif",
              "texte": "<i>How strange!</i> · <i>How beautifully she sings!</i>"
            },
            {
              "titre": "so + adjectif",
              "texte": "Comme **how** : <i>It’s **so** cold!</i>"
            },
            {
              "titre": "such + nom",
              "texte": "Comme **what** : <i>It’s **such** a mess!</i>"
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Exclamation ou question&nbsp;?",
          "oui": {
            "titre": "Ordre normal",
            "texte": "<i>What a mess **this is**!</i> — sujet puis verbe."
          },
          "non": {
            "titre": "Ordre d’une question",
            "texte": "<i>What a mess **is this**!</i> — trahit une exclamation faite comme une question."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>___ strange!</i> → **How**&nbsp;: <i>strange</i> est un adjectif, donc <i>how</i> et non <i>what</i>, même si le français dit « quel »."
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Nom ou adjectif&nbsp;?",
              "texte": "Un **nom** → **what**. Un **adjectif / adverbe** → **how**."
            },
            {
              "titre": "L’article",
              "texte": "Après **what** : **a / an** seulement si le nom est singulier dénombrable."
            },
            {
              "titre": "L’ordre",
              "texte": "Sujet + verbe, comme dans une phrase ordinaire, jamais comme dans une question (ou le verbe est sous-entendu)."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "À retenir",
          "deux": true,
          "items": [
            {
              "titre": "Verbe sous-entendu",
              "texte": "<i>What a pity!</i> · <i>How kind of you to come!</i>"
            },
            {
              "titre": "Négation rhétorique",
              "texte": "<i>Isn’t it beautiful!</i> — une exclamation déguisée, avec le ton qui monte."
            },
            {
              "titre": "so / such",
              "texte": "Le partage recopie **how / what** : adjectif d’un côté, nom de l’autre. <i>It’s so cold!</i> mais <i>such a cold day</i>."
            },
            {
              "titre": "Pluriel",
              "texte": "<i>What lovely flowers!</i> — sans article."
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>What beautiful day!</i> → <i>What **a** beautiful day!</i>",
            "<i>What a lovely flowers!</i> → <i>What lovely flowers!</i>",
            "<i>How a beautiful day!</i> → **What** a beautiful day!",
            "<i>What a mess is this!</i> → <i>What a mess this **is**!</i>"
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>___ a beautiful day!</i>",
            "<i>___ strange!</i>",
            "<i>What a mess ___ ! (this / is)</i> Remets l’ordre."
          ],
          "reponses": "1) What 2) How 3) this is"
        }
      ]
    }
  ]
