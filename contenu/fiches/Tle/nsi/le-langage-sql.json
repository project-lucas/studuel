            { "titre": "Supprimer", "texte": "<i>DELETE FROM eleves WHERE id = 2;</i>" },
            { "titre": "Compter", "texte": "<i>SELECT COUNT(*) FROM eleves;</i> → **3**" }
          ]
        }
      ]
