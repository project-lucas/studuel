    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Fini&nbsp;?",
              "texte": "Un repère comme <i>yesterday</i> ou <i>ago</i> → prétérit."
            },
            {
              "titre": "Régulier&nbsp;?",
              "texte": "Ajoute **-ed** (ou -d, -ied)."
            },
            {
              "titre": "Question&nbsp;?",
              "texte": "**did** + sujet + base verbale."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "À retenir",
          "deux": true,
          "items": [
            {
              "titre": "go → went",
              "texte": "<i>I went home.</i>"
            },
            {
              "titre": "have → had, see → saw",
              "texte": "<i>We had lunch. I saw a film.</i>"
            },
            {
              "titre": "eat → ate, take → took",
              "texte": "<i>He ate pizza.</i>"
            },
            {
              "titre": "be → was / were",
              "texte": "<i>I was tired. They were happy.</i>"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>I didn’t went</i> → <i>I didn’t **go**.</i>",
            "<i>She studyed</i> → <i>She stud**ied**.</i>",
            "<i>He goed</i> → <i>He **went**.</i>",
            "<i>Did he liked it?</i> → <i>Did he **like** it?</i>"
          ]
        }
      ]
    },
    {
