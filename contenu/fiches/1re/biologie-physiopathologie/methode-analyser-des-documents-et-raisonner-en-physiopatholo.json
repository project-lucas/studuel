      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": "★",
          "titre": "Justifier un traitement",
          "colonnes": 3,
          "cartes": [
            { "titre": "Mécanisme", "texte": "Nommer le dysfonctionnement à corriger." },
            { "titre": "Action", "texte": "Dire ce que le traitement change." },
            { "titre": "Effet", "texte": "Relier au signe qui disparaît." }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 4,
