{
  "titre": "Exprimer l’habitude",
  "titreSurligne": "habitude",
  "accroche": "Used to, be used to&nbsp;: ne les mélange pas.",
  "bonus": "**used to** + base verbale · **be / get used to** + **-ING**",
  "illustration": {
    "fichier": "assets-sources/fiches/illustrations/3e/anglais/exprimer-l-habitude.webp",
    "prompt": "a glossy violet calendar page with a golden circular arrow looping around it, tiny golden sparkles, same art style as the reference icons, magenta background"
  },
  "marcel": "Avant&nbsp;: used to.\nAujourd’hui&nbsp;: -ING&nbsp;!",
  "rangs": [
    {
      "colonnes": "300px 1fr",
      "blocs": [
        {
          "type": "formule",
          "numero": 1,
          "titre": "L’habitude passée",
          "lignes": [
            "**used to** + base verbale"
          ],
          "petite": true,
          "regle": "Une habitude ou un état **révolu**&nbsp;: <i>I **used to** play football.</i> (avant, plus maintenant).",
          "note": "did + use to (sans -d)"
        },
        {
          "type": "tableau",
          "numero": 2,
          "titre": "Trois structures",
          "entetes": [
            "Le sens",
            "La structure",
            "La suite"
          ],
          "lignes": [
            [
              "Habitude passée",
              "<i>used to</i>",
              "**base verbale**"
            ],
            [
              "Être habitué à",
              "<i>be used to</i>",
              "**-ING** ou nom"
            ],
            [
              "S’habituer à",
              "<i>get used to</i>",
              "**-ING** ou nom"
            ],
            [
              "Habitude présente",
              "présent simple",
              "<i>always, usually, often…</i>"
            ]
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "cartes",
          "numero": 3,
          "titre": "Les formes à retenir",
          "colonnes": 3,
          "cartes": [
            {
              "titre": "Négation, question",
              "texte": "<i>I didn’t **use** to like it.</i> / <i>**Did** you **use** to live here?</i>"
            },
            {
              "titre": "Would",
              "texte": "Actions **répétées** seulement&nbsp;: <i>Every summer, we **would go** to the beach.</i>"
            },
            {
              "titre": "Un état",
              "texte": "Pour un état, seul <i>used to</i>&nbsp;: <i>I **used to** be shy.</i> — jamais <i>I would be shy</i>."
            }
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "verdicts",
          "numero": 4,
          "titre": "Base verbale ou -ING&nbsp;?",
          "oui": {
            "titre": "Habitude passée",
            "texte": "<i>I used to **swim**.</i> — base verbale, c’est fini."
          },
          "non": {
            "titre": "Habitude acquise",
            "texte": "<i>I am used to **swimming**.</i> — to est une préposition : -ING."
          },
          "essai": {
            "titre": "Essai",
            "texte": "<i>I am used to ___ (get) up early.</i> → **getting**&nbsp;!"
          }
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "etapes",
          "numero": 5,
          "titre": "La méthode",
          "etapes": [
            {
              "titre": "Actuelle&nbsp;?",
              "texte": "Présent simple + adverbe de fréquence."
            },
            {
              "titre": "Finie&nbsp;?",
              "texte": "**used to** + base verbale (ou **would** pour une action répétée)."
            },
            {
              "titre": "Habitué&nbsp;?",
              "texte": "**be / get used to** + **-ING** ou nom."
            }
          ]
        }
      ]
    },
    {
      "colonnes": "1fr 1fr",
      "blocs": [
        {
          "type": "liste",
          "numero": 6,
          "titre": "Exemples traduits",
          "deux": true,
          "items": [
            {
              "titre": "Présent",
              "texte": "<i>I usually **have** breakfast at seven.</i> (d’habitude)"
            },
            {
              "titre": "Passé révolu",
              "texte": "<i>We **used to live** in Lyon.</i> (nous habitions)"
            },
            {
              "titre": "Être habitué",
              "texte": "<i>I’**m used to** the noise.</i> (j’ai l’habitude)"
            },
            {
              "titre": "S’habituer",
              "texte": "<i>You’ll soon **get used to** it.</i> (tu vas t’y habituer)"
            }
          ]
        },
        {
          "type": "pieges",
          "items": [
            "<i>I use to play</i> (au passé) → <i>I **used** to play</i>",
            "<i>I didn’t used to</i> → <i>I didn’t **use** to</i>",
            "<i>I am used to get up</i> → <i>I am used to **getting** up</i>",
            "<i>I would live in Lyon</i> → <i>I **used to** live in Lyon</i>"
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "texte",
          "numero": 7,
          "titre": "Le français dit « je jouais »",
          "paragraphes": [
            "Une habitude passée en français (l’imparfait) a trois traductions&nbsp;: <i>I **played** football on Wednesdays</i> (neutre), <i>I **used to play**</i> (c’est fini) ou <i>I **would play**</i> (souvenir, action répétée)."
          ]
        }
      ]
    },
    {
      "blocs": [
        {
          "type": "test",
          "questions": [
            "<i>We ___ to live in Lyon.</i> (use / used)",
            "<i>She is used to ___ early.</i> (get)",
            "<i>Did you ___ to play tennis?</i> (use / used)"
          ],
          "reponses": "1) used 2) getting 3) use"
        }
      ]
    }
  ]
}
